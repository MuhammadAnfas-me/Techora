<script>
    const userNumber = <%- JSON.stringify(user.number || "Not added") %>  ;
    const userEmail = <%- JSON.stringify(user.email) %> ;
    const userName = <%- JSON.stringify(user.fullName) %> ;
    const totalAmount = <%- finalAmount ? JSON.stringify(finalAmount) : JSON.stringify(grandTotal) %> ;

    document.querySelector('.payment').addEventListener('click',async function(e) {

    const paymentMethod = document.querySelector('input[name="payment_method"]:checked').value;
    // Basic interaction for the "Place Order" button
    const originalText = this.textContent
    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
    this.disabled = true;

    try {
        if(paymentMethod === "COD"){

        const addressId = new URLSearchParams(window.location.search).get("addressId")
        const paymentMethod = document.querySelector('input[name="payment_method"]:checked')?.value
        const res = await axios.post("/place-order",{
            addressId,
            paymentMethod
        })
        if(res.data.success){
            showToast(res.data.message)
            setTimeout(() => {
                window.location.href=`/checkout/payment/success?orderId=${res.data.orderId}`
            }, 1500);
        }

        }else if(paymentMethod === "WALLET"){
            const addressId = new URLSearchParams(window.location.search).get("addressId")
            const paymentMethod = document.querySelector('input[name="payment_method"]:checked')?.value
            const res = await axios.post("/place-order",{
                addressId,
                paymentMethod
            })

        if(res.data.success){
            showToast(res.data.message)
            setTimeout(() => {
                window.location.href=`/checkout/payment/success?orderId=${res.data.orderId}`
            }, 1500);
        }

        }else{
            payNow(totalAmount)
        }
    } catch (error) {
        console.log(error)
        this.textContent = originalText
        this.disabled = false
        showToast(error.response?.data?.message || "Failed to payment","error")
    }
});

async function payNow(amt){
    try {
        const addressId = new URLSearchParams(window.location.search).get("addressId")
        const paymentMethod = document.querySelector('input[name="payment_method"]:checked')?.value
        


        const res = await axios.post("/create-order")

        const options= {
            key : res.data.key,
            amount: res.data.order.amount,
            currency: "INR",
            name: "Techora",
            description: "Test Transaction",
            order_id: res.data.order.id,

            handler: async function (response) {
             const verifyRes = await axios.post('/verify-payment', {
              ...response   // ✅ send properly
            });
    
        if (verifyRes.data.success) {
          const placeRes = await axios.post("/place-order",{
            addressId,
            paymentMethod,
            paymentId : verifyRes.data.paymentId
        })
        if(placeRes.data.success){
            showLoader()
            setTimeout(()=>{
                window.location.href=`/checkout/payment/success?orderId=${placeRes.data.orderId}`
            },300)
        }else{
            showToast(placeRes.data.message||"Failed to place order","error")
        }
      
        } else {
          showToast("Payment Verification Failed", "error");
        //   setTimeout(()=>{
        //     window.location.href=verifyRes.data.redirect
        //   },1000)
        }
        },

        prefill: {
          name: userName,
          email: userEmail,
          contact: userNumber
        },

        theme: {
          color: "#3399cc"
        }
        }
        const rzp = new Razorpay(options);
        rzp.open();
        rzp.on('payment.failed', function (response) {
        //   showToast(response.error.descrition || "Payment Failed", "error");
        sessionStorage.setItem("paymentError",response.error.description)
        console.log(response.error.description)
          window.location.href=`/checkout/payment/failed?addressId=${addressId}?message=${response.error.description}`
        });
        
        options.modal = {
          ondismiss: function () {
            showToast("Payment Cancelled", "error");
            location.reload()
          }
        };
    } catch (error) {
        console.log(error)
    }
}
</script>