
    <link rel="stylesheet" href="/styles/user/paymentPage.css">
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <%- include("../partitials/user/header.ejs",{tittle : "Techora | Payment"}) %>
    <div class="stepper-bg">
    <div class="stepper-container">
        <div class="step">
            <div class="step-num step-done">1</div>
            <span class="step-label text-gray-600">CART</span>
        </div>
        <div class="line"></div>
        <div class="step">
            <div class="step-num step-done">2</div>
            <span class="step-label text-gray-600">ADDRESS</span>
        </div>
        <div class="line"></div>
        <div class="step">
            <div class="step-num step-active">3</div>
            <span class="step-label text-tech-dark">PAYMENT</span>
        </div>
        <div class="line"></div>
        <div class="step">
            <div class="step-num step-inactive">4</div>
            <span class="step-label text-gray-400">CONFIRM</span>
        </div>
    </div>
</div>

<main class="payment-main">
    <section>
        <h2 class="section-title">Select Payment Method</h2>
        
        <label class="payment-card">
            <div class="payment-info">
                <h3>Razorpay</h3>
                <p>All major payment methods supported</p>
            </div>
            <input type="radio" name="payment_method" value="ONLINE" checked class="radio-input" >
        </label>

        <label class="payment-card">
            <div class="payment-info">
                <h3>Wallet</h3>
                <p>Pay using your wallet.</p>
            </div>
            <input type="radio" value="WALLET" name="payment_method"  class="radio-input">
        </label>
        
        <label class="payment-card">
            <div class="payment-info">
                <h3>Cash on Delivery</h3>
                <p>Pay when you receive your order.</p>
            </div>
            <input type="radio" value="COD" name="payment_method"  class="radio-input">
        </label>
    </section>

    <aside>
        <div class="summary-box">
            <h2 class="summary-title">Order Summary</h2>
            <% cartItems.forEach(item => { %>
            <div class="item-row" style="flex-direction: column;">
                <div style="display: flex; gap: 1rem;">
                    <div class="item-img">
                        <img src="<%= item.image %>" alt="iPhone" style="opacity: 1;">
                    </div>
                    <div class="item-details">
                        <p class="item-name"><%= item.name %></p>
                        <p class="item-price"><%=formatINR(item.subtotal) %></p>
                    </div>
                </div>
                <% if (!item.isValid) { %>
                    <div class="<%= item.message.includes('left') ? 'stock-warning' : 'item-unavailable-alert' %>">
                      <i class="fas <%= item.message === 'Out of stock' ? 'fa-box-open' : (item.message === 'Product unavailable' ? 'fa-ban' : (item.message.includes('left') ? 'fa-hourglass-half' : 'fa-exclamation-circle')) %>"></i>
                      <span><%= item.message %></span>
                    </div>
                <% } %>
            </div>
            <% }) %>

            <div class="price-calc">
                <div class="calc-row"><span>Subtotal</span><span class="font-semibold"><%= formatINR(grandTotal) %></span></div>
                <div class="calc-row text-success"><span>Discount</span><span class="font-semibold"><%= discount ? formatINR(discount) : "-₹0.00" %></span></div>
            </div>

            <div class="total-row">
                <span class="total-label">Total Amount</span>
                <span class="total-amount"><%= finalAmount ? formatINR(finalAmount) : formatINR(grandTotal) %></span>
            </div>

            <button class="pay-btn payment" <%= cartItems.some(i => !i.isValid) ? 'disabled' : '' %> >Place Order</button>
            
            <p class="secure-badge">
                <span class="success-icon">✔</span> 100% Secure Payments
            </p>
        </div>
    </aside>
</main>

<%- include("../partitials/user/footer.ejs") %>

    <!-- <footer class="main-footer">
        </footer>

    <script src="script.js"></script>
</body>
</html> -->

<script>
    const userNumber = <%- JSON.stringify(user.number || "Not added") %>  ;
    const userEmail = <%- JSON.stringify(user.email) %> ;
    const userName = <%- JSON.stringify(user.fullName) %> ;
    const totalAmount = <%- finalAmount ? JSON.stringify(finalAmount) : JSON.stringify(grandTotal) %> ;

    document.querySelector('.payment').addEventListener('click',async function(e) {
    // Basic interaction for the "Place Order" button
    const originalText = this.textContent
    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
    this.disabled = true;

    try {
        // ✅ Step 1: Validate Cart first
        try {
            await axios.post('/checkout');
        } catch (error) {
            const data = error.response?.data;
            if (data?.errors) {
                showToast('Your cart has some issues. Redirecting to cart...', 'error');
                setTimeout(() => {
                    window.location.href = '/cart';
                }, 1500);
            } else {
                showToast(data?.message || 'Cart validation failed.', 'error');
                this.textContent = originalText;
                this.disabled = false;
            }
            return;
        }

        // ✅ Step 2: Proceed with Payment
        const paymentMethod = document.querySelector('input[name="payment_method"]:checked').value;
        if(paymentMethod === "COD"){

        const addressId = new URLSearchParams(window.location.search).get("addressId")
        const paymentMethod = document.querySelector('input[name="payment_method"]:checked')?.value
        const res = await axios.post("/place-order",{
            addressId,
            paymentMethod
        })
        if(res.data.success){
            showToast(res.data.message)
            setTimeout(() => {
                window.location.href=`/checkout/payment/success?orderId=${res.data.orderId}`
            }, 1500);
        }

        }else if(paymentMethod === "WALLET"){
            const addressId = new URLSearchParams(window.location.search).get("addressId")
            const paymentMethod = document.querySelector('input[name="payment_method"]:checked')?.value
            const res = await axios.post("/place-order",{
                addressId,
                paymentMethod
            })

        if(res.data.success){
            showToast(res.data.message)
            setTimeout(() => {
                window.location.href=`/checkout/payment/success?orderId=${res.data.orderId}`
            }, 1500);
        }

        }else{
            payNow(totalAmount)
        }
    } catch (error) {
        console.log(error)
        this.textContent = originalText
        this.disabled = false
        showToast(error.response?.data?.message || "Failed to payment","error")
    }
});

async function payNow(amt){
    try {
        const addressId = new URLSearchParams(window.location.search).get("addressId")
        const paymentMethod = document.querySelector('input[name="payment_method"]:checked')?.value
        


        const res = await axios.post("/create-order")

        const options= {
            key : res.data.key,
            amount: res.data.order.amount,
            currency: "INR",
            name: "Techora",
            description: "Test Transaction",
            order_id: res.data.order.id,

            handler: async function (response) {
                try {
                    const verifyRes = await axios.post('/verify-payment', {
                        ...response
                    });

                    if (verifyRes.data.success) {
                        try {
                            const placeRes = await axios.post("/place-order", {
                                addressId,
                                paymentMethod,
                                paymentId: verifyRes.data.paymentId
                            });

                            if (placeRes.data.success) {
                                showLoader();
                                setTimeout(() => {
                                    window.location.href = `/checkout/payment/success?orderId=${placeRes.data.orderId}`;
                                }, 300);
                            } else {
                                showToast(placeRes.data.message || "Failed to place order", "error");
                                setTimeout(() => location.reload(), 1500);
                            }
                        } catch (orderError) {
                            console.error('Order placement error:', orderError);
                            showToast(orderError.response?.data?.message || "Failed to place order. If amount was deducted, it will be refunded.", "error");
                            setTimeout(() => location.reload(), 2500);
                        }
                    } else {
                        showToast(verifyRes.data.message || 'Payment verification failed', 'error');
                        setTimeout(() => location.reload(), 1500);
                    }
                } catch (verifyError) {
                    console.error('Verification error:', verifyError);
                    showToast(verifyError.response?.data?.message || 'Something went wrong during payment verification', 'error');
                    setTimeout(() => location.reload(), 1500);
                }
            },

        prefill: {
          name: userName,
          email: userEmail,
          contact: userNumber
        },

        theme: {
          color: "#3399cc"
        }
        }
        const rzp = new Razorpay(options);
        rzp.open();
        rzp.on('payment.failed', function (response) {
        //   showToast(response.error.descrition || "Payment Failed", "error");
        sessionStorage.setItem("paymentError",response.error.description)
        console.log(response.error.description)
          window.location.href=`/checkout/payment/failed?addressId=${addressId}&message=${response.error.description}`
        });
        
        options.modal = {
          ondismiss: function () {
            showToast("Payment Cancelled", "error");
            location.reload()
          }
        };
    } catch (error) {
        console.log(error)
    }
}
</script>