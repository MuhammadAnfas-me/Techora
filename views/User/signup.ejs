<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Techora Registration</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <link rel="stylesheet" href="/styles/user/signup.css" />
    <link rel="stylesheet" href="/styles/user/popup.css" />
    <script defer src="/js/popup.js"></script>
  </head>
  <body>
<div class="toast toast-banner" id="toast" style="top: 20px; right: 20px;">
    <div class="tb-icon" id="toastIcon"></div>
    <div class="tb-text">
        <div class="tb-title" id="toastTitle"></div>
        <div class="tb-sub"   id="toastSub"></div>
    </div>
    <div class="tb-close" onclick="removeToast()">&#10005;</div>
</div>

<div id="loaderOverlay" class="loader-overlay">
  <div class="spinner"></div>
</div>


    <div class="card">
      <h2>Create Account</h2>
      <% if(error){ %>
      <small style="color: red"><%= error %></small>
      <% } %>
      <form id="regForm" action="/signup" method="post" novalidate>
        <input type="hidden" name="code" value="<%= code || '' %>">
        <div class="form-group">
          <label>Full Name</label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder="Full name"
            required
          />
          <small id="nameError" style="color: red"></small>
        </div>

        <div class="form-group">
          <label>Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="you@example.com"
            required
          />
          <small id="emailError" style="color: red"></small>
        </div>

        <div class="form-group">
          <label>Password</label>
          <div class="password-container">
            <input
              type="password"
              id="password"
              name="password"
              class="password-input"
              placeholder="Password"
              required
            />
            <i class="far fa-eye eye-icon"></i>
          </div>
          <small id="passwordError" style="color: red"></small>
        </div>

        <div class="form-group">
          <label>Confirm Password</label>
          <div class="password-container">
            <input
              type="password"
              id="confirmPassword"
              class="password-input"
              placeholder="Confirm"
              required
            />
            <i class="far fa-eye eye-icon"></i>
          </div>
          <small id="confirmPasswordError" style="color: red"></small>
        </div>

        <div class="referral-row">
          <input
            type="text"
            id="codee"
            placeholder="Referral code"
          />
          <input type="hidden" name="codee" id="actualReferralCode" />
          <button type="button" class="apply-btn" onclick="applyCode(this)">Apply</button>
        </div>
        <small id="codeError" style="color: red"></small>

        <button type="submit" class="submit-btn">Create Account</button>

        <div class="info-alert">
          <i class="fas fa-info-circle"></i>
          <span
            >You will receive an OTP on your email id to verify your
            account.</span
          >
        </div>

        <div class="login-footer">
          Already have an account? <a href="/login">Login</a>
        </div>

        <div class="divider">
          <span>or</span>
        </div>
        <button type="button" onclick="googleAuth()" class="google-btn">
          <svg width="18" height="18" viewBox="0 0 24 24">
            <path
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              fill="#4285F4"
            />
            <path
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              fill="#34A853"
            />
            <path
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
              fill="#FBBC05"
            />
            <path
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
              fill="#EA4335"
            />
          </svg>
          Sign in with Google
        </button>
      </form>
    </div>

    <script>
      //Form Validation

function showLoader() {
  document.getElementById("loaderOverlay").style.display = "flex";
}

function hideLoader() {
  document.getElementById("loaderOverlay").style.display = "none";
}




      document.addEventListener('DOMContentLoaded', function () {
        document
          .getElementById('regForm')
          .addEventListener('submit', formValidation)
      })

      window.addEventListener('load', function() {
        hideLoader();
      });

      window.addEventListener('pageshow', function(e) {
        if (e.persisted) {
            hideLoader();
        }
      });
      function formValidation(e) {
        e.preventDefault()

        const name = document.getElementById('name').value.trim()
        const email = document.getElementById('email').value.trim()
        const password = document.getElementById('password').value.trim()
        const confirmPassword = document
          .getElementById('confirmPassword')
          .value.trim()

        const nameError = document.getElementById('nameError')
        const emailError = document.getElementById('emailError')
        const passwordError = document.getElementById('passwordError')
        const confirmPasswordError = document.getElementById(
          'confirmPasswordError'
        )

        nameError.textContent = ''
        emailError.textContent = ''
        passwordError.textContent = ''
        confirmPasswordError.textContent = ''

        let isValid = true

        //  Name validation
        if (name.length < 3) {
          nameError.textContent = '• Name must be at least 3 characters'
          isValid = false
        }

        //  Email validation
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
        if (!emailRegex.test(email)) {
          emailError.textContent = '• Enter a valid email address'
          isValid = false
        }

        // ---------------------- Password validation ---------------------------------
        if (password.length < 8) {
          passwordError.textContent = '• Password must be at least 8 characters'
          isValid = false
        } 
         if (!/[A-Z]/.test(password)) {
          passwordError.textContent =
            '• Password must contain at least one uppercase letter'
          isValid = false
        } 
         if (!/[!@#$%^&*]/.test(password)) {
          passwordError.textContent =
            '• Password must contain at least one special character'
          isValid = false
        } 
         if (password !== confirmPassword) {
          confirmPasswordError.textContent = 'Passwords do not match'
          isValid = false
        }

        if (isValid) {
          sessionStorage.removeItem("expiryTime")
          const expiryTime = Date.now() + 60 * 1000
          sessionStorage.setItem('expiryTime', expiryTime)
          setTimeout(()=>{
            e.target.submit()
          },800)
        }
      }
      // Eye-toggle Logic
      const eyeIcons = document.querySelectorAll('.eye-icon')
      eyeIcons.forEach(icon => {
        icon.addEventListener('mouseover', function () {
          const input = this.previousElementSibling
          const isPassword = input.getAttribute('type') === 'password'
          input.setAttribute('type', isPassword ? 'text' : 'password')
          this.classList.toggle('fa-eye')
          this.classList.toggle('fa-eye-slash')
        })
      })
      eyeIcons.forEach(icon => {
        icon.addEventListener('mouseleave', function () {
          const input = this.previousElementSibling
          const isPassword = input.getAttribute('type') === 'password'
          input.setAttribute('type', isPassword ? 'text' : 'password')
          this.classList.toggle('fa-eye')
          this.classList.toggle('fa-eye-slash')
        })
      })

      function googleAuth(){
        const code = document.getElementById("codee").value;
        showLoader()
        window.location.href = "/auth/google?code="+encodeURIComponent(code) 
      }

      async function applyCode(btn) {
        const codeInput = document.getElementById("codee");
        const actualCodeInput = document.getElementById("actualReferralCode");
        const msg = document.getElementById("codeError");
        
        const codeValue = codeInput.value.trim();
        if(!codeValue) return;

        setButtonLoading(btn,true)
        msg.textContent = "";

        try {
          const res = await axios.post("/check-referral", { code: codeValue });
          const data = res.data;
        
          setTimeout(() => {
            if (data.valid) {
              msg.textContent = "✅ Referral code applied! You'll get ₹50";
              msg.style.color = "green";
              actualCodeInput.value = codeValue;
              codeInput.readOnly = true;
            } else {
              msg.textContent = "❌ Invalid referral code";
              msg.style.color = "red";
              actualCodeInput.value = "";
            }
            setButtonLoading(btn,false)
          }, 800)
        } catch (err) {
          msg.textContent = "❌ Error checking code";
          msg.style.color = "red";
          setButtonLoading(btn,false)
        }
      }

      document.getElementById("codee").addEventListener("input", () => {
        document.getElementById("codeError").textContent = "";
      })

      document.addEventListener("DOMContentLoaded", () => {
        const params = new URLSearchParams(window.location.search);
        const refCode = params.get("code");

        if (refCode) {
          const input = document.getElementById("codee");
          const actualInput = document.getElementById("actualReferralCode");

          if (input) {
            input.value = refCode;
            actualInput.value = refCode;
            input.readOnly = true;
            // Optionally auto-apply
            const applyBtn = document.querySelector('.apply-btn');
            if(applyBtn) applyCode(applyBtn);
          }
        }
      });
    </script>
  </body>
</html>
