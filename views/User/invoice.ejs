<!DOCTYPE html>
<html>
<head>
  <title>Invoice – Techora</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      background: #f4f6f9;
      color: #1a1a2e;
      padding: 40px 20px;
    }

    .page-actions {
      max-width: 820px;
      margin: 0 auto 20px;
      display: flex;
      justify-content: flex-end;
    }

    .print-btn {
      padding: 10px 22px;
      background: #1a1a2e;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: background 0.2s;
    }
    .print-btn:hover { background: #2d2d50; }

    .container {
      max-width: 820px;
      margin: auto;
      background: #fff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    }

    /* ── Header ── */
    .header {
      background: #1a1a2e;
      color: #fff;
      padding: 28px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo {
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }
    .logo span { color: #7c75f0; }
    .invoice-label {
      text-align: right;
    }
    .invoice-label h1 {
      font-size: 28px;
      font-weight: 700;
      letter-spacing: 2px;
      color: #fff;
    }
    .invoice-label p {
      font-size: 12px;
      color: #9898b8;
      margin-top: 4px;
    }

    /* ── Body ── */
    .body { padding: 32px 36px; }

    /* ── Order Meta Grid ── */
    .meta-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      border: 1px solid #eef0f5;
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 28px;
    }
    .meta-cell {
      padding: 14px 20px;
      border-right: 1px solid #eef0f5;
      border-bottom: 1px solid #eef0f5;
    }
    .meta-cell:nth-child(even) { border-right: none; }
    .meta-cell:nth-last-child(-n+2) { border-bottom: none; }
    .meta-label {
      font-size: 11px;
      color: #8a8fa8;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      margin-bottom: 5px;
    }
    .meta-value {
      font-size: 14px;
      font-weight: 500;
      color: #1a1a2e;
    }

    /* ── Badges ── */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }
    .badge::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }
    .paid { background: #dcfce7; color: #166534; }
    .paid::before { background: #16a34a; }
    .pending { background: #fef9c3; color: #854d0e; }
    .pending::before { background: #ca8a04; }
    .cancelled { background: #fee2e2; color: #991b1b; }
    .cancelled::before { background: #dc2626; }

    /* ── Two-column layout ── */
    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 28px;
    }

    /* ── Section cards ── */
    .card {
      background: #f9fafc;
      border: 1px solid #eef0f5;
      border-radius: 12px;
      padding: 20px;
    }
    .card-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #7c75f0;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .card-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: #e8eaf2;
    }
    .address-line {
      font-size: 14px;
      color: #3a3a5c;
      line-height: 1.8;
    }
    .address-line strong {
      display: block;
      font-weight: 600;
      color: #1a1a2e;
      margin-bottom: 2px;
    }

    /* ── Items table ── */
    .table-wrap {
      border: 1px solid #eef0f5;
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 28px;
    }
    .table-heading {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #7c75f0;
      padding: 14px 20px;
      border-bottom: 1px solid #eef0f5;
      background: #f9fafc;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    thead tr {
      background: #f4f6f9;
    }
    thead th {
      padding: 12px 20px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: #8a8fa8;
      text-align: left;
    }
    thead th:last-child { text-align: right; }
    tbody td {
      padding: 14px 20px;
      font-size: 13.5px;
      color: #3a3a5c;
      border-bottom: 1px solid #f0f2f8;
    }
    tbody tr:last-child td { border-bottom: none; }
    tbody td:last-child { text-align: right; font-weight: 600; color: #1a1a2e; }
    .product-name { font-weight: 600; color: #1a1a2e; }
    .product-brand { font-size: 12px; color: #8a8fa8; margin-top: 2px; }

    /* ── Totals ── */
    .totals-wrap {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 32px;
    }
    .totals-box {
      width: 280px;
      background: #f9fafc;
      border: 1px solid #eef0f5;
      border-radius: 12px;
      overflow: hidden;
    }
    .totals-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 11px 18px;
      font-size: 13.5px;
      color: #3a3a5c;
      border-bottom: 1px solid #eef0f5;
    }
    .totals-row:last-child { border-bottom: none; }
    .totals-row.discount { color: #16a34a; }
    .totals-row.grand {
      background: #1a1a2e;
      color: #fff;
      font-size: 15px;
      font-weight: 700;
    }
    .totals-row.saved {
      background: #dcfce7;
      color: #166534;
      font-size: 12px;
      font-weight: 600;
      justify-content: center;
      gap: 6px;
    }

    /* ── Footer ── */
    .footer {
      background: #f4f6f9;
      border-top: 1px solid #eef0f5;
      padding: 20px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .footer-left { font-size: 13px; color: #8a8fa8; }
    .footer-right { font-size: 13px; color: #8a8fa8; font-style: italic; }
    .footer-logo { font-size: 16px; font-weight: 700; color: #1a1a2e; }
    .footer-logo span { color: #7c75f0; }

    @media print {
      body { background: #fff; padding: 0; }
      .page-actions { display: none; }
      .container { box-shadow: none; border-radius: 0; }
    }
  </style>
</head>
<body>

<div class="page-actions">
  <button class="print-btn" onclick="window.print()">
    &#x2913; Download / Print
  </button>
</div>

<div class="container">

  <!-- Header -->
  <div class="header">
    <div class="logo">Tech<span>ora</span></div>
    <div class="invoice-label">
      <h1>INVOICE</h1>
      <p>System-generated document</p>
    </div>
  </div>

  <div class="body">

    <!-- Order Meta -->
    <div class="meta-grid">
      <div class="meta-cell">
        <div class="meta-label">Order ID</div>
        <div class="meta-value"><%= order.orderId %></div>
      </div>
      <div class="meta-cell">
        <div class="meta-label">Order Date</div>
        <div class="meta-value"><%= new Date(order.createdAt).toLocaleString("en-IN") %></div>
      </div>
      <div class="meta-cell">
        <div class="meta-label">Order Status</div>
        <div class="meta-value">
          <span class="badge <%= order.orderStatus === 'Delivered' ? 'paid' : order.orderStatus === 'Cancelled' ? 'cancelled' : 'pending' %>">
            <%= order.orderStatus %>
          </span>
        </div>
      </div>
      <div class="meta-cell">
        <div class="meta-label">Payment Status</div>
        <div class="meta-value">
          <span class="badge <%= order.paymentStatus === 'Paid' ? 'paid' : 'pending' %>">
            <%= order.paymentStatus %>
          </span>
        </div>
      </div>
      <div class="meta-cell">
        <div class="meta-label">Payment Method</div>
        <div class="meta-value"><%= order.paymentMethod %></div>
      </div>
      <% if (order.coupon !== null && order.coupon.couponCode) { %>
      <div class="meta-cell">
        <div class="meta-label">Coupon Applied</div>
        <div class="meta-value"><%= order.coupon.couponCode %></div>
      </div>
      <% } %>
    </div>

    <!-- Billing Address -->
    <div class="two-col">
      <div class="card">
        <div class="card-title">Billing Address</div>
        <div class="address-line">
          <strong><%= order.address.name %></strong>
          <%= order.address.addressLine1 %><br>
          <%= order.address.addressLine2 %><br>
          <%= order.address.city %>, <%= order.address.state %> – <%= order.address.zipCode %><br>
          <span style="margin-top:6px; display:inline-block;">&#128222; <%= order.address.phone %></span>
        </div>
      </div>
      <div class="card" style="display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; gap:6px;">
        <div style="font-size:36px;">&#128230;</div>
        <div style="font-size:13px; color:#8a8fa8;">Thank you for your order!</div>
        <div style="font-size:12px; color:#b0b3c6;">We appreciate your business.</div>
      </div>
    </div>

    <!-- Items Table -->
    <div class="table-wrap">
      <div class="table-heading">Order Items</div>
      <table>
        <thead>
          <tr>
            <th>Product</th>
            <th>Variant</th>
            <th>Status</th>
            <th>Qty</th>
            <th>Unit Price</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          <%
            const validStatuses = ["Placed", "Confirmed", "Shipped", "Delivered"]
          %>

          <% order.items.forEach(item => { %>
             <tr style="<%= !validStatuses.includes(item.status) ? 'opacity:0.5;' : '' %>"></tr>
          <tr>
            <td>
              <div class="product-name"><%= item.name %></div>
              <div class="product-brand"><%= item.brand %></div>
            </td>
            <td><%= item.color || '–' %></td>
            <td><%= item.status %></td>
            <td><%= item.quantity %></td>
            <td>&#8377;<%= item.price %></td>
                <td>
                  <% if (validStatuses.includes(item.status)) { %>
                    &#8377;<%= item.finalTotal %>
                  <% } else { %>
                    —
                  <% } %>
                </td>

          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Totals -->
   <div class="totals-wrap">
  <div class="totals-box">

    <div class="totals-row">
      <span>Subtotal</span>
      <span>&#8377;<%= order.subtotal %></span>
    </div>

    <% if (order.discount && order.discount > 0) { %>
    <div class="totals-row discount">
      <span>Discount</span>
      <span>–&#8377;<%= order.discount %></span>
    </div>
    <% } %>

    <div class="totals-row">
      <span>Shipping</span>
      <span style="color:#16a34a; font-weight:600;">FREE</span>
    </div>

    <% if (order.refundedTotal > 0) { %>
    <div class="totals-row" style="color:#dc2626;">
      <span>Refunded</span>
      <span>–&#8377;<%= order.refundedTotal %></span>
    </div>
    <% } %>

    <div class="totals-row grand">
      <span>Grand Total</span>
      <span>&#8377;<%= order.finalAmount %></span>
    </div>

    <% if (order.discount && order.discount > 0) { %>
    <div class="totals-row saved">
      &#10003; You saved &#8377;<%= order.discount %> on this order
    </div>
    <% } %>

  </div>
</div>

  </div><!-- /body -->

  <!-- Footer -->
  <div class="footer">
    <div>
      <div class="footer-logo">Tech<span>ora</span></div>
      <div class="footer-left" style="margin-top:4px;">Thank you for shopping with us &#10084;</div>
    </div>
    <div class="footer-right">This is a system-generated invoice</div>
  </div>

</div>

</body>
</html>