<!DOCTYPE html>
<html>
<head>
  <title>Invoice</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 30px;
      color: #111;
    }

    .container {
      max-width: 800px;
      margin: auto;
      border: 1px solid #eee;
      padding: 25px;
      border-radius: 10px;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid #eee;
      padding-bottom: 15px;
      margin-bottom: 20px;
    }

    .logo {
      font-size: 20px;
      font-weight: bold;
    }

    .invoice-title {
      font-size: 22px;
      font-weight: bold;
    }

    .section {
      margin-bottom: 20px;
    }

    .section h4 {
      margin-bottom: 8px;
      font-size: 14px;
      color: #555;
    }

    .info {
      font-size: 14px;
      line-height: 1.6;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }

    table th {
      background: #f3f4f6;
      text-align: left;
      padding: 10px;
      font-size: 13px;
    }

    table td {
      padding: 10px;
      border-bottom: 1px solid #eee;
      font-size: 13px;
    }

    .total-section {
      margin-top: 20px;
      text-align: right;
    }

    .total-section p {
      margin: 4px 0;
      font-size: 14px;
    }

    .grand-total {
      font-size: 16px;
      font-weight: bold;
    }

    .footer {
      margin-top: 30px;
      text-align: center;
      font-size: 12px;
      color: #777;
    }

    .badge {
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 12px;
      display: inline-block;
    }

    .paid {
      background: #dcfce7;
      color: #16a34a;
    }

    .pending {
      background: #fef3c7;
      color: #d97706;
    }

    @media print {
      button {
        display: none;
      }
    }

    .print-btn {
      margin-bottom: 20px;
      padding: 8px 14px;
      background: black;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }
  </style>
</head>

<body>

<button class="print-btn" onclick="window.print()">Download / Print</button>

<div class="container">

  <!-- Header -->
  <div class="header">
    <div class="logo">Techora</div>
    <div class="invoice-title">Invoice</div>
  </div>

  <!-- Order Info -->
  <div class="section info">
    <p><strong>Order ID:</strong> <%= order.orderId %></p>
    <p><strong>Order Date:</strong> 
      <%= new Date(order.createdAt).toLocaleString("en-IN") %>
    </p>
    <p><strong>Status:</strong> 
      <span class="badge <%= order.paymentStatus === 'Paid' ? 'paid' : 'pending' %>">
        <%= order.paymentStatus %>
      </span>
    </p>
    <p><strong>Payment Method:</strong> <%= order.paymentMethod %></p>
  </div>

  <!-- Address -->
  <div class="section">
    <h4>Billing Address</h4>
    <div class="info">
      <p><%= order.address.name %></p>
      <p><%= order.address.addressLine1 %></p>
      <p><%= order.address.addressLine2 %></p>
      <p><%= order.address.city %>, <%= order.address.state %></p>
      <p><%= order.address.zipCode %></p>
      <p>Phone: <%= order.address.phone %></p>
    </div>
  </div>

  <!-- Items -->
  <div class="section">
    <h4>Order Items</h4>

    <table>
      <thead>
        <tr>
          <th>Product</th>
          <th>Variant</th>
          <th>Qty</th>
          <th>Price</th>
          <th>Total</th>
        </tr>
      </thead>

      <tbody>
        <% order.items.forEach(item => { %>
          <tr>
            <td>
              <%= item.name %><br/>
              <small><%= item.brand %></small>
            </td>
            <td><%= item.color || '-' %></td>
            <td><%= item.quantity %></td>
            <td>₹<%= item.price %></td>
            <td>₹<%= item.total %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Totals -->
  <div class="total-section">
    <p>Subtotal: ₹<%= order.totalAmount %></p>
    <p>Shipping: ₹0</p>
    <p class="grand-total">Grand Total: ₹<%= order.totalAmount %></p>
  </div>

  <!-- Footer -->
  <div class="footer">
    <p>Thank you for shopping with us ❤️</p>
    <p>This is a system-generated invoice</p>
  </div>

</div>

</body>
</html>