<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify OTP</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="stylesheet" href="/styles/user/otpPage.css" />
    <link rel="stylesheet" href="/styles/user/popup.css" />
    <script src="/js/popup.js" defer></script>
  </head>
  <body  data-email="<%= email %>">
    <div id="toast" class="toast"></div>
    <div class="otp-card">
      <div class="icon-header">
        <i class="fa-solid fa-lock"></i>
      </div>

      <h2>Verify OTP</h2>
      <p id="email" class="phone-display"><%= email %></p>
      <div>
        <small id="otpError" style="color: red; display: none"></small>
      </div>

      <form id="otpForm">
        <div class="otp-inputs">
          <input
            type="tel"
            inputmode="numeric"
            maxlength="1"
            class="otp-input"
          />
          <input
            type="tel"
            inputmode="numeric"
            maxlength="1"
            class="otp-input"
          />
          <input
            type="tel"
            inputmode="numeric"
            maxlength="1"
            class="otp-input"
          />
          <input
            type="tel"
            inputmode="numeric"
            maxlength="1"
            class="otp-input"
          />
          <input
            type="tel"
            inputmode="numeric"
            maxlength="1"
            class="otp-input"
          />
          <input
            type="tel"
            inputmode="numeric"
            maxlength="1"
            class="otp-input"
          />
        </div>
        <input type="hidden" name="otp" id="otpValue" />
        <div class="timer-row">
          <i class="fa-solid fa-stopwatch"></i>
          <span>00:45 remaining</span>
        </div>

        <button type="submit" class="verify-btn">Verify OTP</button>
      </form>
      <p class="resend-text">
        Didn't receive the code? <span id="resendOtp">Resend OTP</span>
      </p>

      <a href="#" class="change-contact">
        <i class="fa-solid fa-envelope"></i>
        Change Email
      </a>

      <div class="security-footer">
        <i class="fa-solid fa-circle-check"></i>
        <span
          >Your information is secure and will be used only for verification
          purposes</span
        >
      </div>
    </div>

    <a href="/login" class="back-to-login">
      <i class="fa-solid fa-arrow-left"></i>
      Back to login
    </a>
  </body>
  <script defer>
    document.addEventListener('DOMContentLoaded', () => {
      const message = sessionStorage.getItem('otpMessage')
      if (message) {
        showToast(message, 'error')
        sessionStorage.removeItem('otpMessage')
      }

      /* ===============================
     INITIAL SETUP
  ================================ */
      const inputs = [...document.querySelectorAll('.otp-input')]
      const form = document.getElementById('otpForm')
      const otpError = document.getElementById('otpError')
      const resendBtn = document.getElementById('resendOtp')
      const timerSpan = document.querySelector('.timer-row span')
      const submitBtn = form.querySelector('button[type="submit"]')
      const email = document.body.dataset.email


      if (!inputs.length) return

      /* ===============================
     ERROR HANDLING
  ================================ */
      const showError = msg => {
        otpError.textContent = msg
        otpError.style.display = 'block'
      }

      const clearError = () => {
        otpError.textContent = ''
        otpError.style.display = 'none'
      }

      /* ===============================
     OTP INPUT HANDLING
  ================================ */
      inputs.forEach((input, index) => {
        input.addEventListener('input', () => {
          clearError()
          input.value = input.value.replace(/\D/g, '')

          if (input.value && index < inputs.length - 1) {
            inputs[index + 1].focus()
          }
        })

        input.addEventListener('keydown', e => {
          if (e.key === 'Backspace' && !input.value && index > 0) {
            inputs[index - 1].focus()
          }
        })
      })

      /* ===============================
     PASTE SUPPORT
  ================================ */
      inputs[0].addEventListener('paste', e => {
        e.preventDefault()
        const otp = e.clipboardData
          .getData('text')
          .replace(/\D/g, '')
          .slice(0, 6)

        otp.split('').forEach((digit, i) => {
          if (inputs[i]) inputs[i].value = digit
        })

        inputs[Math.min(otp.length, inputs.length) - 1].focus()
      })

      /* ===============================
     FORM SUBMIT + FETCH
  ================================ */
      form.addEventListener('submit', async e => {
        e.preventDefault()
        clearError()

        const otp = inputs.map(i => i.value).join('')
        if (otp.length !== 6) {
          showError('Please enter complete OTP')
          return
        }

        submitBtn.disabled = true

        try {
          const res = await fetch('/otp-verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ otp })
          })

          if (!res.ok) {
            throw new Error(`HTTP ${res.status}`)
          }

          const data = await res.json()

          if (!data.success) {
            showError(data.message || 'Invalid OTP')
            if (data.message?.toLowerCase().includes('expired')) {
              disableInputs()
              enableResend()
            }
            return
          }

          sessionStorage.removeItem('expiryTime')
          sessionStorage.setItem('success', data.message)
          window.location.href = '/login'
        } catch (err) {
          console.error(err)
          showError('Server error. Please try again.sssssssss')
        } finally {
          submitBtn.disabled = false
        }
      })

      /* ===============================
     TIMER LOGIC
  ================================ */
      const disableInputs = () => inputs.forEach(i => (i.disabled = true))

      const enableResend = () => {
        resendBtn.style.pointerEvents = 'auto'
        resendBtn.style.opacity = '1'
      }

      resendBtn.style.pointerEvents = 'none'
      resendBtn.style.opacity = '0.5'

      let expiresAt = Number(sessionStorage.getItem('expiryTime'))
      if (!expiresAt || isNaN(expiresAt)) {
        expiresAt = Date.now() + 60 * 1000
        sessionStorage.setItem('expiryTime', expiresAt)
      }

      let timeLeft = Math.floor((expiresAt - Date.now()) / 1000)

      const updateTimer = () => {
        const m = String(Math.floor(timeLeft / 60)).padStart(2, '0')
        const s = String(timeLeft % 60).padStart(2, '0')
        timerSpan.textContent = `${m}:${s} remaining`
      }

      if (timeLeft <= 0) {
        timerSpan.textContent = 'OTP expired'
        timerSpan.style.color = 'red'
        disableInputs()
        enableResend()
        sessionStorage.removeItem('expiryTime')
        return
      }

      updateTimer()
      const timer = setInterval(() => {
        timeLeft--
        updateTimer()

        if (timeLeft <= 0) {
          clearInterval(timer)
          timerSpan.textContent = 'OTP expired'
          timerSpan.style.color = 'red'
          disableInputs()
          enableResend()
          sessionStorage.removeItem('expiryTime')
        }
      }, 1000)


//----------------------------RESEND OTP----------------------------------------


      resendBtn.addEventListener('click', async () => {
        try {
          const response = await fetch('/resendOtp', {
            method: 'POST',
            headers: { 'Content-type': 'application/json' },
            body: JSON.stringify({email})
          })
          const resendData = await response.json()
          if (!response.ok) {
            throw new Error(resendData.message ||`HTTP ${response.status}`)
          }

          if (!resendData.success) {
          showToast(resendData.message, 'error')
            resendBtn.style.pointerEvents = 'auto'
            resendBtn.style.opacity = '1'
            disableInputs()
            return
          }

          showToast(resendData.message,"success")
          sessionStorage.setItem('expiryTime', Date.now() + 60 * 1000)
          location.reload()
        } catch (error) {
          showError( error.message|| 'Server error. Please try again.afwa')
          resendBtn.style.pointerEvents = 'auto'
          resendBtn.style.opacity = '1'
        }
      })
    })
  </script>
</html>
