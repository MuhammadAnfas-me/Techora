<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify OTP</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="stylesheet" href="/styles/user/otpPage.css" />
    <link rel="stylesheet" href="/styles/user/popup.css" />
    <script src="/js/popup.js" defer></script>
  </head>
  <body data-email="<%= email %>">
    <div id="toast" class="toast"></div>
    <div class="otp-card">
      <div class="icon-header">
        <i class="fa-solid fa-lock"></i>
      </div>

      <h2>Verify OTP</h2>
      <p id="email" class="phone-display"><%= email %></p>
      <div>
        <small id="otpError" style="color: red; display: none"></small>
      </div>

      <form id="otpForm">
        <div class="otp-inputs">
          <input
            type="tel"
            inputmode="numeric"
            maxlength="1"
            class="otp-input"
          />
          <input
            type="tel"
            inputmode="numeric"
            maxlength="1"
            class="otp-input"
          />
          <input
            type="tel"
            inputmode="numeric"
            maxlength="1"
            class="otp-input"
          />
          <input
            type="tel"
            inputmode="numeric"
            maxlength="1"
            class="otp-input"
          />
          <input
            type="tel"
            inputmode="numeric"
            maxlength="1"
            class="otp-input"
          />
          <input
            type="tel"
            inputmode="numeric"
            maxlength="1"
            class="otp-input"
          />
        </div>
        <input type="hidden" name="otp" id="otpValue" />
        <div class="timer-row">
          <i class="fa-solid fa-stopwatch"></i>
          <span>00:45 remaining</span>
        </div>

        <button type="submit" class="verify-btn">Verify OTP</button>
      </form>
      <p class="resend-text">
        Didn't receive the code? <span id="resendOtp">Resend OTP</span>
      </p>

      <a href="/signup" class="change-contact">
        <i class="fa-solid fa-envelope"></i>
        Change Email
      </a>

      <div class="security-footer">
        <i class="fa-solid fa-circle-check"></i>
        <span
          >Your information is secure and will be used only for verification
          purposes</span
        >
      </div>
    </div>

    <a href="/login" class="back-to-login">
      <i class="fa-solid fa-arrow-left"></i>
      Back to login
    </a>

  <div class="toast toast-banner" id="toast">
    <div class="tb-icon" id="toastIcon"></div>
    <div class="tb-text">
        <div class="tb-title" id="toastTitle"></div>
        <div class="tb-sub"   id="toastSub"></div>
    </div>
    <div class="tb-close" onclick="removeToast()">&#10005;</div>
</div>
  </body>
  <script defer>
  document.addEventListener('DOMContentLoaded', () => {
    /* ===============================
       INITIAL SETUP
    ================================ */
    const inputs = [...document.querySelectorAll('.otp-input')]
    const form = document.getElementById('otpForm')
    const otpError = document.getElementById('otpError')
    let resendBtn = document.getElementById('resendOtp')
    const timerSpan = document.querySelector('.timer-row span')
    const submitBtn = form.querySelector('button[type="submit"]')

    if (!inputs.length || !resendBtn) return

    /* ===============================
       EMAIL + PURPOSE SAFETY
    ================================ */
    let email = '<%= email %>' || sessionStorage.getItem('otpEmail')
    let purpose = '<%= purpose %>' || 'EMAIL_VERIFICATION'

    if (!email || typeof email !== 'string') {
      showError('Invalid session. Please restart the process.')
      return
    }

    sessionStorage.setItem('otpEmail', email)
    document.getElementById('email').textContent = email

    /* ===============================
       ERROR HELPERS
    ================================ */
    function showError(msg) {
      otpError.textContent = msg
      otpError.style.display = 'block'
    }

    function clearError() {
      otpError.textContent = ''
      otpError.style.display = 'none'
    }

    /* ===============================
       INPUT ENABLE / DISABLE
    ================================ */
    function disableInputs() {
      inputs.forEach(i => (i.disabled = true))
    }

    function enableInputs() {
      inputs.forEach(i => {
        i.disabled = false
        i.value = ''
      })
      inputs[0].focus()
    }

    function enableResend() {
      resendBtn.style.pointerEvents = 'auto'
      resendBtn.style.opacity = '1'
    }

    function disableResend() {
      resendBtn.style.pointerEvents = 'none'
      resendBtn.style.opacity = '0.5'
    }

    /* ===============================
           OTP INPUT HANDLING
    ================================ */
    inputs.forEach((input, index) => {
      input.addEventListener('input', () => {
        clearError()
        input.value = input.value.replace(/\D/g, '')

        if (input.value && index < inputs.length - 1) {
          inputs[index + 1].focus()
        }
      })

      input.addEventListener('keydown', e => {
        if (e.key === 'Backspace' && !input.value && index > 0) {
          inputs[index - 1].focus()
        }
      })
    })

    /* ===============================
            PASTE SUPPORT
    ================================ */
    inputs[0].addEventListener('paste', e => {
      e.preventDefault()
      const otp = e.clipboardData
        .getData('text')
        .replace(/\D/g, '')
        .slice(0, 6)

      otp.split('').forEach((digit, i) => {
        if (inputs[i]) inputs[i].value = digit
      })

      inputs[Math.min(otp.length, inputs.length) - 1].focus()
    })

    /* ===============================
              TIMER LOGIC 
    ================================ */
    let timer
    let expiresAt = Number(sessionStorage.getItem('expiryTime'))

    if (!expiresAt || isNaN(expiresAt)) {
      expiresAt = Date.now() + 60 * 1000
      sessionStorage.setItem('expiryTime', expiresAt)
    }

    let timeLeft = Math.floor((expiresAt - Date.now()) / 1000)

    function updateTimer() {
      const m = String(Math.floor(timeLeft / 60)).padStart(2, '0')
      const s = String(timeLeft % 60).padStart(2, '0')
      timerSpan.textContent = `${m}:${s} remaining`
    }

    function startTimer() {
      clearInterval(timer)
      updateTimer()

      timer = setInterval(() => {
        timeLeft--
        updateTimer()

        if (timeLeft <= 0) {
          clearInterval(timer)
          timerSpan.textContent = 'OTP expired'
          timerSpan.style.color = 'red'
          disableInputs()
          enableResend()
          sessionStorage.removeItem('expiryTime')
        }
      }, 1000)
    }

    if (timeLeft <= 0) {
      timerSpan.textContent = 'OTP expired'
      timerSpan.style.color = 'red'
      disableInputs()
      enableResend()
    } else {
      disableResend()
      startTimer()
    }

    /* ===============================
       OTP VERIFY SUBMIT
    ================================ */
    form.addEventListener('submit', async e => {
      e.preventDefault()
      clearError()

      const otp = inputs.map(i => i.value).join('')
      if (otp.length !== 6) {
        showError('Please enter complete OTP')
        return
      }

      setButtonLoading(submitBtn,true)
      submitBtn.disabled = true


      try {
        const res = await fetch('/otp-verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ otp, email, purpose })
        })

        const data = await res.json()

        if (!res.ok || !data.success) {
          showError(data.message || 'Invalid OTP')
          return
        }

        sessionStorage.removeItem('expiryTime')
        sessionStorage.removeItem('otpEmail')
        if(sessionStorage.getItem("isVerified")){
          sessionStorage.setItem('success', "Account verified successfully")
        }else{
        sessionStorage.setItem('success', data.message)
        sessionStorage.removeItem("isVerfied")
        }
        if(purpose == "RESET_PASSWORD"){
          sessionStorage.setItem("resetToken",data.resetToken)
        window.location.href = '/reset-password'
        }else{
          window.location.href = "/login"
        }
      } catch (err) {
        showError('Server error. Please try again.')
      } finally {
        setButtonLoading(submitBtn,false)
        submitBtn.disabled = false
      }
    })

    /* ===============================
       RESEND OTP (NO DOUBLE CALL)
    ================================ */
    resendBtn.replaceWith(resendBtn.cloneNode(true))
    resendBtn = document.getElementById('resendOtp')

    resendBtn.addEventListener('click', async () => {
      try {
        setButtonLoading(resendBtn,true)
        disableResend()
        clearError()

        const res = await fetch('/resendOtp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, purpose })
        })

        const data = await res.json()
        if (!res.ok || !data.success) {
          throw new Error(data.message || 'Failed to resend OTP')
        }

        showToast(data.message, 'success')

        const newExpiry = Date.now() + 60 * 1000
        sessionStorage.setItem('expiryTime', newExpiry)
        timeLeft = 60
        timerSpan.style.color = ''
        enableInputs()
        startTimer()
      } catch (err) {
        showError(err.message)
        console.log(err)
        enableResend()
      }
      setButtonLoading(resendBtn,false)
    })
  })
</script>

</html>
