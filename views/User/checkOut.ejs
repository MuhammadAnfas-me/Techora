<div class="stepper-bg">
    <div class="stepper-container">
        <div class="step">
            <div class="step-num step-done">1</div>
            <span class="step-label text-gray-600">CART</span>
        </div>
        <div class="line"></div>
        <div class="step">
            <div class="step-num step-active">2</div>
            <span class="step-label text-dark">ADDRESS</span>
        </div>
        <div class="line"></div>
        <div class="step">
            <div class="step-num step-inactive">3</div>
            <span class="step-label text-gray-600">PAYMENT</span>
        </div>
        <div class="line"></div>
        <div class="step">
            <div class="step-num step-inactive">4</div>
            <span class="step-label text-gray-400">CONFIRM</span>
        </div>
    </div>
</div>

<main class="main-layout container">
    <div class="grid-layout">
        
        <div class="left-column">
            
            <section class="card">
                <div class="addressHeader">
                    <h2 class="card-title">Delivery Address</h2>
                    <button class="address-btn" onclick="openDrawer()">Add</button>
                </div>
                
                <div class="address-box">
                    <% if(address.length > 0){ %>
                    <div class="radio-indicator">
                        <div class="radio-dot"></div>
                    </div>
                    <% } %>
                    <div class="address-content">
                        <% if(address.length > 0){ %>
                   
                            <div class="address-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                                </svg>
                            </div>
                    <% } %>
                        <% if(address.length === 0){ %>
<div class="address-container empty">

    <div class="empty-wrapper">

        <div class="empty-icon">
            <span class="material-symbols-outlined">location_on</span>
        </div>

        <h3>Add your delivery address</h3>
        <p>This is required to continue checkout</p>

        <button class="btn-add-address" onclick="openDrawer()">
            + Add Address
        </button>

    </div>

</div>
                        <% }else{ %>
                            
                        <% const addr = address.find(item => item.default) %>

                        <% if(addr){ %>
                            <div class="address-details" id="selectedAddress">
                            <div class="address-text" >
                                <p class="address-type"><%= addr.type %></p>
                                <p class="address-name"><%= addr.fullName %></p>
                                <p class="address-phone">+91 <%= addr.phone %></p>
                                <p class="address-line"><%= addr.addressLine1 %> </p>
                                <p class="address-line"><%= addr.city %>, <%= addr.state %> - <%= addr.zipCode %></p>
                            </div>
                        </div>
                        <% }else{ %>
                            <div class="address-details" id="selectedAddress">
                            <div class="address-text" >
                                <p class="address-type"><%= address[0].type %></p>
                                <p class="address-name"><%= address[0].fullName %></p>
                                <p class="address-phone">+91 <%= address[0].phone %></p>
                                <p class="address-line"><%= address[0].addressLine1 %> </p>
                                <p class="address-line"><%= address[0].city %>, <%= address[0].state %> - <%= address[0].zipCode %></p>
                            </div>
                        </div>
                        <% } %>

                 
                        <% } %>
                    </div>
                </div>
                <% if(address.length>0) {%>
                <button class="btn-primary mt-24" onclick="openAddressModal()">Change Address</button>
                <% } %>
            </section>
            
            <section class="card p-0">
                <div class="card-header border-b">
                    <h2 class="card-title m-0">Order Summary</h2>
                    <span class="item-badge"><%= cartItems.length %> items</span>
                </div>
                <div class="card-body">
                    <% cartItems.forEach(item=>{ %>
                    <div class="order-item border-b pb-24">
                        <div class="item-img-box">
                            <img alt="iPhone 15 Pro Max" src="<%= item?.image %>"/>
                        </div>
                        <div class="item-info">
                            <div class="item-top">
                                <div>
                                    <h3 class="item-name"><%= item.name %></h3>
                                     <% if (!item.isValid) { %>
                                      <p class="error-message" style="color:red;">
                                        <%= item.message %>
                                      </p>
                                    <% } %>
                                    <p class="item-desc"><%= item.brand.toUpperCase() %> • <%= item.color %></p>
                                </div>
                                <p class="item-price"><%= formatINR(item.subtotal) %></p>
                            </div>
                            <div class="item-bottom">
                                <span>Qty:</span>
                                <div class="qty-box"><%= item.quantity %></div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
            </section>
        </div>


        <div id="addressModal" class="modal hidden">
  <div class="modal-content">
    <h3>Select Address</h3>

    <% address.forEach((addr, index) => { %>
      <div class="address-card" onclick="selectCard(this)">
        <input type="radio" name="address"
          value="<%= addr._id %>"
          onclick="selectAddress('<%= addr._id %>')">
    <div class="address-details" id="selectedAddress">
        <div>
            <p><%= addr.fullName %></p>
            <p><%= addr.phone %></p>
            <p><%= addr.city %></p>
        </div>
            <button type="button" class="btn-edit-inline editBtn" onclick="event.stopPropagation(); editAddress('<%= addr._id %>')">
                <span class="material-symbols-outlined  ">edit</span>
            </button>
    </div>
      </div>
    <% }) %>

    <button class="confirm" onclick="confirmAddress()">Confirm</button>
  </div>
</div>

        
        <div class="right-column">
            
            <section class="card">




                <h2 class="card-title border-b pb-8">Price Summary</h2>
                <div class="price-list">
                    <div class="price-row">
                        <span>Subtotal (<%= cartItems.length %> items)</span>
                        <span class="price-val"><%= formatINR(grandTotal) %></span>
                    </div>
                    <div class="price-row">
                        <span>Discount</span>
                        <span class="price-val text-green" id="discount">-₹0.00</span>
                    </div>
                    <div class="price-row">
                        <span>Delivery</span>
                        <span class="price-val text-green uppercase">Free</span>
                    </div>
<div class="coupon-box">

  <% if (!coupon) { %>

    <!-- View Button -->
    <div class="coupon-header">
      <button class="coupon-view-btn" onclick="openCouponModal()">
        🎟 View Coupons
      </button>
    </div>

    <!-- Input + Apply -->
    <div class="coupon-input-group">
      <input 
        type="text" 
        id="coupon-code" 
        placeholder="Select or enter coupon" 
      />
      <button onclick="applyCoupon()" class="apply-btn">Apply</button>
    </div>

  <% } else { %>

    <!-- Applied State -->
    <div class="applied-coupon-box" id="applied-coupon">
      <span>✅ <strong><%= coupon %></strong> applied</span>
      <button onclick="removeCoupon()">Remove</button>
    </div>

  <% } %>

</div>

<div id="couponModal" class="coupon-modal">
  <div class="coupon-modal-content">

    <div class="coupon-modal-header">
      <h3>🎟 Available Coupons</h3>
      <span class="close-btn" onclick="closeCouponModal()">×</span>
    </div>

    <div id="coupon-list" class="coupon-list"></div>

  </div>
</div>
                </div>
                <div class="total-row">
                    <span class="total-label">Total Amount</span>
                    <span class="total-val" id="finalTotal"><%= formatINR(grandTotal) %></span>
                </div>
                <button class="btn-primary proceed full-width btn-large shadow-blue" <%= hasInvalidItems ? "disabled" : "" %>>Proceed to Payment</button>
            </section>
            
            <section class="card">
                <h2 class="trust-title">Why Choose Us?</h2>
                <div class="trust-list">
                    <div class="trust-item">
                        <div class="trust-icon bg-green-light text-green-dark">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="3"></path></svg>
                        </div>
                        <div>
                            <p class="trust-heading">Secure Checkout</p>
                            <p class="trust-desc">256-bit SSL encryption</p>
                        </div>
                    </div>
                    <div class="trust-item">
                        <div class="trust-icon bg-blue-light text-blue-dark">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                        </div>
                        <div>
                            <p class="trust-heading">Easy Returns</p>
                            <p class="trust-desc">7-day return policy</p>
                        </div>
                    </div>
                    <div class="trust-item">
                        <div class="trust-icon bg-purple-light text-purple-dark">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                        </div>
                        <div>
                            <p class="trust-heading">Brand Warranty</p>
                            <p class="trust-desc">Official manufacturer warranty</p>
                        </div>
                    </div>
                </div>
            </section>
            
        </div>
    </div>
</main>

<!-- Modal -->
<div class="add-address-modal-overlay" id="addAddressModalOverlay">
    <div class="add-address-modal-content" id="addAddressModalContent">
        
        <div class="add-address-modal-header">
            <div>
                <h2 class="add-address-modal-title">Add New Address</h2>
                <p class="add-address-modal-subtitle">Enter your address details</p>
            </div>
            <button class="add-address-modal-close" id="closeAddAddressModalBtn">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form class="add-address-form" id="addAddressForm" novalidate>

            <div class="form-group">
                <label class="form-label">Full Name <span class="required">*</span></label>
                <input type="text" id="addName" class="form-input" placeholder="Enter full name" required>
                <input type="hidden" id="addAddressId">
            </div>

            <div class="form-group">
                <label class="form-label">Phone Number <span class="required">*</span></label>
                <input type="tel" id="addPhone" class="form-input" placeholder="Enter phone number" required>
                <small class="addPhoneError"></small>
            </div>

            <div class="form-group">
                <label class="form-label">Address Line 1 <span class="required">*</span></label>
                <input type="text" id="addAddress1" class="form-input" placeholder="Street address, P.O. box" required>
            </div>

            <div class="form-group">
                <label class="form-label">Address Line 2</label>
                <input type="text" id="addAddress2" class="form-input" placeholder="Apartment, suite, etc.">
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">City <span class="required">*</span></label>
                    <input type="text" id="addCity" class="form-input" placeholder="Enter city" required>
                </div>
                <div class="form-group">
                    <label class="form-label">State <span class="required">*</span></label>
                    <input type="text" id="addState" class="form-input" placeholder="Enter state" required>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">ZIP Code <span class="required">*</span></label>
                    <input type="text" id="addZipCode" class="form-input" placeholder="Enter ZIP code" required>
                    <small class="addZipCodeError"></small>
                </div>

                <div class="form-group">
                    <label class="form-label">Country <span class="required">*</span></label>
                    <select class="form-input" id="addCountry" required>
                        <option value="" disabled hidden>Select country</option>
                        <option value="India">India</option>
                        <option value="United States">United States</option>
                        <option value="United Kingdom">United Kingdom</option>
                        <option value="Canada">Canada</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Address Label <span class="required">*</span></label>
                <div class="radio-group">
                    <label class="radio-label">
                        <input type="radio" name="addLabel" value="Home" checked>
                        <span>Home</span>
                    </label>
                    <label class="radio-label">
                        <input type="radio" name="addLabel" value="Work">
                        <span>Work</span>
                    </label>
                    <label class="radio-label">
                        <input type="radio" name="addLabel" value="Other">
                        <span>Other</span>
                    </label>
                </div>
            </div>

            <div class="checkbox-container">
                <input type="checkbox" id="addDefaultAddress" class="checkbox-input">
                <label for="addDefaultAddress" class="checkbox-label">Set as default address</label>
            </div>

            <div class="form-actions">
                <button type="button" class="btn-cancel" id="cancelAddAddressBtn">Cancel</button>
                <button type="submit" class="btn-submit">
                    <span class="submit-indicator"></span>
                    Save Address
                </button>
            </div>
        </form>

    </div>
</div>

<%- include('../partitials/user/footer.ejs') %>

<script>
    const addresses = <%- JSON.stringify(address) %>;
</script>