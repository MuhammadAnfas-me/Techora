<div class="stepper-bg">
    <div class="stepper-container">
        <div class="step">
            <div class="step-num step-done">1</div>
            <span class="step-label text-gray-600">CART</span>
        </div>
        <div class="line"></div>
        <div class="step">
            <div class="step-num step-active">2</div>
            <span class="step-label text-dark">ADDRESS</span>
        </div>
        <div class="line"></div>
        <div class="step">
            <div class="step-num step-inactive">3</div>
            <span class="step-label text-gray-600">PAYMENT</span>
        </div>
        <div class="line"></div>
        <div class="step">
            <div class="step-num step-inactive">4</div>
            <span class="step-label text-gray-400">CONFIRM</span>
        </div>
    </div>
</div>

<main class="main-layout container">
    <div class="grid-layout">
        
        <div class="left-column">
            
            <section class="card">
                <h2 class="card-title">Delivery Address</h2>
                <div class="address-box">
                    <div class="radio-indicator">
                        <div class="radio-dot"></div>
                    </div>
                    <div class="address-content">
                        <div class="address-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                            </svg>
                        </div>
                        <% address.forEach(element => { %>
                        <% if(!element.default) return %>    
                        
                        <div class="address-details" id="selectedAddress">
                            <p class="address-type"><%= element.type %></p>
                            <div class="address-text" >
                                <p class="address-name"><%= element.fullName %></p>
                                <p class="address-phone">+91 <%= element.phone %></p>
                                <p class="address-line"><%= element.addressLine1 %> </p>
                                <p class="address-line"><%= element.city %>, <%= element.state %> - <%= element.zipCode %></p>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <button class="btn-primary mt-24" onclick="openAddressModal()">Change Address</button>
            </section>
            
            <section class="card p-0">
                <div class="card-header border-b">
                    <h2 class="card-title m-0">Order Summary</h2>
                    <span class="item-badge"><%= cartItems.length %> items</span>
                </div>
                <div class="card-body">
                    <% cartItems.forEach(item=>{ %>
                    <div class="order-item border-b pb-24">
                        <div class="item-img-box">
                            <img alt="iPhone 15 Pro Max" src="<%= item?.image %>"/>
                        </div>
                        <div class="item-info">
                            <div class="item-top">
                                <div>
                                    <h3 class="item-name"><%= item.name %></h3>
                                     <% if (!item.isValid) { %>
      <p class="error-message" style="color:red;">
        <%= item.message %>
      </p>
    <% } %>
                                    <p class="item-desc"><%= item.brand.toUpperCase() %> • <%= item.color %></p>
                                </div>
                                <p class="item-price"><%= formatINR(item.subtotal) %></p>
                            </div>
                            <div class="item-bottom">
                                <span>Qty:</span>
                                <div class="qty-box"><%= item.quantity %></div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
            </section>
        </div>


        <div id="addressModal" class="modal hidden">
  <div class="modal-content">
    <h3>Select Address</h3>

    <% address.forEach((addr, index) => { %>
      <div class="address-card" onclick="selectCard(this)">
        <input type="radio" name="address"
          value="<%= addr._id %>"
          onclick="selectAddress('<%= addr._id %>')">
    <div class="address-details" id="selectedAddress">
        <p><%= addr.fullName %></p>
        <p><%= addr.phone %></p>
        <p><%= addr.city %></p>
    </div>
      </div>
    <% }) %>

    <button onclick="confirmAddress()">Confirm</button>
  </div>
</div>

        
        <div class="right-column">
            
            <section class="card">
                <h2 class="card-title border-b pb-8">Price Summary</h2>
                <div class="price-list">
                    <div class="price-row">
                        <span>Subtotal (<%= cartItems.length %> items)</span>
                        <span class="price-val"><%= formatINR(grandTotal) %></span>
                    </div>
                    <div class="price-row">
                        <span>Discount</span>
                        <span class="price-val text-green">-₹0,000</span>
                    </div>
                    <div class="price-row">
                        <span>Delivery</span>
                        <span class="price-val text-green uppercase">Free</span>
                    </div>
                    <div class="price-row">
                        <span>GST (18%)</span>
                        <span class="price-val"><%= formatINR(grandTotal*(18/100)) %></span>
                    </div>
                </div>
                <div class="total-row">
                    <span class="total-label">Total Amount</span>
                    <span class="total-val"><%= formatINR(grandTotal+ grandTotal*18/100) %></span>
                </div>
                <button class="btn-primary proceed full-width btn-large shadow-blue" <%= hasInvalidItems ? "disabled" : "" %>>Proceed to Payment</button>
            </section>
            
            <section class="card">
                <h2 class="trust-title">Why Choose Us?</h2>
                <div class="trust-list">
                    <div class="trust-item">
                        <div class="trust-icon bg-green-light text-green-dark">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="3"></path></svg>
                        </div>
                        <div>
                            <p class="trust-heading">Secure Checkout</p>
                            <p class="trust-desc">256-bit SSL encryption</p>
                        </div>
                    </div>
                    <div class="trust-item">
                        <div class="trust-icon bg-blue-light text-blue-dark">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                        </div>
                        <div>
                            <p class="trust-heading">Easy Returns</p>
                            <p class="trust-desc">7-day return policy</p>
                        </div>
                    </div>
                    <div class="trust-item">
                        <div class="trust-icon bg-purple-light text-purple-dark">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                        </div>
                        <div>
                            <p class="trust-heading">Brand Warranty</p>
                            <p class="trust-desc">Official manufacturer warranty</p>
                        </div>
                    </div>
                </div>
            </section>
            
        </div>
    </div>
</main>

<%- include('../partitials/user/footer.ejs') %>

<script>
    const addresses = <%- JSON.stringify(address) %>;


    document.querySelector('.proceed').addEventListener('click', function(e) {
    // Basic interaction for the "Place Order" button
    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
    this.disabled = true;

    // Simulate backend call
    setTimeout(() => {
        window.location.href = `/checkout/payment?addressId=${selectedAddressId}`; // Target for Step 4
    }, 1500);
});

let selectedAddressIndex = 0

function openAddressModal() {
  document.getElementById('addressModal').classList.remove('hidden')
}

function selectAddress(id) {
  selectedAddressId = id
}

function selectCard(card) {
  // remove active class from all cards
  document.querySelectorAll('.address-card').forEach(c => {
    c.classList.remove('active')
  })

  // add active class to clicked card
  card.classList.add('active')

  // select radio inside clicked card
  const radio = card.querySelector('input[type="radio"]')
  radio.checked = true
  selectedAddressId = radio.value
}

document.querySelectorAll('.address-card input').forEach(input => {
  input.addEventListener('click', (e) => {
    e.stopPropagation() // prevent double triggering
  })
})

function confirmAddress() {
  const selectedAddress = addresses.find(addr => addr._id === selectedAddressId)

  document.getElementById('selectedAddress').innerHTML = `
  <p class="address-type">${selectedAddress.type}</p>
    <div class="address-text" >
    <p class="address-name">${selectedAddress.fullName}</p>
    <p class="address-phone">+91 ${ selectedAddress.phone} </p>
    <p class="address-line"> ${selectedAddress.addressLine1}  </p>
    <p class="address-line">${selectedAddress.city} , ${selectedAddress.state}  -  ${selectedAddress.zipCode}</p>
    </div>
  `

  // close modal
  document.getElementById('addressModal').classList.add('hidden')
}

window.onload = () => {
  const firstCard = document.querySelector('.address-card')
  if (firstCard) selectCard(firstCard)
}
</script>