<link rel="stylesheet" href="/styles/user/checkOut.css">
<%- include("../partitials/user/header.ejs") %>


<main class="checkout-container">
    <div class="stepper">
        <div class="step completed"><span>1</span><p>Cart</p></div>
        <div class="line completed"></div>
        <div class="step completed"><span>2</span><p>Address</p></div>
        <div class="line active"></div>
        <div class="step active"><span>3</span><p>Payment</p></div>
        <div class="line"></div>
        <div class="step"><span>4</span><p>Confirm</p></div>
    </div>

    <div class="checkout-content">
        <section class="main-column">
            <div class="card">
                <div class="card-header">
                    <h2>Delivery Address</h2>
                </div>
                <div class="card-body">
                    <div class="address-box selected">
                        <div class="address-type">
                            <i class="fas fa-home"></i> Home
                            <span class="radio-indicator"></span>
                        </div>
                        <div class="address-details">
                            <strong>Rajesh Kumar</strong>
                            <p>+91 98765 43210</p>
                            <address>
                                123, MG Road, Indiranagar<br>
                                Bangalore, Karnataka - 560038
                            </address>
                        </div>
                    </div>
                    <button class="btn-outline">Change Address</button>
                </div>
            </div>

            <div class="card mt-20">
                <div class="card-header flex-between">
                    <h2>Order Summary</h2>
                    <span class="badge">2 Items</span>
                </div>
                <div class="card-body">
                    <div class="order-item">
                        <div class="item-img-placeholder"></div>
                        <div class="item-info">
                            <h3>iPhone 15 Pro Max</h3>
                            <p>Apple • 256GB • Natural Titanium</p>
                            <div class="item-meta">
                                <span>Qty: 1</span>
                                <span class="price">₹1,34,900</span>
                            </div>
                        </div>
                    </div>
                    <div class="order-item">
                        <div class="item-img-placeholder"></div>
                        <div class="item-info">
                            <h3>AirPods Pro (2nd Gen)</h3>
                            <p>Apple • USB-C • Active Noise Cancellation</p>
                            <div class="item-meta">
                                <span>Qty: 1</span>
                                <span class="price">₹24,900</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <aside class="sidebar-column">
            <div class="card price-summary">
                <div class="card-header">
                    <h2>Price Summary</h2>
                </div>
                <div class="card-body">
                    <div class="price-row"><span>Subtotal (2 items)</span><span>₹1,59,800</span></div>
                    <div class="price-row"><span>Discount</span><span class="discount">-₹5,000</span></div>
                    <div class="price-row"><span>Delivery</span><span class="free">FREE</span></div>
                    <div class="price-row"><span>GST (18%)</span><span>₹27,864</span></div>
                    <hr>
                    <div class="price-row total">
                        <span>Total Amount</span>
                        <span>₹1,82,664</span>
                    </div>
                    <button class="btn-primary full-width">Place Order Securely</button>
                </div>
            </div>

            <div class="card trust-badges mt-20">
                <div class="trust-item">
                    <div class="icon-circle secure"><i class="fas fa-shield-alt"></i></div>
                    <div>
                        <h4>Secure Checkout</h4>
                        <p>256-bit SSL encryption</p>
                    </div>
                </div>
                <div class="trust-item">
                    <div class="icon-circle returns"><i class="fas fa-undo"></i></div>
                    <div>
                        <h4>Easy Returns</h4>
                        <p>7-day return policy</p>
                    </div>
                </div>
                <div class="trust-item">
                    <div class="icon-circle warranty"><i class="fas fa-award"></i></div>
                    <div>
                        <h4>Brand Warranty</h4>
                        <p>Official manufacturer warranty</p>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</main>

<%- include('../partitials/user/footer.ejs') %>