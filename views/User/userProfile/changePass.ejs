
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="/styles/user/userProfile/changePass.css">

<%- include("../../partitials/user/header.ejs",{tittle : "Techora | Profile" ,email , name }) %>


<main class="password-page">
    <div class="password-container">
        <header class="page-title">
            <h1>Change Password</h1>
            <p>Update your account password to keep your account secure</p>
        </header>

        <section class="form-card">
            <form id="changePasswordForm" novalidate>
                <div class="form-group">
                    <label for="currentPassword">Current Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="currentPassword" placeholder="Enter current password" required>
                        <i class="fa-solid fa-eye toggle-password" data-target="currentPassword"></i>
                    </div>
                    <small id="PasswordError" style="color: red"></small>
                </div>

                <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="newPassword" placeholder="Enter new password" required>
                        <i class="fa-solid fa-eye toggle-password" data-target="newPassword"></i>
                    </div>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm New Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="confirmPassword" placeholder="Re-enter new password" required>
                        <i class="fa-solid fa-eye toggle-password" data-target="confirmPassword"></i>
                    </div>
                    <small id="confirmPasswordError" style="color: red"></small>
                </div>

                <div class="requirements-box">
                    <h3>Password Requirements:</h3>
                    <ul>
                        <li id="req-length" class="invalid">Minimum 8 characters</li>
                        <li id="req-upper" class="invalid">At least one uppercase letter</li>
                        <li id="req-number" class="invalid">At least one number</li>
                        <li id="req-special" class="invalid">At least one special character</li>
                    </ul>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-cancel" onclick="window.history.back()">Cancel</button>
                    <button type="submit" id="btnUpdate" class="btn-update">Update Password</button>
                </div>
            </form>
        </section>
    </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', function() {
    
    // --- 1. Toggle Password Visibility ---
    const toggleIcons = document.querySelectorAll('.toggle-password');

    toggleIcons.forEach(icon => {
        icon.addEventListener('click', function() {
            const targetId = this.getAttribute('data-target');
            const inputField = document.getElementById(targetId);
            
            if (inputField.type === 'password') {
                inputField.type = 'text';
                this.classList.remove('fa-eye');
                this.classList.add('fa-eye-slash');
            } else {
                inputField.type = 'password';
                this.classList.remove('fa-eye-slash');
                this.classList.add('fa-eye');
            }
        });
    });

    // --- 2. Real-time Validation ---
    const newPassInput = document.getElementById('newPassword');
    const reqLength = document.getElementById('req-length');
    const reqUpper = document.getElementById('req-upper');
    const reqNumber = document.getElementById('req-number');
    const reqSpecial = document.getElementById('req-special');

    const patterns = {
        upper: /[A-Z]/,
        number: /[0-9]/,
        special: /[!@#$%^&*(),.?":{}|<>]/
    };

    function validateRequirement(isValid, element) {
        if (isValid) {
            element.classList.remove('invalid');
            element.classList.add('valid');
            element.style.color = 'green';
            // Optional: Add checkmark icon
        } else {
            element.classList.remove('valid');
            element.classList.add('invalid');
            element.style.color = '#666'; // Reset or red
        }
    }

    newPassInput.addEventListener('keyup', function() {
        const value = this.value;
        
        validateRequirement(value.length >= 8, reqLength);
        validateRequirement(patterns.upper.test(value), reqUpper);
        validateRequirement(patterns.number.test(value), reqNumber);
        validateRequirement(patterns.special.test(value), reqSpecial);
    });

    // --- 3. Form Submission ---
    const form = document.getElementById('changePasswordForm');

    form.addEventListener('submit', async function(e) {
        e.preventDefault();

        const currentPassword = document.getElementById('currentPassword').value;
        const newPassword = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;

        const confirmPasswordError = document.getElementById(
          'confirmPasswordError'
        )
        const PasswordError = document.getElementById(
          'PasswordError'
        )
        confirmPasswordError.textContent = ''
        PasswordError.textContent = ''

        // Basic Front-end Checks
        
        if (newPassword.length < 8 || 
           !patterns.upper.test(newPassword) || 
           !patterns.number.test(newPassword) || 
           !patterns.special.test(newPassword)) {
            showToast("Please meet all password requirements.","error");
            return;
        }
        if (newPassword !== confirmPassword) {
            confirmPasswordError.textContent = "• Confirm Password do not match!";
            return;
        }
        const btn = document.getElementById("btnUpdate")


        // API Call
        try {
            setButtonLoading(btn,true)
            const res = await axios.patch("/profile/password",{
                currentPassword,
                confirmPassword
            });
                showToast(res.data.message || "Password updated successfully!")
                PasswordError.textContent = ""        

            setTimeout(()=>{
                window.location.href = "/profile"
                setButtonLoading(btn,false)
            },1000)

        } catch (error) {
            console.error('Error:', error);
            const message = error.response?.data?.message ||  "Something went wrong. Please try again."
            if(message.toLowerCase() == "incorrect password"){
                PasswordError.textContent = message
                return
            }
            showToast(message , "error");
        }
    });
});
</script>

<%- include("../../partitials/user/footer.ejs") %>