<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Techora - Mobile Accessories</title>
        <link rel="icon" href="https://res.cloudinary.com/dpbqsetq2/image/upload/v1779353242/site_favicon_1779348919224_ejgxyn.jpg" type="image/png">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/user/products/productPage.css">
    <script defer src="/js/user/productPage.js"></script>
</head>
<body data-logged-in="<%= user ? 'true' : 'false' %>">

    <%- include("../../partitials/user/header.ejs",{tittle : "Techora | Products"  }) %>

    <main class="container" style="padding-top: 2rem; padding-bottom: 2rem;">
        <div class="main-layout">
            <aside class="sidebar">
                <form method="GET" action="/products" id="filterForm">
                <div class="filter-card">
                    <div class="filter-header">
                        <h2 class="filter-title">Filters</h2>
                        <button type="button" class="clear-btn" id="clearFiltersBtn" onclick="window.location.href='/products'">Clear All</button>
                    </div>
                    
                    <div class="filter-section">
                        <h3>Category</h3>
                        <div class="checkbox-group">
                            <% category.forEach((cat)=>{ %>
                            <label class="checkbox-label"><input type="checkbox" name="category" value="<%= cat._id %>" <%= selectedCategory?.includes(String(cat._id)) ? "checked" : "" %> class="checkbox-input"> <%= cat.name %></label>
                            <% }) %>
                            
                        </div>
                    </div>
                    
                    <hr class="divider">
                    
                    <div class="filter-section">
                        <h3>Brand</h3>
                        <div class="checkbox-group">
                            <% brands.forEach((brand)=>{ %>
                            <label class="checkbox-label"><input type="checkbox" name="brand" class="checkbox-input" value="<%= brand %>"
                                <%= Array.isArray(selectedBrands) && selectedBrands.includes(brand) ? "checked" : "" %> ><%= brand.toUpperCase() %></label>
                            <% }) %>
                        </div>
                    </div>

                    <hr class="divider">
                    <%
                      const defaultMin = 0;
                      const defaultMax = 50000;
                    %>
                     <div class="filter-section">
                        <h3>Price Range</h3>

                        <div class="double-range-wrapper">
                            <div class="slider-track"></div>
                        
                            <input
                                type="range"
                                id="minRange"
                                name="minPrice"
                                min="0"
                                max="50000"
                                step="100"
                                value="<%= minPrice !== '' && minPrice != null ? minPrice : defaultMin %>"
                                class="range-input range-min"
                            >
                        
                            <input
                                type="range"
                                id="maxRange"
                                name="maxPrice"
                                min="0"
                                max="50000"
                                step="100"
                                value="<%= maxPrice !== '' && maxPrice != null ? maxPrice : defaultMax %>"
                                class="range-input range-max"
                            >
                        </div>
                    
                        <div class="price-labels">
                            <span id="minPriceLabel">₹<%= minPrice !== '' && minPrice != null ? minPrice : defaultMin %></span>
                            <span id="maxPriceLabel">₹<%= maxPrice !== '' && maxPrice != null ? maxPrice : defaultMax %></span>
                        </div>
                    </div>

                    <hr class="divider">

                    
                    <div class="filter-actions">
                <button type="submit" class="apply-filter-btn">Apply Filter</button>
            </div>
            
            <input type="hidden" name="page" value="1">
             </form>
                </div>
            </aside>
            <section class="content-area">
                <div class="page-header">
                    <div>
                        <h1 class="page-title">Mobile Accessories</h1>
                        <p class="page-subtitle">Showing <span id="productCount"><%= products.length %></span> products</p>
                    </div>
                    <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
        

                    <div class="sort-wrapper">
                        <span class="page-subtitle">Sort by:</span>
                        <select class="sort-select" id="sort-select" name="sort" form="filterForm">
                            <option value="">Default</option>
                            <option value="priceLowToHigh" <%= selectedSort === "priceLowToHigh" ? "selected" : "" %>>Price: Low to High</option>
                            <option value="priceHighToLow" <%= selectedSort === "priceHighToLow" ? "selected" : "" %>>Price: High to Low</option>
                            <option value="newest" <%= selectedSort === "newest" ? "selected" : "" %>>Newest</option>
                            <option value="nameAZ" <%= selectedSort === "nameAZ" ? "selected" : "" %>>Name: A to Z</option>
                        </select>
                    </div>

                   <div class="search-box">
                      <div class="search-input-wrapper">
                        <input 
                          type="text" 
                          name="search" 
                          form="filterForm"
                          class="search-input"
                          id="searchInput"
                          placeholder="Search products..."
                          value="<%= search || '' %>"
                        >
                    
                        <button
                          type="button"
                          id="clearSearchBtn"
                          class="clear-search-btn"
                          aria-label="Clear search"
                        >
                          ×
                        </button>
                      </div>
                  
                      <button type="submit" id="searchBtn" form="filterForm" class="search-btn">
                        Search
                      </button>
                    </div>
                   </div>
                </div>

                <div class="mobile-actions">
                    <button class="mobile-btn" onclick="toggleDrawer('mobile-filter-drawer', true)">
                        <div class="h-5 w-5"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 4.5h18m-18 5h18m-18 5h18m-18 5h18" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
                        Filters
                    </button>
                    <button class="mobile-btn" onclick="toggleDrawer('mobile-sort-drawer', true)">
                        <div class="h-5 w-5"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 7h18M6 12h12m-9 5h6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
                        Sort
                    </button>
                </div>
                <div id="productsSection">
                <div class="product-grid" id="productsContainer">
                    
                    <% products.forEach((product)=>{ %>
                    <article class="product-card" id="productCard" onclick="openProductPage('<%= product.name %>')">
                        <div class="card-image-wrapper">
                            <img src="<%= product.variants[0]?.image[0] %>" alt="MagSafe Wireless Charger" class="card-img">
                            <% 
                            const now = new Date()
                            const createdAt = new Date(product.createdAt)
                            const diffDays = (now-createdAt) / (1000*60*60*24)
                             %>
                            <% if(diffDays <= 7){ %>
                            <span class="badge-new">New</span>
                            <% } %>
                            <%
                              const currentVariantId = product.variants?.[0]?.varientId || "";
                              const isWishlisted = wishListIds?.some(item =>
                                item.productId === product._id.toString() &&
                                item.variantId === currentVariantId
                              );
                            %>
                            <button class="fav-btn <%= isWishlisted ? "active" : "" %>" onclick="addToWishlist(event,'<%= product._id %>' , '<%= product.variants[0].varientId %>', <%= user ? 'true' : 'false' %>,this)">
                                <div class="h-4 w-4"><svg fill="currentColor" viewBox="0 0 24 24"><path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z"></path></svg></div>
                            </button>
                        </div>
                        <div style="flex: 1; display: flex; flex-direction: column;" class="product-content">
                            <span class="card-brand"><%= product.brand.toUpperCase() %></span>
                            <h3 class="card-title"><%= product.name %></h3>
                            <div class="rating-wrapper">
  <div class="stars">
    <% 
      const fullStars = Math.floor(product.avgRating);
      const emptyStars = 5 - fullStars;
    %>

    <% for(let i = 0; i < fullStars; i++) { %>
      <div class="h-3 w-3 text-yellow-400">
        <svg fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
        </svg>
      </div>
    <% } %>

    <% for(let i = 0; i < emptyStars; i++) { %>
      <div class="h-3 w-3 text-gray-300">
        <svg fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
        </svg>
      </div>
    <% } %>
  </div>

                                <span class="review-count">(<%= product.reviewCount %>)</span>
                            </div>
                            <div class="card-footer">
                                <% if (product.variants[0].offerPrice < product.variants[0].originalPrice) { %>
                                    <div>
                                    <span class="price">₹<%= product.variants[0].offerPrice %></span>
                                    <span class="original-price" style="text-decoration: line-through; color: #888; font-size: 0.9em; margin-left: 0.5rem;">₹<%= product.variants[0].originalPrice %></span>
                                    </div>
                                <% } else { %>
                                    <span class="price">₹<%= product.variants[0].offerPrice %></span>
                                <% } %>

                                <button class="add-btn <%= product.variants[0].stock < 1 ? 'out-stock-btn' : '' %>" onclick="addToCart(event,'<%= product._id %>', '<%= product.variants[0].varientId %>',<%= user ? 'true' : 'false' %>)" <%= product.variants[0].stock < 1 ? "disabled" : "" %>>
                                <% if(product.variants[0].stock < 1){ %>
                                    <span class="add-text">Out of Stock</span>
                                <% } else { %>
                                 <div class="h-4 w-4"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
                                 <span class="add-text">Add</span>
                                <% } %>   
                                </button>
                            </div>
                        </div>
                    </article>
                    <% }) %>
                    

                </div>
                </div>
                <div id="paginationContainer">
                        <% if (totalPages > 1) { %>
<nav class="pagination">
    <% if (currentPage > 1) { %>
        <button type="button" class="page-link page-link-nav" data-page="<%= currentPage - 1 %>">
            <div class="h-4 w-4">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                </svg>
            </div>
            Previous
        </button>
    <% } %>

    <% for (let i = 1; i <= totalPages; i++) { %>
        <button
          type="button"
          class="page-link <%= currentPage === i ? 'active' : '' %>"
          data-page="<%= i %>"
        >
          <%= i %>
    </button>
    <% } %>

    <% if (currentPage < totalPages) { %>
        <button type="button" class="page-link page-link-nav" data-page="<%= currentPage + 1 %>">
            Next
            <div class="h-4 w-4">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                </svg>
            </div>
        </button>
    <% } %>
</nav>
<% } %>
</div>
                </section>
            </div>
    </main>
    
    <%- include("../../partitials/user/footer.ejs") %>

    <div id="mobile-filter-drawer" class="drawer" aria-modal="true" role="dialog">
        <div class="drawer-backdrop" onclick="toggleDrawer('mobile-filter-drawer', false)"></div>
        <div class="drawer-content-right">
            <div class="drawer-header">
                <h2 class="drawer-title">Filters</h2>
                <button class="close-btn" onclick="toggleDrawer('mobile-filter-drawer', false)">
                    <div class="h-6 w-6"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
                </button>
            </div>
            <div class="drawer-body">
                <div style="margin-bottom: 2rem;">
                    <h3 style="font-size: 0.875rem; font-weight: 600; margin-bottom: 1rem; color: var(--slate-700);">Category</h3>
                    <div class="checkbox-group">
                        <% category.forEach((cat)=>{ %>
                            <label class="checkbox-label"><input type="checkbox" name="category" value="<%= cat._id %>" class="checkbox-input" <%= selectedCategory?.includes(String(cat._id)) ? "checked" : "" %>><%= cat.name %> </label>
                        <% }) %>
                    </div>
                </div>
                <hr class="divider">
                <div style="margin-bottom: 2rem;">
                    <h3 style="font-size: 0.875rem; font-weight: 600; margin-bottom: 1rem; color: var(--slate-700);">Brand</h3>
                    <div class="checkbox-group">
                        <% brands.forEach((brand)=>{ %>
                            <label class="checkbox-label"><input type="checkbox" name="brand" class="checkbox-input" value="<%= brand %>"
                                <%= Array.isArray(selectedBrands) && selectedBrands.includes(brand) ? "checked" : "" %> ><%= brand.toUpperCase() %></label>
                        <% }) %>
                    </div>
                </div>
                <hr class="divider">
                
                <div style="margin-bottom: 2rem;">
                    <h3 style="font-size: 0.875rem; font-weight: 600; margin-bottom: 1rem; color: var(--slate-700);">Price Range</h3><div class="double-range-wrapper">
        <div class="slider-track"></div>

        <input
            type="range"
            id="minRangeMobile"
            name="minPrice"
            min="0"
            max="50000"
            step="100"
            value="<%= minPrice !== '' && minPrice != null ? minPrice : defaultMin %>"
            class="range-input range-min"
        >

        <input
            type="range"
            id="maxRangeMobile"
            name="maxPrice"
            min="0"
            max="50000"
            step="100"
            value="<%= maxPrice !== '' && maxPrice != null ? maxPrice : defaultMax %>"
            class="range-input range-max"
        >
    </div>
                    <div class="price-labels">
                        <span id="minPriceLabelMobile">₹<%= minPrice !== '' && minPrice != null ? minPrice : defaultMin %></span>
                        <span id="maxPriceLabelMobile">₹<%= maxPrice !== '' && maxPrice != null ? maxPrice : defaultMax %></span>
                    </div>
                </div>
                <div style="margin-bottom: 2rem;">
                    <h3 style="font-size: 0.875rem; font-weight: 600; margin-bottom: 1rem; color: var(--slate-700);">Compatibility</h3>
                    <div class="checkbox-group">
                        <label class="checkbox-label"><input type="checkbox" class="checkbox-input"> Android</label>
                        <label class="checkbox-label"><input type="checkbox" class="checkbox-input"> iPhone</label>
                    </div>
                </div>
            </div>
            <div class="drawer-footer" style="display: flex; gap: 1rem;">
                <button class="btn-full-light" type="button" onclick="window.location.href='/products'" style="flex: 1; border: 1px solid var(--slate-300); border-radius: var(--radius-lg); font-weight: 600; color: var(--slate-700); background: var(--white);">Clear</button>
                <button class="btn-full" type="submit" form="filterForm" onclick="toggleDrawer('mobile-filter-drawer', false)" style="flex: 1;">Apply</button>
            </div>
        </div>
    </div>

    <div id="mobile-sort-drawer" class="drawer" aria-modal="true" role="dialog">
        <div class="drawer-backdrop" onclick="toggleDrawer('mobile-sort-drawer', false)"></div>
        <div class="drawer-content-bottom">
            <div class="drawer-header">
                <h2 class="drawer-title">Sort By</h2>
                <button class="close-btn" onclick="toggleDrawer('mobile-sort-drawer', false)">
                    <div class="h-6 w-6"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
                </button>
            </div>
            <div class="drawer-body" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
                <button class="sort-option <%= !selectedSort ? 'active' : '' %>" data-sort="" style="display: flex; justify-content: space-between; width: 100%; align-items: center;" type="button" onclick="applySort('')">
                    Default
                    <% if (!selectedSort) { %>
                    <div class="h-5 w-5 checkmark-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
                    <% } %>
                </button>
                <button class="sort-option <%= selectedSort === 'newest' ? 'active' : '' %>" data-sort="newest" style="display: flex; justify-content: space-between; width: 100%; align-items: center;" type="button" onclick="applySort('newest')">
                    Newest
                    <% if (selectedSort === 'newest') { %>
                    <div class="h-5 w-5 checkmark-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
                    <% } %>
                </button>
                <button class="sort-option <%= selectedSort === 'priceLowToHigh' ? 'active' : '' %>" data-sort="priceLowToHigh" style="display: flex; justify-content: space-between; width: 100%; align-items: center;" type="button" onclick="applySort('priceLowToHigh')" >
                    Price: Low to High
                    <% if (selectedSort === 'priceLowToHigh') { %>
                    <div class="h-5 w-5 checkmark-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
                    <% } %>
                </button>
                <button class="sort-option <%= selectedSort === 'priceHighToLow' ? 'active' : '' %>" data-sort="priceHighToLow" style="display: flex; justify-content: space-between; width: 100%; align-items: center;" type="button" onclick="applySort('priceHighToLow')">
                    Price: High to Low
                    <% if (selectedSort === 'priceHighToLow') { %>
                    <div class="h-5 w-5 checkmark-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
                    <% } %>
                </button>
                <button class="sort-option <%= selectedSort === 'nameAZ' ? 'active' : '' %>" data-sort="nameAZ" style="display: flex; justify-content: space-between; width: 100%; align-items: center;" type="button" onclick="applySort('nameAZ')">
                     Name: A to Z
                     <% if (selectedSort === 'nameAZ') { %>
                     <div class="h-5 w-5 checkmark-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></div>
                     <% } %>
                </button>
            </div>
            <div class="drawer-footer" style="padding-bottom: 2.5rem;">
                <button class="btn-full-light" onclick="toggleDrawer('mobile-sort-drawer', false)">Cancel</button>
            </div>
        </div>
    </div>

    
</body>
</html>