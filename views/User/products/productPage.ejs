    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Techora - Mobile Accessories</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/user/products/productPage.css">
</head>
<body>

    <%- include("../../partitials/user/header.ejs",{tittle : "Techora | Products" , name , email}) %>

    <main class="container" style="padding-top: 2rem; padding-bottom: 2rem;">
        <div class="main-layout">
            
            <aside class="sidebar">
                <div class="filter-card">
                    <div class="filter-header">
                        <h2 class="filter-title">Filters</h2>
                        <button class="clear-btn">Clear All</button>
                    </div>
                    
                    <div class="filter-section">
                        <h3>Category</h3>
                        <div class="checkbox-group">
                            <label class="checkbox-label"><input type="checkbox" class="checkbox-input"> Charging & Power</label>
                            <label class="checkbox-label"><input type="checkbox" class="checkbox-input"> Audio Accessories</label>
                            <label class="checkbox-label"><input type="checkbox" class="checkbox-input"> Protection Accessories</label>
                            <label class="checkbox-label"><input type="checkbox" class="checkbox-input"> Mounts & Stands</label>
                        </div>
                    </div>
                    
                    <hr class="divider">
                    
                    <div class="filter-section">
                        <h3>Brand</h3>
                        <div class="checkbox-group">
                            <label class="checkbox-label"><input type="checkbox" class="checkbox-input"> Apple</label>
                            <label class="checkbox-label"><input type="checkbox" class="checkbox-input"> Samsung</label>
                            <label class="checkbox-label"><input type="checkbox" class="checkbox-input"> Google</label>
                            <label class="checkbox-label"><input type="checkbox" class="checkbox-input"> Sony</label>
                            <label class="checkbox-label"><input type="checkbox" class="checkbox-input"> Bose</label>
                            <label class="checkbox-label"><input type="checkbox" class="checkbox-input"> Noise</label>
                        </div>
                    </div>

                    <hr class="divider">

                    <div class="filter-section">
                        <h3>Price Range</h3>
                        <div style="padding: 0 0.5rem;">
                            <input type="range" min="0" max="500" value="400" class="range-slider">
                            <div class="price-labels">
                                <span>$0</span>
                                <span>$500+</span>
                            </div>
                        </div>
                    </div>

                    <hr class="divider">

                    <div class="filter-section">
                        <h3>Compatibility</h3>
                        <div class="checkbox-group">
                            <label class="checkbox-label"><input type="checkbox" class="checkbox-input"> Android</label>
                            <label class="checkbox-label"><input type="checkbox" class="checkbox-input"> iPhone</label>
                        </div>
                    </div>
                </div>
            </aside>
            <section class="content-area">
                <div class="page-header">
                    <div>
                        <h1 class="page-title">Mobile Accessories</h1>
                        <p class="page-subtitle">Showing 48 products</p>
                    </div>
                    <div class="sort-wrapper">
                        <span class="page-subtitle">Sort by:</span>
                        <select class="sort-select">
                            <option>Relevance</option>
                            <option>Newest</option>
                            <option>Price: Low to High</option>
                            <option>Price: High to Low</option>
                        </select>
                    </div>
                </div>

                <div class="mobile-actions">
                    <button class="mobile-btn" onclick="toggleDrawer('mobile-filter-drawer', true)">
