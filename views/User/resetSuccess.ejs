<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Change Confirmation</title>
    <link rel="stylesheet" href="/styles/user/resetSuccess.css">
</head>
<body>
    

    <main class="container">
        <div class="card">
            <div class="icon-container">
                <div class="circle">
                    <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                        <circle class="checkmark__circle" cx="26" cy="26" r="25" fill="none"/>
                        <path class="checkmark__check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
                    </svg>
                </div>
            </div>

            <h1 class="title">Password Changed Successfully</h1>
            
            <p class="description">
                Your password has been updated. You can now log in using your new password.
            </p>

            <button id="loginBtn" class="primary-button">Go to Login</button>
        </div>

        <footer class="support-footer">
            Need help? <a href="#">Contact our support team</a>
        </footer>
    </main>

    <script >
      document.addEventListener('DOMContentLoaded', () => {
    const loginBtn = document.getElementById('loginBtn');

    loginBtn.addEventListener('click', () => {
        window.location.href = '/login'; 
    });
});
    </script>
</body>
</html>