const stars = document.querySelectorAll("#starRating .star");
const ratingInput = document.getElementById("ratingValue");

stars.forEach(star => {
  star.addEventListener("click", () => {
    const value = star.getAttribute("data-val");

    // store value
    ratingInput.value = value;

    // update UI
    stars.forEach(s => {
      if (s.getAttribute("data-val") <= value) {
        s.classList.add("active");
      } else {
        s.classList.remove("active");
      }
    });
  });
});

stars.forEach(star => {
  star.addEventListener("mouseover", () => {
    const value = star.getAttribute("data-val");

    stars.forEach(s => {
      s.classList.toggle(
        "active",
        s.getAttribute("data-val") <= value
      );
    });
  });

  star.addEventListener("mouseout", () => {
    const current = ratingInput.value;

    stars.forEach(s => {
      s.classList.toggle(
        "active",
        s.getAttribute("data-val") <= current
      );
    });
  });
});
function validateReview() {
  const title = document.getElementById("reviewTitle").value.trim();
  const reviewDesc = document.getElementById("reviewDesc").value.trim();
  const ratingValue = document.getElementById("ratingValue").value;
  const itemId = document.getElementById("itemId").value;

  // Title validation
  if (!title) {
    showToast("Title is required","error");
    return false;
  }

  if (title.length < 3) {
    showToast("Title must be at least 3 characters","error");
    return false;
  }

  // Description validation
  if (!reviewDesc) {
    showToast("Review description is required","error");
    return false;
  }

  if (reviewDesc.length < 10) {
    showToast("Review must be at least 10 characters","error");
    return false;
  }

  // Rating validation
  if (!ratingValue) {
    showToast("Please select a rating","error");
    return false;
  }

  if (ratingValue < 1 || ratingValue > 5) {
    showToast("Invalid rating value","error");
    return false;
  }

  // ItemId validation
  if (!itemId) {
    showToast("Invalid item","error");
    return false;
  }

  return true;
}

document.getElementById("submitBtn").addEventListener("click", async ()=>{
    const tittle = document.getElementById("reviewTitle").value
    const reviewDesc = document.getElementById("reviewDesc").value
    const ratingValue = document.getElementById("ratingValue").value
    const itemId = document.getElementById("itemId").value

    try {
        const validated = validateReview()
        if(!validated) return
        const res = await axios.post(`/orders/${itemId}/review`,{
            tittle,
            reviewDesc,
            ratingValue,
        })
            showToast(res.data.message || "Review submited successfully")
            setTimeout(()=>{
            window.location.href='/orders'
        },800)
    } catch (error) {
        showToast(error.response.data?.message || "Failed to submit","error")
        console.log(error)
    }
})
</script>

</body>
</html>