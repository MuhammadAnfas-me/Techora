<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Write a Review – Techora</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      background: #f4f5f7;
      color: #222;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ===== HEADER PARTIAL ===== */
    

    /* ===== MAIN CONTENT ===== */
    main {
      flex: 1;
      display: flex;
      justify-content: center;
      padding: 36px 16px 48px;
    }
    .review-container {
      width: 100%;
      max-width: 640px;
    }
    .page-title {
      font-size: 22px;
      font-weight: 700;
      color: #1a2233;
      margin-bottom: 4px;
    }
    .page-subtitle {
      font-size: 13px;
      color: #888;
      margin-bottom: 18px;
    }
    .order-meta {
      font-size: 12px;
      color: #999;
      text-align: right;
      margin-bottom: 6px;
    }

    /* Product card */
    .product-card {
      background: #fff;
      border-radius: 10px;
      border: 1px solid #e8eaf0;
      padding: 18px 20px;
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 18px;
    }
    .product-img {
      width: 60px;
      height: 60px;
      background: #e9edf3;
      border-radius: 7px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      overflow: hidden;
    }
    .product-img svg { width: 28px; height: 28px; fill: #b0bac8; }
    .product-img img { width: 100%; height: 100%; object-fit: cover; }
    .product-info { flex: 1; }
    .product-name {
      font-size: 14px;
      font-weight: 600;
      color: #1a2233;
      margin-bottom: 4px;
    }
    .product-seller {
      font-size: 12px;
      color: #888;
      margin-bottom: 5px;
    }
    .product-attrs {
      display: flex;
      gap: 14px;
      font-size: 12px;
      color: #555;
      margin-bottom: 5px;
    }
    .product-delivered {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 12px;
      color: #38a169;
    }
    .product-delivered svg { width: 14px; height: 14px; fill: #38a169; }
    .product-price {
      font-size: 15px;
      font-weight: 700;
      color: #1a2233;
      align-self: flex-start;
      margin-left: auto;
      padding-left: 12px;
    }

    /* Review form card */
    .review-card {
      background: #fff;
      border-radius: 10px;
      border: 1px solid #e8eaf0;
      padding: 24px 24px 20px;
    }
    .form-section-title {
      font-size: 15px;
      font-weight: 700;
      color: #1a2233;
      margin-bottom: 2px;
    }
    .form-section-sub {
      font-size: 12px;
      color: #888;
      margin-bottom: 18px;
    }
    .form-group { margin-bottom: 18px; }
    .form-label {
      font-size: 13px;
      font-weight: 600;
      color: #333;
      margin-bottom: 7px;
      display: block;
    }
    .form-label .required { color: #e53e3e; margin-left: 2px; }

    /* Star rating */
    .star-rating {
      display: flex;
      gap: 4px;
      margin-top: 2px;
    }
    .star-rating .star {
      font-size: 26px;
      cursor: pointer;
      color: #ccc;
      line-height: 1;
      transition: color 0.1s;
    }
    .star-rating .star.active { color: gold; }
    .star-rating .star.empty { color: #c8cfd8; }

    /* Text inputs */
    .form-input {
      width: 100%;
      border: 1px solid #d0d6e0;
      border-radius: 6px;
      padding: 9px 13px;
      font-size: 13.5px;
      color: #666;
      background: #fff;
      outline: none;
      transition: border-color 0.15s;
      font-family: inherit;
    }
    .form-input::placeholder { color: #b0b8c5; }
    .form-input:focus { border-color: #4a7fc1; }
    textarea.form-input {
      resize: vertical;
      min-height: 110px;
    }
    .char-hint {
      text-align: right;
      font-size: 11.5px;
      color: #aaa;
      margin-top: 4px;
    }

    /* Photo upload */
    .upload-label {
      font-size: 13px;
      font-weight: 600;
      color: #333;
      display: block;
      margin-bottom: 9px;
    }
    .upload-zone {
      border: 1.5px dashed #c8d0de;
      border-radius: 8px;
      background: #f8f9fb;
      padding: 24px 16px;
      text-align: center;
      cursor: pointer;
      transition: border-color 0.15s;
    }
    .upload-zone:hover { border-color: #4a7fc1; }
    .upload-icon {
      width: 36px;
      height: 36px;
      margin: 0 auto 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .upload-icon svg { width: 36px; height: 36px; fill: none; stroke: #7a8fa8; stroke-width: 1.7; }
    .upload-text {
      font-size: 13px;
      color: #555;
      margin-bottom: 3px;
    }
    .upload-formats {
      font-size: 11px;
      color: #aaa;
      margin-bottom: 10px;
    }
    .upload-btn {
      display: inline-block;
      border: 1px solid #c8d0de;
      border-radius: 5px;
      padding: 6px 18px;
      font-size: 13px;
      color: #333;
      background: #fff;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.12s;
    }
    .upload-btn:hover { background: #f0f2f5; }

    /* Preview thumbnails */
    .photo-previews {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 12px;
    }
    .photo-thumb {
      width: 60px;
      height: 60px;
      border-radius: 7px;
      object-fit: cover;
      border: 1.5px solid #e0e6ef;
    }
    /* The headphone image shown in screenshot */
    .photo-thumb-placeholder {
      width: 60px;
      height: 60px;
      border-radius: 7px;
      background: #f5c518;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1.5px solid #e0c060;
    }
    .photo-thumb-placeholder svg { width: 32px; height: 32px; fill: #222; }

    /* Form actions */
    .form-actions {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      margin-top: 22px;
    }
    .btn-cancel {
      padding: 9px 24px;
      border-radius: 6px;
      border: none;
      background: transparent;
      color: #555;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.12s;
    }
    .btn-cancel:hover { background: #f0f2f5; }
    .btn-submit {
      padding: 9px 26px;
      border-radius: 6px;
      border: none;
      background: #1a2233;
      color: #fff;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.15s;
    }
    .btn-submit:hover { background: #25304a; }

    /* ===== FOOTER PARTIAL ===== */
    footer {
      background: #1a2233;
      color: #c8d0de;
      padding: 36px 40px 18px;
    }
    .footer-top {
      display: flex;
      gap: 48px;
      margin-bottom: 28px;
    }
    .footer-brand {
      min-width: 170px;
    }
    .footer-logo {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #fff;
      font-weight: 700;
      font-size: 16px;
      margin-bottom: 10px;
    }
    .footer-logo .logo-icon {
      background: #fff;
      color: #1a2233;
      border-radius: 5px;
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      font-size: 13px;
    }
    .footer-brand p {
      font-size: 12px;
      color: #8a9ab8;
      line-height: 1.6;
      max-width: 160px;
      margin-bottom: 14px;
    }
    .footer-socials {
      display: flex;
      gap: 10px;
    }
    .footer-social-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #3a4a62;
    }
    .footer-cols {
      display: flex;
      gap: 48px;
      flex: 1;
    }
    .footer-col h4 {
      font-size: 13px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 14px;
    }
    .footer-col a {
      display: block;
      font-size: 12.5px;
      color: #8a9ab8;
      text-decoration: none;
      margin-bottom: 8px;
      transition: color 0.12s;
    }
    .footer-col a:hover { color: #c8d0de; }
    .footer-newsletter h4 {
      font-size: 13px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 8px;
    }
    .footer-newsletter p {
      font-size: 12px;
      color: #8a9ab8;
      margin-bottom: 12px;
      max-width: 200px;
      line-height: 1.5;
    }
    .newsletter-form {
      display: flex;
      gap: 0;
    }
    .newsletter-input {
      flex: 1;
      background: #29374f;
      border: 1px solid #3a4a62;
      border-right: none;
      border-radius: 5px 0 0 5px;
      padding: 8px 12px;
      font-size: 12.5px;
      color: #c8d0de;
      outline: none;
      font-family: inherit;
    }
    .newsletter-input::placeholder { color: #5a6a82; }
    .newsletter-btn {
      background: #3a4a62;
      border: 1px solid #3a4a62;
      border-radius: 0 5px 5px 0;
      padding: 8px 13px;
      color: #c8d0de;
      cursor: pointer;
      display: flex;
      align-items: center;
      font-size: 15px;
    }
    .newsletter-btn:hover { background: #4a5a72; }
    .footer-bottom {
      border-top: 1px solid #263348;
      padding-top: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .footer-bottom span {
      font-size: 11.5px;
      color: #5a6a82;
    }
    .footer-bottom-links {
      display: flex;
      gap: 18px;
    }
    .footer-bottom-links a {
      font-size: 11.5px;
      color: #5a6a82;
      text-decoration: none;
    }
    .footer-bottom-links a:hover { color: #8a9ab8; }
  </style>
</head>
<body>

<!-- ===== HEADER PARTIAL ===== -->
<%- include('../../partitials/user/header.ejs',{tittle : "Techora | Review"}) %>

<!-- ===== MAIN CONTENT ===== -->
<main>
  <div class="review-container">
    <h1 class="page-title">Write a Review</h1>
    <p class="page-subtitle">Share your experience with this product</p>
    <div class="order-meta">Order #692301 &nbsp;·&nbsp; Placed on <%= formatDate(placed) %></div>

    <!-- Product Card -->
    <div class="product-card">
      <div class="product-img">
        <% if (item.image) { %>
          <img src="<%= item.image %>" alt="<%= item.name %>">
        <% } else { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <polyline points="21 15 16 10 5 21" />
          </svg>
        <% } %>
      </div>
      <div class="product-info">
        <div class="product-name"><%= item.name %></div>
        <div class="product-attrs">
          <span>Color: <%= item.color %></span>
          <span>Qty: <%= item.quantity %></span>
        </div>
        <div class="product-delivered">
          <svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
          Delivered on <%= formatDate(delivered) %>
        </div>
      </div>
      <div class="product-price"><%= formatINR(item.price) %></div>
    </div>

    <!-- Review Form -->
    <div class="review-card">
      <div class="form-section-title">Your Review</div>
      <div class="form-section-sub">Tell us what you liked or disliked about this product.</div>

      <!-- Star Rating -->
      <div class="form-group">
        <label class="form-label">Overall Rating <span class="required">*</span></label>
        <input type="hidden" name="rating" id="ratingValue">
        <input type="hidden" value="<%= itemId %>" name="id" id="itemId">

        <div class="star-rating" id="starRating">
          <span class="star " data-val="1">★</span>
          <span class="star " data-val="2">★</span>
          <span class="star " data-val="3">★</span>
          <span class="star " data-val="4">★</span>
          <span class="star " data-val="5">★</span>
        </div>
      </div>

      <!-- Review Title -->
      <div class="form-group">
        <label class="form-label" for="reviewTitle">Review Title <span class="required">*</span></label>
        <input id="reviewTitle" class="form-input" type="text" placeholder="Summarize your experience (e.g., Great sound, but a bit heavy)">
      </div>

      <!-- Review Description -->
      <div class="form-group">
        <label class="form-label" for="reviewDesc">Review Description <span class="required">*</span></label>
        <textarea id="reviewDesc" class="form-input" placeholder="Write your detailed review here. What did you like or dislike? How is the quality?"></textarea>
        <div class="char-hint">Minimum 20 characters</div>
      </div>

      <!-- Add Photos -->


      <!-- Actions -->
      <div class="form-actions">
        <button class="btn-cancel" type="button" onclick="history.back()">Cancel</button>
        <button class="btn-submit" id="submitBtn" type="button">Submit Review</button>
      </div>
    </div>

  </div>
</main>

<%- include('../../partitials/user/footer.ejs') %>

