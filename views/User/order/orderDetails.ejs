<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">


<%- include("../../partitials/user/header.ejs",{tittle : "Techora | Order"}) %>
<link rel="stylesheet" href="/styles/user/orders/orderDetails.css">

<div class="order-container">
    <a href="/orders" class="back-link">
            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
            Back to Orders
          </a>
    <div class="order-top-bar">
        <div class="order-title">
            <h2>Order <%= order.orderId %></h2>
            <div class="order-date"><i class="far fa-calendar"></i> Placed on 
                <%= new Date(order.createdAt).toLocaleString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                    hour: "numeric",
                    minute: "2-digit",
                    hour12: true
                }) %>
            </div>
        </div>
        <div class="top-btns">
            <button class="btn-help" onclick="window.location.href='/orders/<%= order.orderId %>/invoice'"><i class="fas fa-file-invoice"></i>  Download Invoice</button>
        </div>
    </div>

    <div class="main-layout">
        <div class="column-left">
            
            <div class="card">
                <div class="status-header">
                    <div style="font-weight: 700; font-size: 14px;"><i class="fas fa-truck"></i> Order Status</div>
                    <span class="status-badge <%= order.orderStatus.toLowerCase() %>">
                      <%= statusText %>
                    </span>
                </div>
                <% const estDelivery = new Date(order.createdAt); estDelivery.setDate(estDelivery.getDate() + 7); %>
                <div class="delivery-text">Estimated Delivery: <strong><%= estDelivery.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %></strong></div>
                
                <div class="timeline">
                    <div class="step active">
                        <div class="step-icon"><i class="fas fa-shopping-bag"></i></div>
                        <div class="step-label">Order Placed</div>
                        <div class="step-time">
                            <%= formatDate(order.createdAt) %>
                         </div>
                    </div>
                    <div class="step <%= order.timeline.confirmedAt ? 'active' : 'pending' %>">
                        <div class="step-icon"><i class="fas fa-clipboard-check"></i></div>
                        <div class="step-label">Confirmed</div>
                        <div class="step-time"><%= order.timeline.confirmedAt 
                            ? formatDate(order.timeline.confirmedAt) 
                            : '--' %>
                        </div>
                    </div>
                    <div class="step <%= order.timeline.shippedAt ? 'active' : 'pending' %>">
                        <div class="step-icon"><i class="fas fa-box"></i></div>
                        <div class="step-label">Shipped</div>
                        <div class="step-time">
                            <%= order.timeline.shippedAt 
                                ? formatDate(order.timeline.shippedAt) 
                                : '--' 
                            %>
                        </div>
                    </div>
                    <% if(order.orderStatus === "Cancelled"){ %>
                        <div class="step active">
                        <div class="step-icon"><i class="fas fa-house"></i></div>
                        <div class="step-label" style="color: #94a3b8;">Cancelled</div>
                        <div class="step-time">
                            <%= order.timeline.cancelledAt 
                                ? formatDate(order.timeline.cancelledAt) 
                                : 'Expected soon' 
                            %>
                        </div>
                    </div>
                    <% }else{ %>
                    <div class="step <%= order.timeline.deliveredAt ? 'active' : 'pending' %>">
                        <div class="step-icon"><i class="fas fa-house"></i></div>
                        <div class="step-label" style="color: #94a3b8;">Delivered</div>
                        <div class="step-time">
                            <%= order.timeline.deliveredAt 
                                ? formatDate(order.timeline.deliveredAt) 
                                : 'Expected soon' 
                            %>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>

            <div class="card">
                <div class="items-title">Items in Your Order</div>
                <% order.items.forEach(item=>{ %>
                <div class="product-row">
                    <img src="<%= item.image %>" class="product-img">
                    <div class="product-info">
                        <div class="prod-header">

                            <div class="prod-name">
                                <%= item.name %>
                                <div style="font-size: 11px; color: #64748b; margin-top: 4px; font-weight: 400;">
                                    Brand: <strong><%= item.brand.toUpperCase() %></strong> • Unit Price: <%= formatINR(item.price) %>
                                </div>
                            </div>

                            <div class="prod-right">
                            <% if(item.status === "Delivered"){ %>
                            <span class="item-status delivered">Delivered</span>
                            <% }else if(["Cancelled","Return Rejected"].includes(item.status)){ %>
                                <span class="item-status cancelled"><%= item.status %></span>
                            <% }else if(item.status === "Confirmed"){ %>
                                <span class="item-status confirmed">Confirmed</span>
                            <% }else if(["Shipped","Return Approved"].includes(item.status)){ %>
                                <span class="item-status shipped"><%= item.status %></span>
                            <% }else if(item.status === "Return Requested"){ %>
                               <span class="item-status placed">Return Requested</span>
                            <% }else if(item.status === "Returned"){ %>
                               <span class="item-status delivered">Returned</span>
                            <% } %>
                            <div class="prod-price">
                                <span class="curr-price"><%= formatINR(item.finalTotal || item.total) %></span>
                                <% if (item.discount > 0) { %>
                                    <span style="font-size: 11px; color: #94a3b8; text-decoration: line-through; display: block; margin-top: 2px; font-weight: 500;">
                                        <%= formatINR(item.total) %>
                                    </span>
                                    <span style="font-size: 10px; color: #16a34a; font-weight: 600; display: block; margin-top: 2px;">
                                        Coupon Saved: <%= formatINR(item.discount) %>
                                    </span>
                                <% } %>
                            </div>
                        </div>
                        </div>
                        <div class="prod-meta">
                            <span class="meta-tag"><i class="fas fa-palette" style="font-size: 10px; margin-right: 4px;"></i> Color: <%= item.color %></span>
                            <span class="meta-tag"><i class="fas fa-layer-group" style="font-size: 10px; margin-right: 4px;"></i> Qty: <%= item.quantity %></span>
                        </div>
                        <div class="prod-actions">
                            <% if(item.status === "Delivered"){ %>
                                <button class="btn-sm" onclick="window.location.href='/orders/<%= item._id %>/review  '">Write Review</button>
                            <button class="btn-sm return-btn" onclick="returnItem('<%= order.orderId %>', '<%= item._id %>')">Return Item</button>
                            <% }else if(!["Delivered","Shipped","Cancelled","Return Requested","Return Rejected","Return Approved","Returned"].includes(item.status)){ %>
                            <button class="btn-sm cancel-btn" <%= order.orderStatus === "Cancelled" ? "hidden" : "" %> onclick="cancelItem('<%= order.orderId %>' , '<%= item._id %>')">Cancel Item</button>
                            <% } %>
                             

                        </div>
                    </div>
                </div>
                <% }) %>
            </div>

            <div class="card">
                <div class="items-title">Payment Summary</div>
                
                <% 
                    let totalRefund = 0;
                    let hasRefund = false;
                    let refundStatus = "";
                    
                    order.items.forEach(item => {
                        if (["Cancelled", "Returned", "Return Approved"].includes(item.status)) {
                            totalRefund += (item.finalTotal || item.total);
                            hasRefund = true;
                            if (item.refunds === "refunded") {
                                refundStatus = "Refund Completed";
                            } else if (!refundStatus) {
                                refundStatus = "Refund Initiated";
                            }
                        }
                    });
                    
                    const effectivePaid = order.totalAmount - totalRefund;
                %>

                <div class="summary-row">
                    <span class="summary-label">Subtotal (<%= order.items.length %> items)</span>
                    <span><%= formatINR(order.subtotal) %></span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Shipping Fee</span>
                    <span style="color: var(--success);">Free</span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Discount (<%= order.coupon?.code ? order.coupon?.code : "-" %>)</span>
                    <span style="color: var(--success);"><%= order.coupon?.discount ? formatINR(order.coupon?.discount) : '-₹00.00' %>  </span>
                </div>
                <div class="summary-row total-row">
                    <span>Order Total</span>
                    <span><%= formatINR(order.totalAmount) %></span>
                </div>

                <% if(hasRefund) { %>
                    <div class="adjustment-section">
                        <span class="adjustment-title">Adjustments</span>
                        <div class="summary-row">
                            <span class="summary-label">Cancelled Items Refund</span>
                            <span class="refund-text">-<%= formatINR(totalRefund) %></span>
                        </div>
                    </div>
                <% } %>

                <div class="summary-row effective-row">
                    <span>Effective Paid Amount</span>
                    <span><%= formatINR(effectivePaid) %></span>
                </div>

                <% if(order.paymentStatus === "Paid" || hasRefund){ %>
                <div class="payment-status">
                    <div class="visa-info">
                        <% if(order.paymentMethod === "RAZORPAY"){ %>
                            <i class="fab fa-cc-visa" style="color: #1a1f71; font-size: 20px;"></i>
                            Paid through <strong>Razorpay</strong>
                        <% }else if(order.paymentMethod === "COD"){ %>
                            <i class="fas fa-money-bill-1" style="color: #16a34a; font-size: 20px;"></i>
                            Paid on <strong>COD</strong>
                        <% }else{ %>
                            <i class="fas fa-wallet" style="color: #475569; font-size: 20px;"></i>
                            Paid using <strong>Wallet</strong>
                        <% } %>
                    </div>
                    <div style="display: flex; gap: 8px;">
                        <% if(order.paymentStatus === "Paid") { %>
                            <span class="paid-badge">Paid</span>
                        <% } %>
                        <% if(hasRefund && refundStatus) { %>
                            <span class="refund-badge"><%= refundStatus %></span>
                        <% } %>
                    </div>
                </div>
                <% } %>
            </div>
        </div>

        <div class="column-right">
            
            <div class="card">
                <span class="side-title">Order Information</span>
                <div class="side-item">
                    <i class="fas fa-hashtag side-icon"></i>
                    <div class="side-content">
                        <label>Order ID</label>
                        <strong><%= order.orderId %></strong>
                    </div>
                </div>
                <div class="side-item">
                    <i class="far fa-calendar side-icon"></i>
                    <div class="side-content">
                        <label>Order Date</label>
                        <strong>
                            <%= new Date(order.createdAt).toLocaleString("en-US", {
                                year: "numeric",
                                month: "long",
                                day: "numeric"
                            }) %>
                        </strong>
                    </div>
                </div>
                <div class="side-item">
                    <i class="fas fa-credit-card side-icon"></i>
                    <div class="side-content">
                        <label>Payment Method</label>
                        <strong><%= order.paymentMethod === 'RAZORPAY' ? 'Razorpay (Online)' : (order.paymentMethod === 'COD' ? 'Cash on Delivery' : 'Wallet') %></strong>
                    </div>
                </div>
                <div class="side-item">
                    <i class="far fa-envelope side-icon"></i>
                    <div class="side-content">
                        <label>Confirmation Sent To</label>
                        <strong><%= user.email ? user.email : "" %></strong>
                    </div>
                </div>
            </div>

            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <span class="side-title">Shipping Details</span>
                    <i class="far fa-edit" style="font-size: 12px; color: var(--text-muted); cursor: pointer;"></i>
                </div>
                <div class="side-item">
                    <i class="far fa-user side-icon"></i>
                    <div class="side-content">
                        <strong><%= order.address.name %></strong>
                        <div class="address-text">
                            <%= order.address.addressLine1 %><br>
                            <%= order.address.addreesLine2 %><br>
                            <%= order.address.state %>
                        </div>
                    </div>
                </div>
                <div class="side-item">
                    <i class="fas fa-phone side-icon"></i>
                    <div class="side-content">
                        <strong>+91 <%= order.address.phone %></strong>
                    </div>
                </div>
     
            </div>

            <div class="card" style="background: #f8fafc;">
                <% if(["Shipped", "Placed", "Confirmed"].includes(order.orderStatus) ){ %>
                    <span class="side-title">Actions</span>
                <% } %>
                    
                    <% const delivered = order.items.every(item => item.status === "Delivered") %>
                    <% const capable = order.items.every(item => item.status === "Placed" || item.status === "Confirmed") %>
                    <% if([ "Placed", "Confirmed"].includes(order.orderStatus)){ %>
                        <button class="action-btn btn-cancel" onclick="cancelOrder('<%= order.orderId %>')" <%= allCancelled ? "Disabled" : ""  %>><i class="fas fa-circle-xmark"></i>Cancel Order</button>
                    <% }else if(order.orderStatus === "Delivered" ){%>
                        <button class="action-btn" onclick="returnOrder('<%= order.orderId %>')"><i class="fas fa-rotate-left" ></i> Return Items</button>
                    <% }else{ %>
                    <% } %>
                <div class="support-link">
                    Have a question about your order?<br>
                    <a href="#">Contact Customer Support</a>
                </div>
            </div>

        </div>
    </div>
</div>

</body>
</html>

<%- include("../../partitials/user/footer.ejs") %>
<script>
    async function cancelItem(orderId,itemId){
       showLoader()
       setTimeout(()=>{
          window.location.href = `/orders/${orderId}/cancel/${itemId}`;
          hideLoader()
       },500)
    }
    async function cancelOrder(orderId,itemId){
       showLoader()
       setTimeout(()=>{
          window.location.href = `/orders/${orderId}/cancel`;
          hideLoader()
       },500)
    }
    async function returnOrder(orderId){
       showLoader()
       setTimeout(()=>{
          window.location.href = `/orders/${orderId}/return`;
          hideLoader()
       },500)
    }
    async function returnItem(orderId,itemId){
       showLoader()
       setTimeout(()=>{
          window.location.href = `/orders/${orderId}/return/${itemId}`;
          hideLoader()
       },500)
    }



</script>