<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= tittle %>
    </title>
    <link rel="stylesheet" href="/styles/partitials/user/header.css">
    <link rel="stylesheet" href="/styles/partitials/user/footer.css">
    <script src="/js/partitials/User/user.js"></script>
    <link rel="stylesheet" href="/styles/user/popup.css">
    <script src="/js/popup.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>

<body>
<div id="loaderOverlay" class="loader-overlay">
  <div class="spinner"></div>
</div>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <div class="nav-content">

                <!-- LEFT: Logo -->
                <div class="nav-left">
                    <a href="/" class="logo">
                        <div class="logo-icon">
                            <span class="material-symbols-outlined">dataset</span>
                        </div>
                        <span class="logo-text">Techora</span>
                    </a>
                </div>

                <!-- CENTER: Nav Links -->
                <div class="nav-center">
                    <div class="nav-links">
                        <a href="/" class="nav-link active">Home</a>
                        <div class="nav-link dropdown">
                            <span>Categories</span>
                            <span class="material-symbols-outlined">expand_more</span>
                            <div class="categories-dropdown dropdown-menu">
                                <div class="dropdown-grid">
                                    <div class="dropdown-column">
                                        <h4>Audio Accessories</h4>
                                        <ul>
                                            <li><a href="/products?category=69a9b338e3f99130d71b888b&minPrice=0&maxPrice=50000&page=1&sort=&search=">TWS</a></li>
                                            <li><a href="/products?category=69a9b36be3f99130d71b8895&minPrice=0&maxPrice=50000&page=1&sort=&search=">Neckbands</a></li>
                                            <li><a href="/products?category=69a9b387e3f99130d71b889a&minPrice=0&maxPrice=50000&page=1&sort=&search=">Wired Headphones</a></li>
                                            <li><a href="/products?category=69a9b3a1e3f99130d71b889f&minPrice=0&maxPrice=50000&page=1&sort=&search=">Wireless Headphones</a></li>
                                            <li><a href="/products?category=69a9b34de3f99130d71b8890&minPrice=0&maxPrice=50000&page=1&sort=&search=">Gaming Headsets</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <a href="/products" class="nav-link">Store</a>
                        <a href="/contact" class="nav-link">Contact</a>
                    </div>
                </div>

                <!-- RIGHT: Icons -->
                <div class="nav-right">
                    <% if(user){ %>
                    <div class="nav-icons">
                        <button class="icon-btn wish-btn" id="favBtn" onclick="openWishlist()">
                            <span class="material-symbols-outlined">favorite</span>
                            <span class="badgeCount" id="wishCount" ><%= wishCount ? wishCount : 0 %></span>
                        </button>
                        <button class="icon-btn cart-btn" onclick="openCart()">
                            <span class="material-symbols-outlined">shopping_cart</span>
                            <span class="badgeCount" id="cartCount" ><%= cartCount ? cartCount : 0 %></span>
                        </button>
                        <div class="profile-wrapper">
                            <button class="avatar">
                                <img src="<%= user.profileImage ? user.profileImage : "" %>" alt="Avatar">
                            </button>
                            <div class="profile-dropdown dropdown-menu">
                                <div class="profile-header">
                                    <img src="<%= user.profileImage ? user.profileImage :" " %>" alt="User">
                                    <div>
                                        <h5><%= user.fullName ? user.fullName : ""%></h5>
                                        <p class="user-email"><%= user.email ? user.email : "" %></p>
                                    </div>
                                </div>
                                <ul>
                                    <li>
                                        <a href="/profile">
                                            <span class="material-symbols-outlined">person</span>
                                            Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a href="/logout">
                                            <span class="material-symbols-outlined">logout</span>
                                            Logout
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <% }else { %>
                        <div class="nav-actions">
  <a href="/login" class="nav-auth-btn" id="loginBtn">Login</a>
  <a href="/signup" class="nav-auth-btn">Signup</a>
</div>
                    <% } %>
                </div>

            </div>
        </div>
    </nav>
    <!-- <div id="toast" class="toast"></div> -->
<div class="toast toast-banner" id="toast">
    <div class="tb-icon" id="toastIcon"></div>
    <div class="tb-text">
        <div class="tb-title" id="toastTitle"></div>
        <div class="tb-sub"   id="toastSub"></div>
    </div>
    <div class="tb-close" onclick="removeToast()">&#10005;</div>
</div>