<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= tittle %>
    </title>
    <link rel="stylesheet" href="/styles/partitials/user/header.css">
    <link rel="stylesheet" href="/styles/partitials/user/footer.css">
    <link rel="stylesheet" href="/styles/user/popup.css">
    <script src="/js/partitials/User/user.js"></script>
    <script src="/js/popup.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
        rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>

<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <div class="nav-content">
                <div class="nav-left">
                    <a href="#" class="logo">
                        <div class="logo-icon">
                            <span class="material-symbols-outlined">dataset</span>
                        </div>
                        <span class="logo-text">Techora</span>
                    </a>
                    <div class="nav-links">
                        <a href="/" class="nav-link active">Home</a>
                        <div class="nav-link dropdown">
                            <span>Categories</span>
                            <span class="material-symbols-outlined">expand_more</span>
                            <div class="categories-dropdown dropdown-menu">
                                <div class="dropdown-grid">
                                    <div class="dropdown-column">
                                        <h4>Audio Accessories</h4>
                                        <ul>
                                            <li><a href="#">TWS</a></li>
                                            <li><a href="#">Neckbands</a></li>
                                            <li><a href="#">Speakers</a></li>
                                        </ul>
                                    </div>
                                    <div class="dropdown-column">
                                        <h4>Protection</h4>
                                        <ul>
                                            <li><a href="#">Cases</a></li>
                                            <li><a href="#">Screen Guards</a></li>
                                        </ul>
                                    </div>
                                    <div class="dropdown-column">
                                        <h4>Mounts & Stands</h4>
                                        <ul>
                                            <li><a href="#">Tripods</a></li>
                                            <li><a href="#">Car Mounts</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <a href="#" class="nav-link">Store</a>
                        <a href="#" class="nav-link">Contact</a>
                    </div>
                </div>
                <div class="nav-right">
                    <div class="search-box">
                        <input type="text" placeholder="Search products...">
                        <span class="material-symbols-outlined">search</span>
                    </div>
                    <div class="nav-icons">
                        <button class="icon-btn">
                            <span class="material-symbols-outlined">favorite</span>
                        </button>
                        <button class="icon-btn cart-btn">
                            <span class="material-symbols-outlined">shopping_cart</span>
                            <span class="badge">2</span>
                        </button>
                        <div class="profile-wrapper">
                            <button class="avatar">
                                <img src="<%= user.profileImage.url  %>"
                                    alt="Avatar">
                            </button>
                            <div class="profile-dropdown dropdown-menu">
                                <div class="profile-header">
                                    <img src="<%= user.profileImage.url %>"
                                        alt="User">
                                    <div>
                                        <h5>
                                            <%= user.fullName %>
                                        </h5>
                                        <p class="user-email">
                                            <%= user.email %>
                                        </p>
                                    </div>
                                </div>
                                <ul>
                                    <li>
                                        <a href="/profile">
                                            <span class="material-symbols-outlined">person</span>
                                            Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a href="/logout">
                                            <span class="material-symbols-outlined">logout</span>
                                            Logout
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <div id="toast" class="toast"></div>