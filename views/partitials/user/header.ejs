<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= tittle %>
    </title>
    <link rel="icon" href="https://res.cloudinary.com/dpbqsetq2/image/upload/v1779353242/site_favicon_1779348919224_ejgxyn.jpg" type="image/png">
    <link rel="stylesheet" href="/styles/partitials/user/header.css">
    <link rel="stylesheet" href="/styles/partitials/user/footer.css">
    <script src="/js/partitials/User/user.js"></script>
    <link rel="stylesheet" href="/styles/user/popup.css">
    <script src="/js/popup.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>

<body>
<div id="loaderOverlay" class="loader-overlay">
  <div class="spinner"></div>
</div>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <div class="nav-content">

                <!-- LEFT: Logo -->
                <div class="nav-left">
                    <a href="/" class="logo">
                        <div class="logo-icon">
                            <span class="material-symbols-outlined">dataset</span>
                        </div>
                        <span class="logo-text">Techora</span>
                    </a>
                </div>

                <!-- CENTER: Nav Links (desktop) -->
                <div class="nav-center">
                    <div class="nav-links">
                        <a href="/" class="nav-link active">Home</a>
                        <div class="nav-link dropdown">
                            <span>Categories</span>
                            <span class="material-symbols-outlined">expand_more</span>
                            <div class="categories-dropdown dropdown-menu">
                                <div class="dropdown-grid">
                                    <div class="dropdown-column">
                                        <h4>Audio Accessories</h4>
                                        <ul>
                                            <% categories.forEach(cat=>{ %>
                                                <li><a href="/products?category=<%= cat._id %>&minPrice=0&maxPrice=50000&page=1&sort=&search="><%= cat.name %></a></li>
                                            <% }) %>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <a href="/products" class="nav-link">Store</a>
                        <a href="/contact" class="nav-link">Contact</a>
                    </div>
                </div>

                <!-- RIGHT: Icons + Hamburger -->
                <div class="nav-right">
                    <% if(user){ %>
                    <div class="nav-icons">
                        <button class="icon-btn wish-btn" id="favBtn" onclick="openWishlist()">
                            <span class="material-symbols-outlined">favorite</span>
                            <span class="badgeCount" id="wishCount" ><%= wishCount ? wishCount : 0 %></span>
                        </button>
                        <button class="icon-btn cart-btn" onclick="openCart()">
                            <span class="material-symbols-outlined">shopping_cart</span>
                            <span class="badgeCount" id="cartCount" ><%= cartCount ? cartCount : 0 %></span>
                        </button>
                        <div class="profile-wrapper">
                            <button class="avatar">
                                <img src="<%= user.profileImage ? user.profileImage : "" %>" alt="Avatar">
                            </button>
                            <div class="profile-dropdown dropdown-menu">
                                <div class="profile-header">
                                    <img src="<%= user.profileImage ? user.profileImage:" " %>" alt="User">
                                    <div>
                                        <h5><%= user.fullName ? user.fullName : ""%></h5>
                                        <p class="user-email"><%= user.email ? user.email : "" %></p>
                                    </div>
                                </div>
                                <ul>
                                    <li>
                                        <a href="/profile">
                                            <span class="material-symbols-outlined">person</span>
                                            Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a href="/logout">
                                            <span class="material-symbols-outlined">logout</span>
                                            Logout
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <% }else { %>
                        <div class="nav-actions">
  <a href="/login" class="nav-auth-btn" id="loginBtn">Login</a>
  <a href="/signup" class="nav-auth-btn">Signup</a>
</div>
                    <% } %>

                    <!-- Hamburger Button (mobile only) -->
                    <button class="hamburger-btn" id="hamburgerBtn" aria-label="Open menu">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                </div>

            </div>
        </div>
    </nav>

    <!-- Mobile Drawer Overlay -->
    <div class="mobile-overlay" id="mobileOverlay"></div>

    <!-- Mobile Drawer -->
    <div class="mobile-drawer" id="mobileDrawer">
        <div class="drawer-header">
            <a href="/" class="logo">
                <div class="logo-icon">
                    <span class="material-symbols-outlined">dataset</span>
                </div>
                <span class="logo-text">Techora</span>
            </a>
            <button class="drawer-close" id="drawerClose" aria-label="Close menu">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <% if(user){ %>
        <div class="drawer-profile">
            <img src="<%= user.profileImage ? user.profileImage : '' %>" alt="Avatar" class="drawer-avatar">
            <div>
                <p class="drawer-name"><%= user.fullName || '' %></p>
                <p class="drawer-email"><%= user.email || '' %></p>
            </div>
        </div>
        <% } %>

        <nav class="drawer-nav">
            <a href="/" class="drawer-link">
                <span class="material-symbols-outlined">home</span>
                Home
            </a>

            <!-- Categories accordion -->
            <div class="drawer-accordion">
                <button class="drawer-accordion-btn" id="categoriesAccordionBtn">
                    <span class="drawer-link-inner">
                        <span class="material-symbols-outlined">category</span>
                        Categories
                    </span>
                    <span class="material-symbols-outlined accordion-arrow">expand_more</span>
                </button>
                <div class="drawer-accordion-body" id="categoriesAccordionBody">
                    <a href="/products?category=69a9b338e3f99130d71b888b&minPrice=0&maxPrice=50000&page=1&sort=&search=" class="drawer-sub-link">TWS</a>
                    <a href="/products?category=69a9b36be3f99130d71b8895&minPrice=0&maxPrice=50000&page=1&sort=&search=" class="drawer-sub-link">Neckbands</a>
                    <a href="/products?category=69a9b387e3f99130d71b889a&minPrice=0&maxPrice=50000&page=1&sort=&search=" class="drawer-sub-link">Wired Headphones</a>
                    <a href="/products?category=69a9b3a1e3f99130d71b889f&minPrice=0&maxPrice=50000&page=1&sort=&search=" class="drawer-sub-link">Wireless Headphones</a>
                    <a href="/products?category=69a9b34de3f99130d71b8890&minPrice=0&maxPrice=50000&page=1&sort=&search=" class="drawer-sub-link">Gaming Headsets</a>
                </div>
            </div>

            <a href="/products" class="drawer-link">
                <span class="material-symbols-outlined">storefront</span>
                Store
            </a>
            <a href="/contact" class="drawer-link">
                <span class="material-symbols-outlined">mail</span>
                Contact
            </a>
        </nav>

        <div class="drawer-footer">
            <% if(user){ %>
            <a href="/profile" class="drawer-footer-link">
                <span class="material-symbols-outlined">person</span>
                My Profile
            </a>
            <a href="/orders" class="drawer-footer-link">
                <span class="material-symbols-outlined">package_2</span>
                My Orders
            </a>
            <a href="/logout" class="drawer-footer-link drawer-logout">
                <span class="material-symbols-outlined">logout</span>
                Logout
            </a>
            <% } else { %>
            <a href="/login" class="drawer-auth-btn">Login</a>
            <a href="/signup" class="drawer-auth-btn drawer-auth-outline">Signup</a>
            <% } %>
        </div>
    </div>

    <div class="toast toast-banner" id="toast">
    <div class="tb-icon" id="toastIcon"></div>
    <div class="tb-text">
        <div class="tb-title" id="toastTitle"></div>
        <div class="tb-sub"   id="toastSub"></div>
    </div>
    <div class="tb-close" onclick="removeToast()">&#10005;</div>
</div>

<script>
  // ── Hamburger / Drawer ────────────────────────────────────────────
  const hamburgerBtn  = document.getElementById('hamburgerBtn')
  const mobileOverlay = document.getElementById('mobileOverlay')
  const mobileDrawer  = document.getElementById('mobileDrawer')
  const drawerClose   = document.getElementById('drawerClose')

  function openDrawer () {
    mobileDrawer.classList.add('open')
    mobileOverlay.classList.add('show')
    document.body.style.overflow = 'hidden'
    hamburgerBtn.classList.add('active')
  }

  function closeDrawer () {
    mobileDrawer.classList.remove('open')
    mobileOverlay.classList.remove('show')
    document.body.style.overflow = ''
    hamburgerBtn.classList.remove('active')
  }

  hamburgerBtn.addEventListener('click', openDrawer)
  drawerClose.addEventListener('click', closeDrawer)
  mobileOverlay.addEventListener('click', closeDrawer)

  // ── Categories Accordion ──────────────────────────────────────────
  const accBtn  = document.getElementById('categoriesAccordionBtn')
  const accBody = document.getElementById('categoriesAccordionBody')

  accBtn.addEventListener('click', () => {
    const isOpen = accBody.classList.toggle('open')
    accBtn.querySelector('.accordion-arrow').textContent = isOpen ? 'expand_less' : 'expand_more'
  })
</script>
