<header class="header">
    <div class="header-left">
        <button class="mobile-menu-btn" id="mobileMenuBtn">
            <span class="material-symbols-outlined">menu</span>
        </button>
        <div class="header-title">
            <span class="material-symbols-outlined">grid_view</span>
            <span><%= currentPage  %></span>
        </div>
    </div>
    <div class="header-right">
        <button class="logout-btn" onclick="window.location.href='/admin/logout'">
            <span>Logout</span>
            <span class="material-symbols-outlined">logout</span>
        </button>
    </div>
</header>
<div class="toast toast-banner" id="toast" >
    <div class="tb-icon" id="toastIcon"></div>
    <div class="tb-text">
        <div class="tb-title" id="toastTitle"></div>
        <div class="tb-sub"   id="toastSub"></div>
    </div>
    <div class="tb-close" onclick="removeToast()">&#10005;</div>
</div>
<div id="loaderOverlay" class="loader-overlay">
  <div class="spinner"></div>
</div>