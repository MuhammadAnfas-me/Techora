<div class="sidebar-overlay" id="sidebarOverlay"></div>

<aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo">
            <div class="logo-icon">
                <span class="material-symbols-outlined">layers</span>
            </div>
            <span class="logo-text hide-on-collapse">Techora</span>
        </div>
        
        <button class="collapse-btn" id="collapseBtn">
            <span class="material-symbols-outlined">chevron_left</span>
        </button>

        <button class="sidebar-close" id="sidebarClose">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>

    <nav class="sidebar-nav">
        <a href="#" class="nav-item <%= currentPage === "dashboard" ? 'active' : '' %>" title="Dashboard">
            <span class="material-symbols-outlined">grid_view</span>
            <span class="hide-on-collapse">Dashboard</span>
        </a>
        
        <a href="#" class="nav-item <%= currentPage === "orders" ? 'active' : '' %>" title="Orders">
            <span class="material-symbols-outlined">shopping_bag</span>
            <span class="hide-on-collapse">Orders</span>
        </a>

        <a href="/admin/products" class="nav-item <%= currentPage === "products" ? "active" : '' %>" title="Products">
            <span class="material-symbols-outlined">inventory_2</span>
            <span class="hide-on-collapse">Products</span>
        </a>

        <a href="/admin/category" class="nav-item <%= currentPage === "category" ? 'active' : '' %>" title="Categories">
            <span class="material-symbols-outlined">category</span>
            <span class="hide-on-collapse">Categories</span>
        </a>

        <a href="/admin/users" class="nav-item <%= currentPage === "users" ? 'active' : '' %>" title="Users">
            <span class="material-symbols-outlined">group</span>
            <span class="hide-on-collapse">Users</span>
        </a>

        <a href="#" class="nav-item <%= currentPage === "offers" ? "active" : '' %>" title="Offers">
            <span class="material-symbols-outlined">local_offer</span>
            <span class="hide-on-collapse">Offers</span>
        </a>

        <a href="#" class="nav-item <%= currentPage === 'coupons' ? 'active' : '' %>" title="Coupons">
            <span class="material-symbols-outlined">confirmation_number</span>
            <span class="hide-on-collapse">Coupons</span>
        </a>

        <a href="#" class="nav-item <%= currentPage === 'reports' ? 'active' : '' %>" title="Reports">
            <span class="material-symbols-outlined">bar_chart</span>
            <span class="hide-on-collapse">Reports</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <div class="admin-profile">
            <img src="https://ui-avatars.com/api/?name=Admin+User&background=c7d2fe&color=3730a3" alt="Admin" class="admin-avatar">
            <div class="admin-info hide-on-collapse">
                <span class="admin-name">Admin User</span>
                <span class="admin-role">Administrator</span>
            </div>
        </div>
    </div>
</aside>
