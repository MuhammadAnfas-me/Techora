<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Products Management - Techora</title>
    <link rel="icon" href="https://res.cloudinary.com/dpbqsetq2/image/upload/v1779353242/site_favicon_1779348919224_ejgxyn.jpg" type="image/png">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script>
      (function() {
        const collapsed = localStorage.getItem("sidebarCollapsed") === "true";
        if (collapsed) document.documentElement.classList.add("sidebar-collapsed");
      })();
    </script>
    
    <link rel="stylesheet" href="/styles/admin/products/productsList.css" />
    <link rel="stylesheet" href="/styles/partitials/admin/sidebar.css" />
    <link rel="stylesheet" href="/styles/user/popup.css" />

    

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="/js/popup.js" defer></script>
    <script src="/js/partitials/Admin/sidebar.js" defer></script>
  </head>

  <body>
    <%- include("../../partitials/admin/sidebar.ejs",{ currentPage }) %>

    <div class="main-wrapper">
      <%- include("../../partitials/admin/header.ejs",{currentPage}) %>

      <main class="main-content">
        <div class="content-container">
          
          <div class="page-header-wrapper">
            <div class="page-header-left">
              <h1 class="page-title">Products Management</h1>
              <p class="page-subtitle">Manage mobile phones and accessories</p>
            </div>
            <button class="btn-primary" type="button" onclick="addProduct()">
              <span class="material-symbols-outlined" style="font-size: 18px;">add_circle</span>
              Add New Product
            </button>
          </div>

          <div class="filters-card">
          <select class="filter-select" id="categorySelect" name="category">
            <option value="">Select Category</option>
            <% categories.forEach((item)=>{ %>
            <option value="<%= item._id %>" ><%= item.name %></option>
            <% }) %>
          </select>
        
          <select class="filter-select" id="brandSelect" name="brand">
            <option value="">Brand</option>
            <option value="apple">Apple</option>
            <option value="samsung">Samsung</option>
            <option value="google">Google</option>
            <option value="sony">Sony</option>
          </select>
        
          <select class="filter-select" id="stockStatusSelect" name="status">
            <option value="">Stock Status</option>
            <option value="In Stock">In Stock</option>
            <option value="Low Stock">Low Stock</option>
            <option value="Out of Stock">Out of Stock</option>
          </select>

        
        
          <div class="search-wrapper">
            <input type="text" id="search-input" placeholder="Search products" name="search" />
            <span
              class="material-symbols-outlined clear-icon"
              id="clearBtn"
              style="display: none;"
              >close</span
            >
          </div>
        
  <div class="filter-actions">
    <button class="btn-primary" id="searchBtn" style="background-color: #1B3C53;">Search</button>
    <button class="btn-primary" id="resetBtn" style="background-color: #1B3C53;">Reset</button>
  </div>
</div>

                <!-- Custom Confirm Modal -->
<div class="confirm-overlay" id="confirmOverlay">
  <div class="confirm-box">
    <h3 id="confirmTitle">Confirm Action</h3>
    <p id="confirmMessage">Are you sure?</p>
    <div class="confirm-actions">
      <button class="btn-cancel" id="confirmCancel">Cancel</button>
      <button class="btn-confirm" id="confirmOk">Confirm</button>
    </div>
  </div>
</div>

          <div class="table-card">
            <div style="overflow-x: auto;">
              <table class="product-table">
                <thead>
                  <tr>
                    <th>Image</th>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th>Price Range</th>
                    <th>Total Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="productTbody">
                  <% if(products.length>0) {%>
                  <% products.forEach((product)=>{ %>
                  <tr>
                    <td>
                      <div class="product-image">
                        <% if(product?.variants[0]?.image[0]) {%>
                            <img src="<%= product.variants[0].image[0] %>" alt="">
                        <% }else{ %>
                            <span class="material-symbols-outlined">image</span>
                        <% } %>
                      </div>
                    </td>
                    <td>
                      <div class="product-details">
                        <span class="product-name <%= product.status == 'inactive' ? 'product-name-blocked' : "" %>"><%= product.name %></span>
                        <span class="product-variants"><%=product.variants.length %> variants available • <a href="/admin/products/variants/<%= product._id %>" class="view-variants" style="text-decoration: none;">View variants</a></span>
                      </div>
                    </td>
                    <td><span class="category-pill cat-smartphones"><%= product.categoryId ? product.categoryId.name : "No category" %></span></td>
                    <td><%= product.brand %></td>
                    <% const prices = product.variants?.map((v)=> v.price ) %>
                    <td>₹<%= Math.min(...prices)%> – ₹<%= Math.max(...prices) %></td>
                    <% const stock = product.variants.reduce((acc,curr)=>{ 
                      acc+=curr.stock
                      return acc
                     },0) %>
                    <td><%= stock ? stock : "0" %></td>
                    <td><span class="status-pill <%= stock === 0 ? "status-out-of-stock" : stock >= 15 ? "status-in-stock" : "status-low-stock" %>">
                      
                      <%= stock === 0 ? "out-of-stock" : stock >= 15 ? "In stock" : "Low stock" %>
                      </span>
                      </td>
                    <td>
                      <div class="action-icons">
                        <button class="action-btn" type="button" title="Edit"><span class="material-symbols-outlined" onclick="updateProduct('<%= product._id %>')" style="font-size: 20px;">edit</span></button>
                        <button class="action-btn" type="button" title="<%= product.status == "inactive" ? 'Block' : 'Unblock' %>" onclick="toggleProductStatus('<%= product._id %>')">
                          <span class="material-symbols-outlined" style="font-size:20px;">
                            <%= product.status == "inactive" ? "block" : "check_circle" %>
                          </span>
                        </button>
                      </div>
                    </td>
                  </tr>
                 <% }) %>
                <% }else{ %>
                  <tr>
        <td colspan="8" class="category-muted" style="text-align:center; padding:16px;">
          No products found
        </td>
      </tr>
                <% } %>
                  

                </tbody>
              </table>
            </div>
            
        <%
                  const queryParams = new URLSearchParams();


                  if (selectedCategory) queryParams.set("category", selectedCategory);
                  if (selectedBrand) queryParams.set("brand", selectedBrand);
                  if (selectedStockStatus) queryParams.set("status", selectedStockStatus);
                  if (search) queryParams.set("search", search);
                  const makePageLink = (page) => {
                    const params = new URLSearchParams(queryParams.toString());
                    params.set("page", page);
                    return `/admin/products?${params.toString()}`;
                  };
                %>
        <% if (totalPages > 1) { %>
<nav class="pagination">
    <% if (page > 1) { %>
        <a href="<%= makePageLink(page - 1) %>" class="page-link page-link-nav">
            <div class="h-4 w-4">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                </svg>
            </div>
            Previous
        </a>
    <% } %>

    <% for (let i = 1; i <= totalPages; i++) { %>
        <a 
          href="<%= makePageLink(i) %>" 
          class="page-link <%= page === i ? 'active' : '' %>">
          <%= i %>
        </a>
    <% } %>

    <% if (page < totalPages) { %>
        <a href="<%= makePageLink(page + 1) %>" class="page-link page-link-nav">
            Next
            <div class="h-4 w-4">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                </svg>
            </div>
        </a>
    <% } %>
</nav>
<% } %>


          </div>

        </div>
      </main>
    </div>
  </body>

  <script>
  const searchInput = document.getElementById("search-input");
  const clearBtn = document.getElementById("clearBtn");
  const searchBtn = document.getElementById("searchBtn");
  const resetBtn = document.getElementById("resetBtn");

  const categorySelect = document.getElementById("categorySelect");
  const brandSelect = document.getElementById("brandSelect");
  const stockStatusSelect = document.getElementById("stockStatusSelect");

  const paginationEl = document.querySelector(".product-pagination");
  const pageInfo = document.getElementById("pageInfo");
  const prevBtn = document.getElementById("prevBtn");
  const nextBtn = document.getElementById("nextBtn");

  function updateProduct(id){
  showLoader()
  setTimeout(()=>{
    hideLoader()
    window.location.href=`/admin/products/${id}`
  },300)
}

  function updateClearButton() {
    clearBtn.style.display = searchInput.value.trim() ? "inline-block" : "none";
  }

  function applyFilters() {
    const params = new URLSearchParams();

    const search = searchInput.value.trim();
    const category = categorySelect.value;
    const brand = brandSelect.value;
    const status = stockStatusSelect.value;

    if (search) params.set("search", search);
    if (category) params.set("category", category);
    if (brand) params.set("brand", brand);
    if (status) params.set("status", status);

    window.location.href = `/admin/products?${params.toString()}`;
  }

  function loadCurrentFilters() {
    const params = new URLSearchParams(window.location.search);

    searchInput.value = params.get("search") || "";
    categorySelect.value = params.get("category") || "";
    brandSelect.value = params.get("brand") || "";
    stockStatusSelect.value = params.get("status") || "";

    updateClearButton();
  }

  searchInput.addEventListener("input", updateClearButton);

  clearBtn.addEventListener("click", () => {
    searchInput.value = "";
    updateClearButton();
    applyFilters();
  });

  searchBtn.addEventListener("click", applyFilters);

  searchInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      applyFilters();
    }
  });

  resetBtn.addEventListener("click", () => {
    searchInput.value = "";
    categorySelect.value = "";
    brandSelect.value = "";
    stockStatusSelect.value = "";
    updateClearButton();
    window.location.href = "/admin/products";
  });

  categorySelect.addEventListener("change", applyFilters);
  brandSelect.addEventListener("change", applyFilters);
  stockStatusSelect.addEventListener("change", applyFilters);

  loadCurrentFilters();

  if (paginationEl && pageInfo && prevBtn && nextBtn) {
    const currentPage = Number(paginationEl.dataset.currentPage) || 1;
    const totalPages = Number(paginationEl.dataset.totalPages) || 1;

    function updatePaginationUI() {
      pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
    }

    function goToPage(page) {
      const params = new URLSearchParams(window.location.search);
      params.set("page", page);
      window.location.href = `${window.location.pathname}?${params.toString()}`;
    }

    prevBtn.addEventListener("click", () => {
      if (currentPage > 1) {
        goToPage(currentPage - 1);
      }
    });

    nextBtn.addEventListener("click", () => {
      if (currentPage < totalPages) {
        goToPage(currentPage + 1);
      }
    });

    updatePaginationUI();
  }

  
    async function toggleProductStatus(id) {
      showConfirm("Are you sure you want to block/unblock this product?",async ()=>{
  try {
    const res = await axios.patch(`/admin/products/${id}/block`);

    showToast(res.data.message || "Status updated", "success");
    setTimeout(() => location.reload(), 500);

  } catch (error) {
    showToast(error.response?.data?.message || "Failed to update status", "error");
  }
  
   })
}

function addProduct(){
  showLoader()
  setTimeout(()=>{
    hideLoader()
    window.location.href='/admin/products/add'
  },300)
}

            



</script>
</html>