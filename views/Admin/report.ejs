<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reports Management - Techora</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    (function () {
      const collapsed = localStorage.getItem("sidebarCollapsed") === "true";
      if (collapsed) document.documentElement.classList.add("sidebar-collapsed");
    })();
  </script>

  <link rel="stylesheet" href="/styles/admin/products/productsList.css" />
  <link rel="stylesheet" href="/styles/partitials/admin/sidebar.css" />
  <link rel="stylesheet" href="/styles/user/popup.css" />

  <!-- Chart.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

  <style>

    /* ── Page Header Row ── */
    .reports-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 14px;
    }

    .reports-header-left h1 {
      font-size: 24px;
      font-weight: 700;
      color: #111827;
      margin: 0 0 4px 0;
    }

    .reports-header-left p {
      font-size: 13px;
      color: #6b7280;
      margin: 0;
    }

    .reports-header-right {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    /* Date range badge */
    .date-range-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 7px;
      font-size: 13px;
      font-weight: 500;
      color: #374151;
      cursor: pointer;
      white-space: nowrap;
    }

    .date-range-badge i {
      color: #6b7280;
      font-size: 13px;
    }

    /* Export button */
    .btn-export {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 9px 18px;
      background: #1B3C53;
      border: none;
      border-radius: 7px;
      font-size: 14px;
      font-weight: 500;
      color: #fff;
      cursor: pointer;
      transition: background 0.2s;
      white-space: nowrap;
      font-family: 'Inter', sans-serif;
    }

    .btn-export:hover {
      background: #14303f;
    }

    /* ── Stat Cards ── */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }

    @media (max-width: 1100px) {
      .stats-grid { grid-template-columns: repeat(3, 1fr); }
    }

    @media (max-width: 700px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 440px) {
      .stats-grid { grid-template-columns: 1fr; }
    }

    .stat-card {
      background: #fff;
      border-radius: 10px;
      border: 1px solid #e5e7eb;
      padding: 18px 20px;
      position: relative;
      overflow: hidden;
    }

    /* colored top border per card */
    .stat-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      border-radius: 10px 10px 0 0;
    }

    .stat-card.blue::before   { background: #3b82f6; }
    .stat-card.green::before  { background: #10b981; }
    .stat-card.orange::before { background: #f59e0b; }
    .stat-card.red::before    { background: #ef4444; }
    .stat-card.purple::before { background: #8b5cf6; }

    .stat-card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 8px;
    }

    .stat-card-label {
      font-size: 12px;
      color: #6b7280;
      font-weight: 500;
    }

    .stat-card-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .stat-card-icon.blue   { background: #eff6ff; }
    .stat-card-icon.green  { background: #ecfdf5; }
    .stat-card-icon.orange { background: #fffbeb; }
    .stat-card-icon.red    { background: #fef2f2; }
    .stat-card-icon.purple { background: #f5f3ff; }

    .stat-card-icon .material-symbols-outlined {
      font-size: 17px;
    }

    .stat-card-icon.blue   .material-symbols-outlined { color: #3b82f6; }
    .stat-card-icon.green  .material-symbols-outlined { color: #10b981; }
    .stat-card-icon.orange .material-symbols-outlined { color: #f59e0b; }
    .stat-card-icon.red    .material-symbols-outlined { color: #ef4444; }
    .stat-card-icon.purple .material-symbols-outlined { color: #8b5cf6; }

    .stat-card-value {
      font-size: 26px;
      font-weight: 700;
      color: #111827;
      line-height: 1;
      margin-bottom: 8px;
    }

    .stat-card-sub {
      font-size: 11px;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .sub-up   { color: #059669; }
    .sub-down { color: #dc2626; }
    .sub-warn { color: #d97706; }
    .sub-info { color: #7c3aed; }

    .sub-up i, .sub-down i, .sub-warn i, .sub-info i {
      font-size: 10px;
    }

    .sub-text {
      color: #9ca3af;
    }

    /* ── Charts Row ── */
    .charts-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }

    @media (max-width: 820px) {
      .charts-row {
        grid-template-columns: 1fr;
      }
    }

    .chart-card {
      background: #fff;
      border-radius: 10px;
      border: 1px solid #e5e7eb;
      padding: 22px 24px;
    }

    .chart-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 4px;
    }

    .chart-card-title {
      font-size: 15px;
      font-weight: 600;
      color: #111827;
      margin: 0 0 3px 0;
    }

    .chart-card-sub {
      font-size: 12px;
      color: #9ca3af;
      margin: 0 0 18px 0;
    }

    .chart-info-icon {
      color: #9ca3af;
      font-size: 18px;
      cursor: pointer;
    }

    .chart-wrapper {
      position: relative;
      width: 100%;
      height: 260px;
    }

    /* ── Top Selling Products ── */
    .products-card {
      background: #fff;
      border-radius: 10px;
      border: 1px solid #e5e7eb;
      padding: 22px 24px;
      margin-bottom: 24px;
    }

    .products-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .products-card-header h2 {
      font-size: 16px;
      font-weight: 600;
      color: #111827;
      margin: 0;
    }

    .view-all-link {
      font-size: 13px;
      font-weight: 600;
      color: #059669;
      text-decoration: none;
      transition: color 0.15s;
    }

    .view-all-link:hover {
      color: #047857;
    }

    /* products table */
    .products-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }

    .products-table thead tr {
      border-bottom: 1px solid #f3f4f6;
    }

    .products-table th {
      padding: 10px 12px;
      text-align: left;
      font-size: 12px;
      font-weight: 600;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .products-table td {
      padding: 16px 12px;
      border-bottom: 1px solid #f9fafb;
      color: #374151;
      vertical-align: middle;
    }

    .products-table tbody tr:last-child td {
      border-bottom: none;
    }

    .products-table tbody tr:hover {
      background: #fafafa;
    }

    /* product name cell */
    .product-name-cell {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .product-img {
      width: 38px;
      height: 38px;
      border-radius: 8px;
      object-fit: cover;
      background: #f3f4f6;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
    }

    .product-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 8px;
    }

    .product-img-placeholder {
      width: 38px;
      height: 38px;
      border-radius: 8px;
      background: #e5e7eb;
      flex-shrink: 0;
    }

    .product-name-text {
      font-weight: 500;
      color: #111827;
      font-size: 14px;
    }

    .revenue-value {
      font-weight: 600;
      color: #059669;
    }

    .category-text {
      color: #9ca3af;
    }

    /* responsive */
    @media (max-width: 640px) {
      .reports-header { flex-direction: column; align-items: flex-start; }
      .products-table th, .products-table td { padding: 12px 8px; font-size: 13px; }
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="/js/popup.js" defer></script>
  <script src="/js/partitials/Admin/sidebar.js" defer></script>
</head>

<body>
  <div id="toast" class="toast"></div>
  <%- include("../partitials/admin/sidebar.ejs", { currentPage: 'reports' }) %>

  <div class="main-wrapper">
    <%- include("../partitials/admin/header.ejs", { currentPage: 'reports' }) %>

    <main class="main-content">
      <div class="content-container">

 
        <!-- ── Page Header ── -->
        <div class="reports-header">
          <div class="reports-header-left">
            <h1>Reports Management</h1>
            <p>Create, manage, and analyze business performance reports</p>
          </div>
          <div class="reports-header-right">
            <div class="date-range-badge">
              <i class="fas fa-calendar"></i>
              Oct 01, 2023 - Oct 31, 2023
            </div>
            <button class="btn-export" type="button">
              <span class="material-symbols-outlined" style="font-size:17px;">upload_file</span>
              Export Report
            </button>
          </div>
        </div>

        <!-- ── Stat Cards ── -->
        <div class="stats-grid">

          <!-- Total Orders -->
          <div class="stat-card blue">
            <div class="stat-card-top">
              <span class="stat-card-label">Total Orders</span>
              <div class="stat-card-icon blue">
                <span class="material-symbols-outlined">shopping_bag</span>
              </div>
            </div>
            <div class="stat-card-value"><%= totalOrders %></div>
            <div class="stat-card-sub">
              <span class="sub-up"><i class="fas fa-arrow-up"></i> +12.5%</span>
              <span class="sub-text">from last month</span>
            </div>
          </div>

          <!-- Total Revenue -->
          <div class="stat-card green">
            <div class="stat-card-top">
              <span class="stat-card-label">Total Revenue</span>
              <div class="stat-card-icon green">
                <span class="material-symbols-outlined">circle</span>
              </div>
            </div>
            <div class="stat-card-value">₹<%= totalRevenue.toLocaleString() %></div>
            <div class="stat-card-sub">
              <span class="sub-up"><i class="fas fa-arrow-up"></i> +8.2%</span>
              <span class="sub-text">from last month</span>
            </div>
          </div>

          <!-- Pending -->
          <div class="stat-card orange">
            <div class="stat-card-top">
              <span class="stat-card-label">Pending</span>
              <div class="stat-card-icon orange">
                <span class="material-symbols-outlined">hourglass_bottom</span>
              </div>
            </div>
            <div class="stat-card-value"><%= pendingOrders %></div>
            <div class="stat-card-sub">
              <span class="sub-warn"><i class="fas fa-arrow-down"></i> Requires Action</span>
            </div>
          </div>

          <!-- Cancelled -->
          <div class="stat-card red">
            <div class="stat-card-top">
              <span class="stat-card-label">Cancelled</span>
              <div class="stat-card-icon red">
                <span class="material-symbols-outlined">cancel</span>
              </div>
            </div>
            <div class="stat-card-value"><%= cancelledOrders %></div>
            <div class="stat-card-sub">
              <span class="sub-down"><i class="fas fa-arrow-down"></i> -2.4%</span>
              <span class="sub-text">lower then avg</span>
            </div>
          </div>

          <!-- Delivered -->
          <div class="stat-card purple">
            <div class="stat-card-top">
              <span class="stat-card-label">Delivered</span>
              <div class="stat-card-icon purple">
                <span class="material-symbols-outlined">inventory_2</span>
              </div>
            </div>
            <div class="stat-card-value"><%= deliveredOrders %></div>
            <div class="stat-card-sub">
              <span class="sub-info"><i class="fas fa-circle" style="font-size:7px;"></i> 95.2%</span>
              <span class="sub-text">completion rate</span>
            </div>
          </div>

        </div>

        <!-- ── Charts Row ── -->
        <div class="charts-row">

          <!-- Orders Over Time (line) -->
          <div class="chart-card">
            <div class="chart-card-header">
              <div>
                <h3 class="chart-card-title">Orders Over Time</h3>
                <p class="chart-card-sub">Daily order volume for the last 7 days</p>
              </div>
              <span class="material-symbols-outlined chart-info-icon">info</span>
            </div>
            <div class="chart-wrapper">
              <canvas id="ordersChart"></canvas>
            </div>
          </div>

          <!-- Revenue by Category (bar) -->
          <div class="chart-card">
            <div class="chart-card-header">
              <div>
                <h3 class="chart-card-title">Revenue by Category</h3>
                <p class="chart-card-sub">Revenue distribution across product categories</p>
              </div>
              <span class="material-symbols-outlined chart-info-icon">info</span>
            </div>
            <div class="chart-wrapper">
              <canvas id="categoryChart"></canvas>
            </div>
          </div>

        </div>

        <!-- ── Top Selling Products ── -->
        <div class="products-card">
          <div class="products-card-header">
            <h2>Top Selling Products</h2>
            <a href="/admin/products" class="view-all-link">View All</a>
          </div>
          <div style="overflow-x: auto;">
            <table class="products-table">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Category</th>
                  <th>Units Sold</th>
                  <th>Revenue</th>
                </tr>
              </thead>
              <tbody>
                <% topProducts.forEach(product => { %>
                <tr>
                  <td>
                    <div class="product-name-cell">
                      <% if(product.image) { %>
                         <div class="product-img"><img src="<%= product.image %>" alt="<%= product.name %>"></div>
                      <% } else { %>
                         <div class="product-img-placeholder"></div>
                      <% } %>
                      <span class="product-name-text"><%= product.name %></span>
                    </div>
                  </td>
                  <td class="category-text"><%= product.category %></td>
                  <td><%= product.unitsSold %></td>
                  <td class="revenue-value">₹<%= product.revenue.toLocaleString() %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </main>
  </div>

  <script>
    // ── Orders Over Time — Line Chart ──
    new Chart(document.getElementById("ordersChart").getContext("2d"), {
      type: "line",
      data: {
        labels: <%- chartLabels %>,
        datasets: [{
          data: <%- chartData %>,
          borderColor: "#3b82f6",
          backgroundColor: "rgba(59,130,246,0.07)",
          borderWidth: 2.5,
          pointBackgroundColor: "#3b82f6",
          pointRadius: 5,
          pointHoverRadius: 7,
          tension: 0.4,
          fill: true
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: {
            grid: { display: false },
            ticks: { font: { family: "Inter", size: 12 }, color: "#6b7280" },
            border: { display: false }
          },
          y: {
            beginAtZero: true,
            ticks: {
              stepSize: 60,
              font: { family: "Inter", size: 12 },
              color: "#6b7280"
            },
            grid: { color: "#f3f4f6" },
            border: { display: false }
          }
        }
      }
    });

    // ── Revenue by Category — Bar Chart ──
    new Chart(document.getElementById("categoryChart").getContext("2d"), {
      type: "bar",
      data: {
        labels: <%- categoryChartLabels %>,
        datasets: [{
          data: <%- categoryChartData %>,
          backgroundColor: "#1B3C53",
          borderRadius: 4,
          borderSkipped: false,
          barPercentage: 0.55,
          categoryPercentage: 0.65
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: (ctx) => ` ₹${ctx.raw.toLocaleString()}`
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { font: { family: "Inter", size: 12 }, color: "#6b7280" },
            border: { display: false }
          },
          y: {
            beginAtZero: true,
            ticks: {
              stepSize: 5000,
              font: { family: "Inter", size: 12 },
              color: "#6b7280",
              callback: (val) => val === 0 ? "0" : val.toLocaleString()
            },
            grid: { color: "#f3f4f6" },
            border: { display: false }
          }
        }
      }
    });
  </script>
</body>

</html>
