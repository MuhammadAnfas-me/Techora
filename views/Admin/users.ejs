<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users Management - Techora</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    
    <!-- CSS Files -->
    <link rel="stylesheet" href="/styles/admin/users.css">
    <link rel="stylesheet" href="/styles/partitials/admin/sidebar.css">
    <link rel="stylesheet" href="/styles/user/popup.css">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    
</head>
<body>

    <!-- Include Sidebar -->
    <div id="toast" class="toast"></div>
    <%- include("../partitials/admin/sidebar.ejs") %>

    <div class="main-wrapper">
        
        <!-- Include Header -->
         <%- include("../partitials/admin/header.ejs") %>

        <!-- Main Content -->
        <main class="main-content">
            <div class="content-container">
                <div class="page-header">
                    <h1 class="page-title">Users Management</h1>
                    <p class="page-subtitle">View and manage platform users</p>
                </div>

                <div class="filters-card">
                    <form action="/admin/users" method="get">
                    <div class="filters-grid">
                        <div class="filter-group search-group">
                            <label class="filter-label">Search</label>
                            <div class="search-input-wrapper">
                                <span class="material-symbols-outlined search-icon">search</span>
                                <input type="text" class="filter-input" id="searchInput"  name="search" value="<%=filter.search || ""  %>" placeholder="Search by name, email...">
                                <span class="material-symbols-outlined clear-icon" id="clearSearch">  close</span>                            
                            </div>
                        </div>

                        <div class="filter-group">
                            <label class="filter-label">Role</label>
                            <select class="filter-input" name="role">
                                <option value="">All Roles</option>
                                <option value="Customer" <%= filter?.role ==="Customer" ? "selected" : "" %>>Customer</option>
                                <option value="Admin" <%= filter?.role === "Admin" ? "selected ": "" %>>Admin</option>
                            </select>
                        </div>

                        <div class="filter-group">
                            <label class="filter-label" >Status</label>
                            <select class="filter-input" name="status">
                                <option value="">All Status</option>
                                <option value="Active"<%= filter?.status === "Active" ? "selected" : "" %>>Active</option>
                                <option value="Blocked" <%= filter?.status === "Blocked" ? "selected" : "" %>>Blocked</option>
                            </select>
                        </div>

                        <div class="filter-actions">
                            <button class="btn-primary" type="submit">Search</button>
                            <button class="btn-secondary" type="button" onclick="window.location.href='/admin/users'">Reset</button>
                        </div>
                    </div>
                </form>
                </div>

                <!-- Custom Confirm Modal -->
<div class="confirm-overlay" id="confirmOverlay">
  <div class="confirm-box">
    <h3 id="confirmTitle">Confirm Action</h3>
    <p id="confirmMessage">Are you sure?</p>
    <div class="confirm-actions">
      <button class="btn-cancel" id="confirmCancel">Cancel</button>
      <button class="btn-confirm" id="confirmOk">Confirm</button>
    </div>
  </div>
</div>


                <div class="table-card">
                    <div class="table-wrapper">
                        <table class="users-table">
                            <thead>
                                <tr>
                                    <th>User ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th class="text-center">Orders</th>
                                    <th>Status</th>
                                    <th>Registered Date</th>
                                    <th class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% users.forEach(user => { %>
                                    
                                
                                <tr>
                                    <td class="user-id"><%= user.userId %></td>
                                    <td>
                                        <div class="user-info">
                                             <img src="<%= user.profileImage?.url %>" alt="Alex Johnson">
                                            <span class="user-name"><%= user.fullName %></span>
                                        </div>
                                    </td>
                                    <td class="user-email"><%= user.email %></td>
                                    <td><span class="badge badge-role">Customer</span></td>
                                    <td class="text-center">-</td>
                                    <td><span class="badge <%= user.isBlocked ? 'badge-blocked' : 'badge-active' %>" ><%= user.isBlocked ? "Blocked" : "Active" %></span></td>
                                    <td class="user-date"><%= user.createdAt.toISOString().split('T')[0] %></td>
                                    <td class="text-right">
                                        <button class="action-btn block-btn" onclick="blockUser('<%= user._id %>')" >
                                            <span class="material-symbols-outlined" style="<%= user?.isBlocked ? 'color:red;' : '' %>">block</span>
                                        </button>
                                    </td>
                                </tr>
                                <%  }); %>
                            </tbody>
                        </table>    
                    </div>
                    <%
                      const qs = new URLSearchParams({
                        ...(filter?.search ? { search: filter.search } : {}),
                        ...(filter?.role ? { role: filter.role } : {}),
                        ...(filter?.status ? { status: filter.status } : {}),
                      }).toString();
                    %>
                    
                    <div class="pagination">
                        <p class="pagination-info">Showing 1-5 of <%= totalUsers %> users</p>
                        <div class="pagination-controls">
                            <button class="pagination-btn" onclick="location.href='/admin/users?page=<%= Math.max(page-1,1) %> <%= qs ? `&${qs}` : '' %>' " <%= page<= 1 ? 'disabled' : " " %>><span class="material-symbols-outlined">chevron_left</span></button>
                            <button class="pagination-btn" onclick="location.href='/admin/users?page=<%= Math.min(page+1,totalPages) %> <%= qs ? `&${qs}` : '' %> ' " <%= page >= totalPages ? "disabled" : "" %>><span class="material-symbols-outlined">chevron_right</span></button>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <script src="/js/popup.js"></script>
    <script src="/js/partitials/Admin/sidebar.js"></script>
    <script>
        async function blockUser(id) {
            showConfirm("Are you sure you want to block/unblock this user?",async ()=>{

            try {
              const res = await axios.patch(`/admin/users/block/${id}`);
            
              if (res.data.success) {
                location.reload(); // reload page after update
              }
          
            } catch (error) {
                console.error(error)
              showToast("Something went wrong");
            }
        })
        }           
    </script>
</body>
</html>