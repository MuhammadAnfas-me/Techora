<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users Management - Techora</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script>
  (function() {
      const collapsed = localStorage.getItem("sidebarCollapsed") === "true";
      if (collapsed) {
        document.documentElement.classList.add("sidebar-collapsed");
      }
      })();
    </script>
    <!-- CSS Files -->
    <link rel="stylesheet" href="/styles/admin/users.css">
    <link rel="stylesheet" href="/styles/partitials/admin/sidebar.css">
    <link rel="stylesheet" href="/styles/user/popup.css">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="/js/popup.js" defer></script>
    <script src="/js/partitials/Admin/sidebar.js" defer></script>
</head>
<body>

    <!-- Include Sidebar -->
    <div id="toast" class="toast"></div>
    <%- include("../partitials/admin/sidebar.ejs",{  currentPage }) %>

    <div class="main-wrapper">
        
        <!-- Include Header -->
         <%- include("../partitials/admin/header.ejs",{currentPage}) %>

        <!-- Main Content -->
        <main class="main-content">
            <div class="content-container">
                <div class="page-header">
                    <h1 class="page-title">Users Management</h1>
                    <p class="page-subtitle">View and manage platform users</p>
                </div>

                <div class="filters-card">
                    <form action="/admin/users" method="get">
                    <div class="filters-grid">
                        <div class="filter-group search-group">
                            <label class="filter-label">Search</label>
                            <div class="search-input-wrapper">
                                <span class="material-symbols-outlined search-icon">search</span>
                                <input type="text" class="filter-input" id="searchInput"  name="search" value="<%=filter.search || ""  %>" placeholder="Search by name, email...">
                                <span class="material-symbols-outlined clear-icon" id="clearSearch">  close</span>                            
                            </div>
                        </div>

                        <div class="filter-group">
                            <label class="filter-label">Role</label>
                            <select class="filter-input" id="role" name="role">
                                <option value="">All Roles</option>
                                <option value="Customer" <%= filter?.role ==="Customer" ? "selected" : "" %>>Customer</option>
                                <option value="Admin" <%= filter?.role === "Admin" ? "selected ": "" %>>Admin</option>
                            </select>
                        </div>

                        <div class="filter-group">
                            <label class="filter-label" >Status</label>
                            <select class="filter-input" id="status" name="status">
                                <option value="">All Status</option>
                                <option value="Active"<%= filter?.status === "Active" ? "selected" : "" %>>Active</option>
                                <option value="Blocked" <%= filter?.status === "Blocked" ? "selected" : "" %>>Blocked</option>
                            </select>
                        </div>

                        <div class="filter-actions">
                            <button class="btn-primary" id="resetButton" type="button" onclick="resetQuery()">Reset</button>
                        </div>
                    </div>
                </form>
                </div>

                <!-- Custom Confirm Modal -->
<div class="confirm-overlay" id="confirmOverlay">
  <div class="confirm-box">
    <h3 id="confirmTitle">Confirm Action</h3>
    <p id="confirmMessage">Are you sure?</p>
    <div class="confirm-actions">
      <button class="btn-cancel" id="confirmCancel">Cancel</button>
      <button class="btn-confirm" id="confirmOk">Confirm</button>
    </div>
  </div>
</div>


                <div class="table-card">
                    <div class="table-wrapper">
                        <table class="users-table">
                            <thead>
                                <tr>
                                    <th>User ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th class="text-center">Orders</th>
                                    <th>Status</th>
                                    <th>Registered Date</th>
                                    <th class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="userTbody">
                                <% users.forEach(user => { %>
                                    
                                
                                <tr>
                                    <td class="user-id"><%= user.userId %></td>
                                    <td>
                                        <div class="user-info">
                                             <img src="<%= user.profileImage?.url %>" alt="Alex Johnson">
                                            <span class="user-name"><%= user.fullName %></span>
                                        </div>
                                    </td>
                                    <td class="user-email"><%= user.email %></td>
                                    <td><span class="badge badge-role"><%= user.role %></span></td>
                                    <td class="text-center">-</td>
                                    <td><span class="badge status-badge <%= user.isBlocked ? 'badge-blocked' : 'badge-active' %>" ><%= user.isBlocked ? "Blocked" : "Active" %></span></td>
                                    <td class="user-date"><%= user.createdAt.toISOString().split('T')[0] %></td>
                                    <td class="text-right">
                                        <button class="action-btn block-btn" onclick="blockUser('<%= user._id %>',this)" >
                                            <span class="material-symbols-outlined" style="<%= user?.isBlocked ? 'color:red;' : '' %>">block</span>
                                        </button>
                                    </td>
                                </tr>
                                <%  }); %>
                            </tbody>
                        </table>    
                    </div>
                    <%
                      const qs = new URLSearchParams({
                        ...(filter?.search ? { search: filter.search } : {}),
                        ...(filter?.role ? { role: filter.role } : {}),
                        ...(filter?.status ? { status: filter.status } : {}),
                      }).toString();
                    %>
                    
                    

                    <div class="pagination">
  <p id="pageInfo" class="pagination-info">Loading...</p>

  <div class="pagination-controls">
    <button id="prevBtn" class="pagination-btn" type="button" disabled>
      <span class="material-symbols-outlined">chevron_left</span>
    </button>

    <button id="nextBtn" class="pagination-btn" type="button" disabled>
      <span class="material-symbols-outlined">chevron_right</span>
    </button>
  </div>
</div>
                </div>
            </div>
        </main>
    </div>
    
    <script >
       window.addEventListener("DOMContentLoaded", () => {
  const searchInput = document.getElementById("searchInput");
  const roleInput = document.getElementById("role")
  const statusInput = document.getElementById("status")

  const clearBtn = document.getElementById("clearSearch");
  const resetButton = document.getElementById("resetButton")
  const userTbody = document.getElementById("userTbody");

  const pageInfo = document.getElementById("pageInfo");
const prevBtn = document.getElementById("prevBtn");
const nextBtn = document.getElementById("nextBtn");


let state = {
  page: 1,
  totalPages: 1,
  total : 0
};
  if (!searchInput || !clearBtn || !userTbody) {
    console.log("Missing elements:", { searchInput, clearBtn, userTbody });
    return;
  }

  function debounce(fn, delay = 400) {
    let timer;
    return (...args) => {
      clearTimeout(timer);
      timer = setTimeout(() => fn(...args), delay);
    };
  }

  function toggleClearBtn() {
    clearBtn.style.display = searchInput.value.trim() ? "block" : "none";
  }

  function escapeHtml(str = "") {
    return String(str)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function formatDate(iso) {
    if (!iso) return "";
    const d = new Date(iso);
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, "0");
    const day = String(d.getDate()).padStart(2, "0");
    return `${y}-${m}-${day}`;
  }

  function renderPagination() {
  const start = state.total === 0 ? 0 : (state.page-1)*5+1;
  const end = Math.min(state.page*5,state.total)

  if (pageInfo) pageInfo.textContent =  `Showing ${start}-${end} of ${state.total} categories`;
  if (prevBtn) prevBtn.disabled = state.page <= 1;
  if (nextBtn) nextBtn.disabled = state.page >= state.totalPages;
}


  function renderUsers(users) {
    if (!users.length) {
      userTbody.innerHTML = `
        <tr>
          <td colspan="8" style="text-align:center; padding:16px;">
            No users found
          </td>
        </tr>
      `;
      return;
    }

    userTbody.innerHTML = users.map(user => {
      const profileUrl = user.profileImage?.url || "/images/default-user.png";
      const blocked = !!user.isBlocked;

      return `
        <tr>
          <td class="user-id">${escapeHtml(user.userId || "-")}</td>
          <td>
            <div class="user-info">
              <img src="${escapeHtml(profileUrl)}" alt="${escapeHtml(user.fullName || "User")}">
              <span class="user-name">${escapeHtml(user.fullName || "")}</span>
            </div>
          </td>
          <td class="user-email">${escapeHtml(user.email || "")}</td>
          <td><span class="badge badge-role">${escapeHtml(user.role || "")}</span></td>
          <td class="text-center">-</td>
          <td>
            <span class="badge status-badge ${blocked ? "badge-blocked" : "badge-active"}">
              ${blocked ? "Blocked" : "Active"}
            </span>
          </td>
          <td class="user-date">${formatDate(user.createdAt)}</td>
          <td class="text-right">
            <button class="action-btn block-btn" onclick="blockUser('${user._id}', this)">
              <span class="material-symbols-outlined" style="${blocked ? "color:red;" : ""}">block</span>
            </button>
          </td>
        </tr>
      `;
    }).join("");
  }

  async function fetchUsers(keepFocus = false) {
    const q = searchInput.value.trim();
    const r = roleInput.value.trim()
    const s = statusInput.value.trim()
    toggleClearBtn();

    try {
      const params = new URLSearchParams(); 
      params.set("page", String(state.page));
      if (q) params.set("search", q);
      if (r) params.set("role",r)
      if (s) params.set("status",s)

      console.log("Calling:", `/admin/users/api?${params.toString()}`); // ✅ debug

      const res = await axios.get(`/admin/users/api?${params.toString()}`);

      if (!res.data?.success) {
        showToast(res.data?.message || "Failed", "error");
        return;
      }

      renderUsers(res.data.users || []);
      state.totalPages = res.data.totalPages || 1;
      state.page = res.data.page || 1;
      state.total = res.data.totalUsers || 0;
      renderPagination();

      if (keepFocus) {
        searchInput.focus();
        const len = searchInput.value.length;
        searchInput.setSelectionRange(len, len);
      }
    } catch (err) {
      console.error(err);
      showToast("Something went wrong", "error");
    }
  }

  const debouncedFetch = debounce(fetchUsers, 400);

  // Init
  toggleClearBtn();
  fetchUsers()

  searchInput.addEventListener("input", ()=> debouncedFetch(true));
  roleInput.addEventListener("change", ()=> debouncedFetch());
  statusInput.addEventListener("change",()=> debouncedFetch());

  clearBtn.addEventListener("click", () => {
    searchInput.value = "";
    roleInput.value = ""
    statusInput.value = ""
    toggleClearBtn();
    fetchUsers();
  });
  resetButton.addEventListener("click",()=>{
    searchInput.value = "";
    roleInput.value = ""
    statusInput.value = ""
    fetchUsers();
  })

  prevBtn.addEventListener("click", () => {
  state.page = Math.max(state.page - 1, 1);
  fetchUsers()
});

nextBtn.addEventListener("click", () => {
  state.page = Math.min(state.page + 1, state.totalPages)
  fetchUsers()
});
});

async function blockUser(id,btn) {
            showConfirm("Are you sure you want to block/unblock this user?",async ()=>{

            try {
              const res = await axios.patch(`/admin/users/block/${id}`);
            
              if (!res.data.success) {
                showToast(!res.data.message || "Failed" ,"error")
                return
              }
              const isBlocked = res.data.isBlocked

              const icon = btn.querySelector("span");
              const row = btn.closest("tr");
              const statusBadge = row.querySelector(".status-badge");

              icon.style.color = isBlocked ? "red" : "";

              statusBadge.classList.remove("badge-active", "badge-blocked");
              statusBadge.classList.add(isBlocked ? "badge-blocked" : "badge-active");
              statusBadge.textContent = isBlocked ? "Blocked" : "Active"

              showToast(res.data.message )
            } catch (error) {
                console.error(error)
              showToast("Something went wrong","error");
            }
        })
        } 
    </script>
</body>
</html>