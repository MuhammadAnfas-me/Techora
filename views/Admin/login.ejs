<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Techora Admin Login</title>
        <link rel="icon" href="https://res.cloudinary.com/dpbqsetq2/image/upload/v1779353242/site_favicon_1779348919224_ejgxyn.jpg" type="image/png">

    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" crossorigin rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <link rel="stylesheet" href="/styles/admin/signup.css">
    <link rel="stylesheet" href="/styles/user/popup.css">
    <script defer src="/js/popup.js"></script>
</head>
<body>


<div class="toast toast-banner" id="toast" style="top: 20px; right: 20px;">
    <div class="tb-icon" id="toastIcon"></div>
    <div class="tb-text">
        <div class="tb-title" id="toastTitle"></div>
        <div class="tb-sub"   id="toastSub"></div>
    </div>
    <div class="tb-close" onclick="removeToast()">&#10005;</div>
</div>
    <div class="background-decor">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
    </div>

    <div class="login-wrapper">
        <main class="login-card">
            <div class="card-header">
                <div class="brand">
                    <span class="material-symbols-rounded brand-icon">smartphone</span>
                    <span class="brand-name">TECHORA</span>
                </div>
                <h1>Admin Login</h1>
                <p>Sign in to access the admin dashboard</p>
            </div>

            <form id="Form"  novalidate>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="admin@mobilemart.com" required>
                    <small id="emailError" style="color: red;"></small>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="password-container">
                        <input type="password" id="password" name="password" placeholder="Enter your password" required>
                        <button type="button" class="toggle-password" id="togglePassword">
                            <span class="material-symbols-rounded">visibility</span>
                        </button>
                    </div>
                    <small id="passwordError" style="color: red;"></small>
                </div>

                <button type="submit" class="btn-submit">
                    <span class="material-symbols-rounded">key</span>
                    Sign In
                </button>
            </form>

            <div class="secure-badge">
                <span class="material-symbols-rounded icon-success">check_circle</span>
                Secure admin access with role-based protection
            </div>
        </main>

        <footer class="page-footer">
            &copy; 2024 MobileMart Admin. All rights reserved.
        </footer>
    </div>

    <script>
        // --- Password Visibility Toggle ---
        const togglePasswordBtn = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('password');
        const passwordIcon = togglePasswordBtn.querySelector('span');
       
        togglePasswordBtn.addEventListener('click', () => {
            const isPassword = passwordInput.type === 'password';
            passwordInput.type = isPassword ? 'text' : 'password';
            passwordIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
        });

        document.getElementById("Form").addEventListener("submit",async(e)=>{
            e.preventDefault()
          try {
            const email = document.getElementById("email").value.trim()
            const password = document.getElementById("password").value
            const emailError = document.getElementById("emailError")
            const passwordError = document.getElementById("passwordError")

            let isValid = true 
            emailError.textContent = ""
            passwordError.textContent = ""
            if(email === ""){
                emailError.textContent = "-Enter valid Email"
                isValid = false
            }
            if(password == ""){
                passwordError.textContent = "-Please enter your password"
                isValid = false
            }
            if(isValid){
            const res = await axios.post("/admin/login",{
              email,
              password 
            })
            showToast(res.data.message || "Login successful")
            setTimeout(()=>{
                window.location.href = "/admin/dashboard"
            },800)
        }
          } catch (error) {
            showToast(error.response?.data?.message || "Failed to login","error")
          }
        })
        

    </script>

</body>
</html>