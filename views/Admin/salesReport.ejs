<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Techora – Administrative Sales Report</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap');

  :root {
    --navy:        #1B2F45;
    --navy-dark:   #142336;
    --navy-light:  #243B55;
    --page-bg:     #F0F2F5;
    --white:       #FFFFFF;
    --border:      #DDE2E8;
    --border-lt:   #EEF1F4;
    --text:        #1B2F45;
    --muted:       #7A8A99;
    --muted-lt:    #A8B5BF;
    --green:       #1E8A4C;
    --green-bg:    #EAF7EF;
    --red:         #C0392B;
    --red-bg:      #FDF0EE;
    --amber:       #B45309;
    --amber-bg:    #FEF3C7;
    --blue:        #2F6FB0;
    --blue-bg:     #EBF3FB;
    --purple:      #6D28D9;
    --purple-bg:   #EDE9FE;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { font-size: 10pt; }

  body {
    font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
    background: var(--page-bg);
    color: var(--text);
    line-height: 1.5;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  @page { size: A4 landscape; margin: 0; }

  @media print {
    body { background: var(--page-bg); }
    .page { box-shadow: none; margin: 0; border-radius: 0; }
    thead { display: table-header-group; }
    tr { page-break-inside: avoid; }
  }

  /* ── Page ── */
  .page {
    width: 297mm;
    min-height: 210mm;
    margin: 0 auto;
    background: var(--page-bg);
    display: flex;
    flex-direction: column;
  }

  @media screen {
    .page {
      box-shadow: 0 4px 40px rgba(0,0,0,.14);
      margin: 24px auto;
      border-radius: 6px;
      overflow: hidden;
      max-width: 1100px;
      width: 100%;
    }
  }

  /* ── Header ── */
  .header {
    background: var(--navy);
    padding: 22px 30px 18px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }

  .logo-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 5px;
  }

  .logo-icon {
    width: 30px; height: 30px;
    background: rgba(255,255,255,.15);
    border-radius: 7px;
    display: flex; align-items: center; justify-content: center;
  }

  .logo-icon svg { width: 17px; height: 17px; fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .logo-name {
    font-size: 15pt;
    font-weight: 700;
    color: #fff;
    letter-spacing: .5px;
  }

  .header-sub {
    font-size: 7.5pt;
    font-weight: 500;
    color: rgba(255,255,255,.45);
    letter-spacing: 1.1px;
    text-transform: uppercase;
  }

  .header-right {
    text-align: right;
  }

  .header-generated {
    font-size: 7.5pt;
    color: rgba(255,255,255,.45);
    margin-bottom: 2px;
  }

  .header-period {
    font-size: 8pt;
    color: rgba(255,255,255,.7);
    font-weight: 500;
  }

  /* ── Body ── */
  .body { padding: 18px 28px 26px; flex: 1; display: flex; flex-direction: column; gap: 18px; }

  /* ── Section title ── */
  .section-title {
    font-size: 7.5pt;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: .9px;
    text-transform: uppercase;
    margin-bottom: 9px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .section-title::after { content:''; flex:1; height:1px; background: var(--border); }

  /* ── Summary Cards ── */
  .cards-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 15px 18px 13px;
    position: relative;
    overflow: hidden;
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    border-radius: 8px 8px 0 0;
    background: var(--navy);
  }
  .card.blue::before   { background: var(--blue); }
  .card.red::before    { background: var(--red); }
  .card.green::before  { background: var(--green); }
  .card.amber::before  { background: var(--amber); }

  .card-label {
    font-size: 6.5pt;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: .7px;
    text-transform: uppercase;
    margin-bottom: 7px;
  }

  .card-value {
    font-size: 17pt;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
    letter-spacing: -.5px;
  }

  .card-value.blue  { color: var(--blue); }
  .card-value.red   { color: var(--red); }
  .card-value.green { color: var(--green); }

  .card-sub {
    font-size: 6.5pt;
    color: var(--muted-lt);
    margin-top: 5px;
  }

  /* ── Table ── */
  .table-wrap {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 8pt;
  }

  thead tr { background: #EEF1F4; }

  thead th {
    padding: 9px 13px;
    text-align: left;
    font-size: 6.5pt;
    font-weight: 700;
    color: var(--muted);
    letter-spacing: .8px;
    text-transform: uppercase;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  thead th.right { text-align: right; }
  thead th.center { text-align: center; }

  tbody tr:nth-child(even) { background: #FAFBFC; }
  tbody tr:hover { background: #F4F6F8; }
  tbody tr:last-child td { border-bottom: none; }

  tbody td {
    padding: 8.5px 13px;
    border-bottom: 1px solid var(--border-lt);
    vertical-align: middle;
  }

  tbody td.right  { text-align: right; }
  tbody td.center { text-align: center; }

  .order-id {
    font-family: 'DM Mono', 'Courier New', monospace;
    font-size: 7.5pt;
    font-weight: 500;
    color: var(--navy);
    letter-spacing: -.2px;
  }

  .date-cell {
    font-size: 7.5pt;
    color: var(--muted);
    white-space: nowrap;
  }

  .customer-name {
    font-weight: 500;
    color: var(--text);
  }

  .amount {
    font-family: 'DM Mono', monospace;
    font-size: 8pt;
    color: var(--text);
    text-align: right;
    font-weight: 500;
  }

  .amount.base  { color: var(--text); }
  .amount.disc  { color: var(--red); }
  .amount.paid  { color: var(--navy); font-weight: 700; }
  .amount.zero  { color: var(--muted-lt); }

  /* ── Status Badge ── */
  .badge {
    display: inline-block;
    font-size: 6.5pt;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 20px;
    letter-spacing: .4px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .badge-pending     { background: var(--amber-bg);  color: var(--amber); }
  .badge-delivered   { background: var(--green-bg);  color: var(--green); }
  .badge-shipped     { background: var(--blue-bg);   color: var(--blue); }
  .badge-processing  { background: var(--purple-bg); color: var(--purple); }
  .badge-refunded    { background: var(--red-bg);    color: var(--red); }

  /* ── Table footer totals ── */
  .totals-row { background: #EEF1F4 !important; }

  .totals-row td {
    padding: 9px 13px;
    border-top: 2px solid var(--border);
    font-size: 8pt;
    font-weight: 700;
    color: var(--navy);
  }

  .totals-row td.right { text-align: right; }

  .totals-row .total-label {
    font-size: 7pt;
    font-weight: 700;
    color: var(--muted);
    letter-spacing: .6px;
    text-transform: uppercase;
  }

  .totals-row .total-val {
    font-family: 'DM Mono', monospace;
    font-size: 9pt;
    font-weight: 700;
    text-align: right;
  }

  .totals-row .total-val.blue  { color: var(--blue); }
  .totals-row .total-val.red   { color: var(--red); }
  .totals-row .total-val.green { color: var(--green); }

  /* ── Footer ── */
  .footer {
    background: var(--navy-dark);
    padding: 12px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .footer-left {
    font-size: 7pt;
    color: rgba(255,255,255,.4);
  }

  .footer-left strong { color: rgba(255,255,255,.65); font-weight: 600; }

  .footer-right { font-size: 7pt; color: rgba(255,255,255,.3); }
</style>
</head>
<body>
<div class="page">

  <!-- HEADER -->
  <div class="header">
    <div>
      <div class="logo-row">
        <div class="logo-icon">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
        </div>
        <span class="logo-name">Techora</span>
      </div>
      <div class="header-sub">Administrative Sales Report</div>
    </div>
    <div class="header-right">
      <div class="header-generated">Generated: <%= generatedDate %></div>
      <div class="header-period">Period: <%= startDate %> – <%= endDate %></div>
    </div>
  </div>

  <!-- BODY -->
  <div class="body">

    <!-- Summary Cards -->
    <div>
      <div class="section-title">Overview</div>
      <div class="cards-row">
        <div class="card">
          <div class="card-label">Total Transactions</div>
          <div class="card-value"><%= totalOrders %></div>
          <div class="card-sub">All orders in period</div>
        </div>
        <div class="card blue">
          <div class="card-label">Gross Sales Amount</div>
          <div class="card-value blue">₹<%= grossSales.toLocaleString('en-IN') %></div>
          <div class="card-sub">Before discounts & deductions</div>
        </div>
        <div class="card red">
          <div class="card-label">Total Deductions</div>
          <div class="card-value red">₹<%= (totalDiscount + totalRefunds).toLocaleString('en-IN') %></div>
          <div class="card-sub">Discounts & Refunds</div>
        </div>
        <div class="card green">
          <div class="card-label">Net Revenue</div>
          <div class="card-value green">₹<%= netRevenue.toLocaleString('en-IN') %></div>
          <div class="card-sub">Final earnings</div>
        </div>
      </div>
    </div>

    <!-- Orders Table -->
    <div>
      <div class="section-title">Order Details</div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Order ID</th>
              <th>Date</th>
              <th>Customer</th>
              <th class="right">Base</th>
              <th class="right">Disc</th>
              <th class="right">Paid</th>
              <th class="center">Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (reportData && reportData.length > 0) { %>
              <% reportData.forEach(order => { %>
              <tr>
                <td class="order-id"><%= order.orderId %></td>
                <td class="date-cell"><%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: '2-digit', year: '2-digit' }) %></td>
                <td><span class="customer-name"><%= order.customerName || 'N/A' %></span></td>
                <td class="amount base">₹<%= order.subtotal.toLocaleString('en-IN') %></td>
                <td class="amount <%= order.discount > 0 ? 'disc' : 'zero' %>">₹<%= order.discount.toLocaleString('en-IN') %></td>
                <td class="amount paid">₹<%= order.totalAmount.toLocaleString('en-IN') %></td>
                <td class="center"><span class="badge badge-<%= order.orderStatus.toLowerCase() %>"><%= order.orderStatus %></span></td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="center" style="padding: 40px; color: var(--muted);">No orders found for this period.</td>
              </tr>
            <% } %>
            <!-- Totals Summary Row -->
            <tr class="totals-row">
              <td colspan="3" class="total-label">Totals Summary</td>
              <td class="total-val blue">₹<%= grossSales.toLocaleString('en-IN') %></td>
              <td class="total-val red">−₹<%= (totalDiscount + totalRefunds).toLocaleString('en-IN') %></td>
              <td class="total-val green">₹<%= netRevenue.toLocaleString('en-IN') %></td>
              <td></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div><!-- /body -->

  <!-- FOOTER -->
  <div class="footer">
    <div class="footer-left">
      <strong>Techora Admin Dashboard</strong> &nbsp;·&nbsp; Generated by system &nbsp;·&nbsp; Confidential
    </div>
    <div class="footer-right">Page 1 of 1</div>
  </div>

</div>
</body>
</html>