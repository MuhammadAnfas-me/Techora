<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard - Techora</title>
    <link rel="icon" href="https://res.cloudinary.com/dpbqsetq2/image/upload/v1779353242/site_favicon_1779348919224_ejgxyn.jpg" type="image/png">

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    (function () {
      const collapsed = localStorage.getItem("sidebarCollapsed") === "true";
      if (collapsed) document.documentElement.classList.add("sidebar-collapsed");
    })();
  </script>

  <link rel="stylesheet" href="/styles/admin/products/productsList.css" />
  <link rel="stylesheet" href="/styles/partitials/admin/sidebar.css" />
  <link rel="stylesheet" href="/styles/user/popup.css" />

  <!-- Chart.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

  <style>

    /* ── Stat Cards Row ── */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 24px;
    }

    @media (max-width: 1024px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 540px) {
      .stats-grid {
        grid-template-columns: 1fr;
      }
    }

    .stat-card {
      background: #fff;
      border-radius: 10px;
      border: 1px solid #e5e7eb;
      padding: 22px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .stat-label {
      font-size: 13px;
      color: #6b7280;
      font-weight: 500;
      margin-bottom: 8px;
    }

    .stat-value {
      font-size: 28px;
      font-weight: 700;
      color: #111827;
      line-height: 1;
    }

    .stat-icon-wrap {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      background: #f3f4f6;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .stat-icon-wrap .material-symbols-outlined {
      font-size: 22px;
      color: #1B3C53;
    }

    /* ── Section Cards ── */
    .section-card {
      background: #fff;
      border-radius: 10px;
      border: 1px solid #e5e7eb;
      padding: 24px;
      margin-bottom: 24px;
    }

    .section-title {
      font-size: 17px;
      font-weight: 600;
      color: #111827;
      margin: 0 0 20px 0;
    }

    /* ── Chart wrapper ── */
    .chart-wrapper {
      position: relative;
      width: 100%;
      height: 280px;
    }

    /* ── Recent Orders Table ── */
    .recent-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }

    .recent-table thead tr {
      border-bottom: 1px solid #f3f4f6;
    }

    .recent-table th {
      padding: 10px 12px;
      text-align: left;
      font-size: 13px;
      font-weight: 600;
      color: #374151;
    }

    .recent-table td {
      padding: 14px 12px;
      border-bottom: 1px solid #f9fafb;
      color: #374151;
      vertical-align: middle;
    }

    .recent-table tbody tr:last-child td {
      border-bottom: none;
    }

    .recent-table tbody tr:hover {
      background: #fafafa;
    }

    /* ── Status Pills ── */
    .status-pill {
      padding: 3px 10px;
      border-radius: 5px;
      font-size: 12px;
      font-weight: 500;
      display: inline-block;
    }

    .status-delivered {
      background-color: #d1fae5;
      color: #059669;
    }

    .status-pending {
      background-color: #ffedd5;
      color: #d97706;
    }

    .status-cancelled {
      background-color: #ffe4e6;
      color: #e11d48;
    }

    /* ── Footer ── */
    .dashboard-footer {
      text-align: center;
      font-size: 13px;
      color: #9ca3af;
      padding: 16px 0 8px;
    }

    /* ── Responsive table scroll ── */
    .table-scroll {
      overflow-x: auto;
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="/js/popup.js" defer></script>
  <script src="/js/partitials/Admin/sidebar.js" defer></script>
</head>

<body>
  <div id="toast" class="toast"></div>
  <%- include("../partitials/admin/sidebar.ejs", { currentPage: 'dashboard' }) %>

  <div class="main-wrapper">
    <%- include("../partitials/admin/header.ejs", { currentPage: 'dashboard' }) %>

    <main class="main-content">
      <div class="content-container">

        <%
          const stats = [
            { label: "Total Orders",   value: totalOrders,  icon: "shopping_bag"  },
            { label: "Total Revenue",  value: "₹" + totalRevenue.toLocaleString(), icon: "circle"        },
            { label: "Total Users",    value: totalUsers,  icon: "group"         },
            { label: "Pending Orders", value: pendingOrders,     icon: "crop_square"   }
          ];
        %>

        <!-- ── Stat Cards ── -->
        <div class="stats-grid">
          <% stats.forEach(stat => { %>
          <div class="stat-card">
            <div>
              <p class="stat-label"><%= stat.label %></p>
              <p class="stat-value"><%= stat.value %></p>
            </div>
            <div class="stat-icon-wrap">
              <span class="material-symbols-outlined"><%= stat.icon %></span>
            </div>
          </div>
          <% }) %>
        </div>

        <!-- ── Sales Overview Chart ── -->
        <div class="section-card">
          <h2 class="section-title">Sales Overview</h2>
          <div class="chart-wrapper">
            <canvas id="salesChart"></canvas>
          </div>
        </div>

        <!-- ── Top performance sections ── -->
        <div class="stats-grid" style="grid-template-columns: repeat(3, 1fr); margin-top: 24px;">
          <!-- Top Products -->
          <div class="section-card" style="margin-bottom: 0;">
            <h2 class="section-title">Top 10 Products</h2>
            <div class="table-scroll">
              <table class="recent-table">
                <thead>
                  <tr>
                    <th>Product</th>
                    <th>Sold</th>
                  </tr>
                </thead>
                <tbody>
                  <% topProducts.forEach(p => { %>
                  <tr>
                    <td style="display: flex; align-items: center; gap: 10px;">
                      <img src="<%= p.image %>" alt="" style="width: 32px; height: 32px; border-radius: 4px; object-fit: cover;">
                      <span style="font-weight: 500;"><%= p.name %></span>
                    </td>
                    <td style="font-weight: 600;"><%= p.totalSold %></td>
                  </tr>
                  <% }) %>
                  <% if (topProducts.length === 0) { %>
                    <tr><td colspan="2" style="text-align: center; color: #9ca3af;">No data available</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Top Categories -->
          <div class="section-card" style="margin-bottom: 0;">
            <h2 class="section-title">Top 10 Categories</h2>
            <div class="table-scroll">
              <table class="recent-table">
                <thead>
                  <tr>
                    <th>Category</th>
                    <th>Sold</th>
                  </tr>
                </thead>
                <tbody>
                  <% topCategories.forEach(c => { %>
                  <tr>
                    <td style="font-weight: 500;"><%= c.name %></td>
                    <td style="font-weight: 600;"><%= c.totalSold %></td>
                  </tr>
                  <% }) %>
                  <% if (topCategories.length === 0) { %>
                    <tr><td colspan="2" style="text-align: center; color: #9ca3af;">No data available</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Top Brands -->
          <div class="section-card" style="margin-bottom: 0;">
            <h2 class="section-title">Top 10 Brands</h2>
            <div class="table-scroll">
              <table class="recent-table">
                <thead>
                  <tr>
                    <th>Brand</th>
                    <th>Sold</th>
                  </tr>
                </thead>
                <tbody>
                  <% topBrands.forEach(b => { %>
                  <tr>
                    <td style="font-weight: 500;"><%= b._id %></td>
                    <td style="font-weight: 600;"><%= b.totalSold %></td>
                  </tr>
                  <% }) %>
                  <% if (topBrands.length === 0) { %>
                    <tr><td colspan="2" style="text-align: center; color: #9ca3af;">No data available</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ── Recent Orders Table ── -->
        <div class="section-card" style="margin-top: 24px;">
          <h2 class="section-title">Recent Orders</h2>
          <div class="table-scroll">
            <table class="recent-table">
              <thead>
                <tr>
                  <th>Order ID</th>
                  <th>Customer</th>
                  <th>Date</th>
                  <th>Status</th>
                  <th>Amount</th>
                </tr>
              </thead>
              <tbody>
                <% recentOrders.forEach(order => { %>
                <tr>
                  <td style="font-weight: 500; color: #111827;"><%= order.id %></td>
                  <td><%= order.customer %></td>
                  <td><%= order.date %></td>
                  <td>
                    <% if (order.status === ORDER_STATUS.DELIVERED) { %>
                      <span class="status-pill status-delivered"><%= order.status %></span>
                    <% } else if ([ORDER_STATUS.PLACED, ORDER_STATUS.CONFIRMED, ORDER_STATUS.SHIPPED].includes(order.status)) { %>
                      <span class="status-pill status-pending"><%= order.status %></span>
                    <% } else { %>
                      <span class="status-pill status-cancelled"><%= order.status %></span>
                    <% } %>
                  </td>
                  <td style="font-weight: 500; color: #111827;"><%= order.amount %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- ── Footer ── -->
        <p class="dashboard-footer">© 2024 Techora Admin. All rights reserved.</p>

      </div>
    </main>
  </div>

  <script>
    // ── Sales Overview Bar Chart ──
    const ctx = document.getElementById("salesChart").getContext("2d");

    new Chart(ctx, {
      type: "bar",
      data: {
        labels: <%- chartLabels %>,
        datasets: [{
          data: <%- chartData %>,
          backgroundColor: "#1B3C53",
          borderRadius: 4,
          borderSkipped: false,
          barPercentage: 0.55,
          categoryPercentage: 0.7
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: (ctx) => ` ₹${ctx.raw.toLocaleString()}`
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: {
              font: { family: "Inter", size: 13 },
              color: "#6b7280"
            },
            border: { display: false }
          },
          y: {
            beginAtZero: true,
            ticks: {
              font: { family: "Inter", size: 12 },
              color: "#6b7280",
              callback: (val) => val.toLocaleString()
            },
            grid: {
              color: "#f3f4f6",
              drawBorder: false
            },
            border: { display: false, dash: [4, 4] }
          }
        }
      }
    });
  </script>
</body>
<script>

</script>
</html>
